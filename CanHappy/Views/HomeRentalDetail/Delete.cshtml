@model CanHappy.Models.HomeRentalDetailEditViewModel

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>
<h3>Are you sure you want to delete this Home Rental detail?</h3>

<div>
    <h4>Listing</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Subject</dt>
        <dd class="col-sm-9">@Model.Subject</dd>
        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9">@Model.Description</dd>
        <dt class="col-sm-3">Property Type</dt>
        <dd class="col-sm-9">@Model.PropertyTypeName</dd>
        <dt class="col-sm-3">Rental Property Type</dt>
        <dd class="col-sm-9">@Model.RentalPropertyTypeName</dd>
        <dt class="col-sm-3">Storeys</dt>
        <dd class="col-sm-9">@Model.NumberOfStoreys</dd>
        <dt class="col-sm-3">Square Feet</dt>
        <dd class="col-sm-9">@Model.RentalSquareFeet</dd>
        <dt class="col-sm-3">Washrooms</dt>
        <dd class="col-sm-9">@Model.Washrooms</dd>
        <dt class="col-sm-3">Baths</dt>
        <dd class="col-sm-9">@Model.Baths</dd>
        <dt class="col-sm-3">Year Built</dt>
        <dd class="col-sm-9">@Model.YearBuilt</dd>
    </dl>

    <form asp-action="Delete" asp-route-id="@Model.HomeRentalDetailGUID">
        <input type="hidden" asp-for="HomeRentalDetailGUID" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Index" asp-route-listingGuid="@Model.ListingGUID" class="btn btn-outline-secondary">Back to
            List</a>
        </form>
    </div>