@model CanHappy.Models.HomeRentalDetailEditViewModel

@{
    ViewData["Title"] = "Edit";
}

<style>
    .form-label,
    .form-check-label {
        font-weight: 700;
    }
</style>

<h1>Edit</h1>
<h4>Home Rental Detail</h4>
<hr />

<div class="row">
    <div class="col-md-10">
        <form asp-action="Edit" asp-route-id="@Model.HomeRentalDetailGUID">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="HomeRentalDetailGUID" />
            <input type="hidden" asp-for="ListingGUID" />

            <h5 class="mt-2">Listing</h5>
            <div class="row g-2 mb-3">
                <div class="col-md-6"><strong>Subject:</strong> @Model.Subject</div>
                <div class="col-md-6"><strong>Description:</strong> @Model.Description</div>
                <div class="col-md-3"><strong>Category:</strong> @Model.CategoryId</div>
                <div class="col-md-3"><strong>Subcategory:</strong> @Model.SubcategoryId</div>
                <div class="col-md-3"><strong>Province:</strong> @Model.ProvinceId</div>
                <div class="col-md-3"><strong>City:</strong> @Model.CityId</div>
                <div class="col-md-3"><strong>Price:</strong> @(Model.Price.HasValue ? Model.Price.Value.ToString("C2")
                                    : "-")</div>
                    <div class="col-md-3"><strong>Model:</strong> @Model.ListingModel</div>
                    <div class="col-md-3"><strong>Quantity:</strong> @Model.Quantity</div>
                </div>

                <h5>Home Rental Detail</h5>
                <div class="row g-2 mb-3">
                    <div class="col-md-4"><label asp-for="PropertyTypeId" class="form-label"></label><select
                        asp-for="PropertyTypeId" asp-items="ViewBag.PropertyTypeId" class="form-select"></select></div>
                        <div class="col-md-4"><label asp-for="RentalPropertyTypeId" class="form-label"></label><select
                            asp-for="RentalPropertyTypeId" asp-items="ViewBag.RentalPropertyTypeId"
                            class="form-select"></select></div>
                            <div class="col-md-4"><label asp-for="NumberOfStoreys" class="form-label"></label><input
                                asp-for="NumberOfStoreys" class="form-control" /></div>
                                <div class="col-md-4"><label asp-for="RentalSquareFeet" class="form-label"></label><input
                                    asp-for="RentalSquareFeet" class="form-control" /></div>
                                    <div class="col-md-4"><label asp-for="Bedrooms" class="form-label"></label><input asp-for="Bedrooms"
                                                                                                                          class="form-control" /></div>
                                        <div class="col-md-4"><label asp-for="BedroomsForRental" class="form-label"></label><input
                                            asp-for="BedroomsForRental" class="form-control" /></div>
                                            <div class="col-md-4"><label asp-for="Washrooms" class="form-label"></label><input asp-for="Washrooms"
                                                                                                                                   class="form-control" /></div>
                                                <div class="col-md-4"><label asp-for="Baths" class="form-label"></label><input asp-for="Baths"
                                                                                                                                   class="form-control" /></div>
                                                    <div class="col-md-4"><label asp-for="YearBuilt" class="form-label"></label><input asp-for="YearBuilt"
                                                                                                                                           class="form-control" /></div>
                                                        <div class="col-md-4"><label asp-for="ParkingSpots" class="form-label"></label><input
                                                            asp-for="ParkingSpots" class="form-control" /></div>
                                                            <div class="col-md-4"><label asp-for="RentalParkingSpots" class="form-label"></label><input
                                                                asp-for="RentalParkingSpots" class="form-control" /></div>
                                                                <div class="col-md-4"><label asp-for="PreferredRentalStartDate" class="form-label"></label><input
                                                                    asp-for="PreferredRentalStartDate" class="form-control" /></div>
                                                                    <div class="col-md-4"><label asp-for="PreferredRentalTerm" class="form-label"></label><input
                                                                        asp-for="PreferredRentalTerm" class="form-control" /></div>
                                                                        <div class="col-12"><label asp-for="AdditionalInfo" class="form-label"></label><textarea
                                                                            asp-for="AdditionalInfo" class="form-control" rows="3"></textarea></div>
                                                                        </div>

                                                                        <div class="row g-2 mb-3">
                                                                            <div class="col-md-4 form-check"><input asp-for="PriceNegotiableInd" class="form-check-input" /><label
                                                                                asp-for="PriceNegotiableInd" class="form-check-label"></label></div>
                                                                                <div class="col-md-4 form-check"><input asp-for="SharedWashroomInd" class="form-check-input" /><label
                                                                                    asp-for="SharedWashroomInd" class="form-check-label"></label></div>
                                                                                    <div class="col-md-4 form-check"><input asp-for="ParkingIncludedInd" class="form-check-input" /><label
                                                                                        asp-for="ParkingIncludedInd" class="form-check-label"></label></div>
                                                                                        <div class="col-md-4 form-check"><input asp-for="RentalTermNegotiableInd"
                                                                                                                                    class="form-check-input" /><label asp-for="RentalTermNegotiableInd"
                                                                                                                              class="form-check-label"></label></div>
                                                                                            <div class="col-md-4 form-check"><input asp-for="FurnishedInd" class="form-check-input" /><label
                                                                                                asp-for="FurnishedInd" class="form-check-label"></label></div>
                                                                                                <div class="col-md-4 form-check"><input asp-for="WaterIncludedInd" class="form-check-input" /><label
                                                                                                    asp-for="WaterIncludedInd" class="form-check-label"></label></div>
                                                                                                    <div class="col-md-4 form-check"><input asp-for="HeatingIncludedInd" class="form-check-input" /><label
                                                                                                        asp-for="HeatingIncludedInd" class="form-check-label"></label></div>
                                                                                                        <div class="col-md-4 form-check"><input asp-for="HydroElectricityIncludedInd"
                                                                                                                                                    class="form-check-input" /><label asp-for="HydroElectricityIncludedInd"
                                                                                                                                              class="form-check-label"></label></div>
                                                                                                            <div class="col-md-4 form-check"><input asp-for="InternetWiFiIncludedInd"
                                                                                                                                                        class="form-check-input" /><label asp-for="InternetWiFiIncludedInd"
                                                                                                                                                  class="form-check-label"></label></div>
                                                                                                            </div>

                                                                                                            <div class="d-flex gap-2">
                                                                                                                <input type="submit" value="Save" class="btn btn-primary" />
                                                                                                                <a asp-action="Index" asp-route-listingGuid="@Model.ListingGUID" class="btn btn-outline-secondary">Back
                                                                                                                    to List</a>
                                                                                                                </div>
                                                                                                            </form>
                                                                                                        </div>
                                                                                                    </div>

                                                                                                    @section Scripts {
                                                                                                        @{
                                                                                                            await Html.RenderPartialAsync("_ValidationScriptsPartial");
                                                                                                        }
                                                                                                    }