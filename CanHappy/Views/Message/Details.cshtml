@model CanHappy.Models.Messaging.MessageDetailsViewModel

@{
    ViewData["Title"] = "Message Details";
    var replySubject = Model.Subject.StartsWith("Re:", StringComparison.OrdinalIgnoreCase)
        ? Model.Subject
        : $"Re: {Model.Subject}";
    var displayBody = (Model.Body ?? string.Empty)
        .Replace("--- Original message ---", $"{Environment.NewLine}--- Original message ---{Environment.NewLine}")
        .Replace($"--- Original message ---{Environment.NewLine}{Environment.NewLine}", $"--- Original message ---{Environment.NewLine}")
        .Trim();
    var replyBodyTemplate = $"\n\n--- Original message ---\nFrom: {Model.SenderName}\nTo: {Model.RecipientName}\nDate: {Model.CreatedDate.ToLocalTime()}\n{Model.Body}";
}

@if (TempData["MessageSuccess"] is string messageSuccess && !string.IsNullOrWhiteSpace(messageSuccess))
{
    <div class="alert alert-success">@messageSuccess</div>
}

@if (TempData["MessageError"] is string messageError && !string.IsNullOrWhiteSpace(messageError))
{
    <div class="alert alert-danger">@messageError</div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Message</h1>
    <div class="d-flex gap-2">
        @if (Model.IsInboxMessage)
        {
            <button type="button" class="btn btn-primary" data-bs-toggle="modal"
                    data-bs-target="#replyMessageModal">Reply</button>
        }
        <a asp-action="@(Model.IsInboxMessage ? "Inbox" : "Sent")" class="btn btn-outline-secondary">Back</a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <h4 class="card-title">@Model.Subject</h4>
        <div class="text-muted mb-3">
            <div><strong>From:</strong> @Model.SenderName</div>
            <div><strong>To:</strong> @Model.RecipientName</div>
            <div><strong>Date:</strong> @Model.CreatedDate.ToLocalTime()</div>
            <div>
                <strong>Listing:</strong>
                @if (Model.HasListing)
                {
                    <a asp-controller="ListingPage" asp-action="Details"
                       asp-route-id="@Model.ListingGUID">@Model.ListingSubject</a>
                }
                else
                {
                    <span>@Model.ListingSubject</span>
                }
            </div>
        </div>

        <div class="border rounded p-3 bg-body-tertiary text-body" style="white-space: pre-line;">
            @displayBody
        </div>
    </div>
</div>

@if (Model.IsInboxMessage)
{
    <div class="modal fade" id="replyMessageModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-scrollable" style="max-width: 66.6667vw; width: 66.6667vw; height: 100vh; margin: 0 auto;">
            <div class="modal-content h-100">
                <div class="modal-header">
                    <h5 class="modal-title">Reply to sender</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="post" action="@Url.Action("Reply", "MessagePage", new { id = Model.UserMessageGUID })">
                    @Html.AntiForgeryToken()
                    <div class="modal-body d-flex flex-column">
                        <div class="mb-3">
                            <label for="replySubject" class="form-label">Subject</label>
                            <input id="replySubject" name="subject" type="text" class="form-control" maxlength="120"
                                   value="@replySubject" />
                        </div>
                        <div class="mb-0">
                            <label for="replyBody" class="form-label">Message</label>
                            <textarea id="replyBody" name="body" class="form-control" rows="18" style="height: calc(100vh - 260px);"
                                      maxlength="2000"
                                      required>@replyBodyTemplate</textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Send Reply</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    @if (Model.IsInboxMessage)
    {
        <script>
                                    (() => {
                                        const replyModal = document.getElementById("replyMessageModal");
                                        const replyBody = document.getElementById("replyBody");
                                        if (!replyModal || !replyBody) {
                                            return;
                                        }

                                        replyModal.addEventListener("shown.bs.modal", () => {
                                            replyBody.focus();
                                            replyBody.setSelectionRange(0, 0);
                                        });
                                    })();
        </script>
    }
}