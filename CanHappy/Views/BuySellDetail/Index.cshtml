@model CanHappy.Models.BuySellDetailIndexPageViewModel

@{
    ViewData["Title"] = "Buy/Sell Details";
    var listingGuid = Model.ListingGUIDFilter;
    var photoCount = Model.ListingImages.Count;
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.css" />
<style>
    .cropper-view-box {
        outline-width: 2px !important;
    }

    .cropper-line.line-e,
    .cropper-line.line-w {
        width: 2px !important;
    }

    .cropper-line.line-n,
    .cropper-line.line-s {
        height: 2px !important;
    }

    .cropper-point {
        width: 14px !important;
        height: 14px !important;
        border: 2px solid #fff !important;
        opacity: 1 !important;
    }

    .form-label,
    .form-check-label {
        font-weight: 700;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Buy/Sell Details</h1>
    <a asp-action="Create" asp-route-listingGuid="@listingGuid" class="btn btn-primary">Create New</a>
</div>

@if (TempData["MessageSuccess"] is string messageSuccess && !string.IsNullOrWhiteSpace(messageSuccess))
{
    <div class="alert alert-success">@messageSuccess</div>
}

@if (TempData["MessageError"] is string messageError && !string.IsNullOrWhiteSpace(messageError))
{
    <div class="alert alert-danger">@messageError</div>
}

@if (Model.ListingCard is not null)
{
    <div class="card shadow-sm mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>Listing</strong>
            @if (Model.CanManageFocusedListing && Model.ListingImages.Count < 30)
            {
                <button type="button" class="btn btn-sm btn-outline-primary" id="addPhotoButton">Add Photo</button>
            }
        </div>
        <div class="card-body">
            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <strong>Photos (@photoCount/30)</strong>
                </div>
                @if (!Model.ListingImages.Any())
                {
                    <div class="text-muted">No photos found for this listing.</div>
                }
                else
                {
                    <div class="row g-2">
                        @foreach (var image in Model.ListingImages.Select((value, index) => new { value, index }))
                        {
                            var thumbnailUrl = !string.IsNullOrWhiteSpace(image.value.ThumbnailURL) ? image.value.ThumbnailURL :
                            image.value.ImageURL;
                            var fullImageUrl = !string.IsNullOrWhiteSpace(image.value.ImageURL) ? image.value.ImageURL :
                            image.value.ThumbnailURL;
                            <div class="col-md-3 col-sm-4 col-6">
                                <div class="card h-100">
                                    <button type="button" class="btn p-0 border-0 text-start view-listing-photo"
                                            data-index="@image.index" data-image-url="@fullImageUrl"
                                            data-image-title="@image.value.Title">
                                        <img src="@thumbnailUrl" class="card-img-top" alt="@image.value.Title"
                                             style="height: 150px; object-fit: contain; background-color: #f8f9fa;" />
                                    </button>
                                    <div class="card-body p-2">
                                        <div class="small text-truncate">@(string.IsNullOrWhiteSpace(image.value.Title) ? "Photo" :
                                                                            image.value.Title)</div>
                                            @if (Model.CanManageFocusedListing)
                                            {
                                                <div class="d-flex gap-1 mt-1">
                                                    <button type="button" class="btn btn-sm btn-outline-secondary edit-photo-button"
                                                            data-listing-image-guid="@image.value.ListingImageGUID"
                                                            data-title="@image.value.Title" data-sort-order="@image.value.SorOrder"
                                                            data-image-url="@fullImageUrl">
                                                        Edit Photo
                                                    </button>
                                                    <form method="post" asp-action="DeletePhoto"
                                                          asp-route-listingGuid="@Model.ListingCard.ListingGUID"
                                                          asp-route-listingImageGuid="@image.value.ListingImageGUID"
                                                          onsubmit="return confirm('Delete this photo?');">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                                    </form>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="row g-2">
                    <div class="col-md-6"><strong>Subject:</strong> @Model.ListingCard.Subject</div>
                    <div class="col-md-6"><strong>Description:</strong>@Model.ListingCard.Description</div>
                    <div class="col-md-4"><strong>Category:</strong> @Model.ListingCard.CategoryId</div>
                    <div class="col-md-4"><strong>Subcategory:</strong> @Model.ListingCard.SubcategoryId</div>
                    <div class="col-md-4"><strong>Province:</strong> @Model.ListingCard.ProvinceId</div>
                    <div class="col-md-4"><strong>City:</strong> @Model.ListingCard.CityId</div>
                    <div class="col-md-4"><strong>Price:</strong> @Model.ListingCard.Price</div>
                    <div class="col-md-4"><strong>Brand:</strong> @Model.ListingCard.Brand</div>
                    <div class="col-md-4"><strong>Condition:</strong> @Model.ListingCard.Condition</div>
                    <div class="col-md-4"><strong>Manufacture Year:</strong> @Model.ListingCard.ManufactureYear</div>
                    <div class="col-md-4"><strong>Model:</strong> @Model.ListingCard.Model</div>
                    <div class="col-md-4"><strong>Quantity:</strong> @Model.ListingCard.Quantity</div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>Buy/Sell Detail</strong>
                @if (Model.CanManageFocusedListing)
                {
                    @if (Model.HasExistingFocusDetail && Model.FocusDetail?.BuySellDetailGUID is Guid focusDetailId)
                    {
                        <span>
                            <a asp-action="Edit" asp-route-id="@focusDetailId">Edit</a>
                            <span> | </span>
                            <a asp-action="Delete" asp-route-id="@focusDetailId">Delete</a>
                        </span>
                    }
                    else
                    {
                        <a asp-action="Create" asp-route-listingGuid="@Model.ListingCard.ListingGUID">Create Detail</a>
                    }
                }
            </div>
            <div class="card-body">
                @if (Model.FocusDetail is null)
                {
                    <div class="text-muted">No Buy/Sell detail found.</div>
                }
                else
                {
                    <div class="row g-2">
                        <div class="col-lg-4 col-md-6"><strong>Model:</strong> @Model.FocusDetail.BuySellModel</div>
                        <div class="col-lg-4 col-md-6"><strong>Material:</strong> @Model.FocusDetail.Material</div>
                        <div class="col-lg-4 col-md-6"><strong>Negotiable Price:</strong> @Model.FocusDetail.NegotiablePriceInd
                        </div>
                        <div class="col-lg-4 col-md-6"><strong>Delivery Available:</strong>
                            @Model.FocusDetail.DeliveryAvailableInd</div>
                            <div class="col-lg-4 col-md-6"><strong>Pickup Available:</strong> @Model.FocusDetail.PickupAvailableInd
                            </div>
                            <div class="col-lg-4 col-md-6"><strong>Pickup Location:</strong> @Model.FocusDetail.PickupLocation</div>
                            <div class="col-lg-4 col-md-6"><strong>Pickup Time:</strong> @Model.FocusDetail.PickupTime</div>
                            <div class="col-lg-4 col-md-6"><strong>WarrantyInfo:</strong> @Model.FocusDetail.WarrantyInfo</div>
                            <div class="col-lg-4 col-md-6"><strong>AdditionalDetails:</strong> @Model.FocusDetail.AdditionalDetails
                            </div>
                        </div>
                    }
                </div>
            </div>

            @if (Model.ListingImages.Any())
            {
                <div class="modal fade" id="listingPhotoViewerModal" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-fullscreen">
                        <div class="modal-content h-100">
                            <div class="modal-header">
                                <h5 class="modal-title">Listing Photo Viewer</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body d-flex flex-column overflow-hidden">
                                <div class="d-flex justify-content-between align-items-center mb-2 flex-shrink-0">
                                    <div class="d-flex align-items-center gap-2">
                                        <div id="viewerImageTitle" class="fw-semibold"></div>
                                        <span class="text-muted" title="drag to pan and scroll to zoom"
                                              aria-label="drag to pan and scroll to zoom">ⓘ</span>
                                    </div>
                                    <div class="btn-group">
                                        <button type="button" id="viewerPrev" class="btn btn-outline-secondary btn-sm">Prev</button>
                                        <button type="button" id="viewerZoomOut" class="btn btn-outline-secondary btn-sm">-</button>
                                        <button type="button" id="viewerZoomReset"
                                                class="btn btn-outline-secondary btn-sm">100%</button>
                                        <button type="button" id="viewerZoomIn" class="btn btn-outline-secondary btn-sm">+</button>
                                        <button type="button" id="viewerNext" class="btn btn-outline-secondary btn-sm">Next</button>
                                    </div>
                                </div>
                                <div class="border rounded d-flex justify-content-center align-items-center overflow-hidden flex-grow-1"
                                     style="min-height: 0; background-color: #e9ecef;">
                                    <img id="viewerMainImage" alt="Listing photo" title="drag to pan and scroll to zoom"
                                         aria-label="drag to pan and scroll to zoom" draggable="false"
                                         style="width: 100%; height: 100%; object-fit: contain; transform-origin: center center; transition: transform .15s ease; cursor: grab; touch-action: none; user-select: none;" />
                                </div>
                                <div class="mt-2 d-flex flex-nowrap justify-content-center gap-2 overflow-auto pb-1 flex-shrink-0"
                                     id="viewerThumbnailStrip" style="min-height: 84px;">
                                    @foreach (var image in Model.ListingImages.Select((value, index) => new { value, index }))
                                    {
                                        var thumbUrl = !string.IsNullOrWhiteSpace(image.value.ThumbnailURL) ? image.value.ThumbnailURL :
                                        image.value.ImageURL;
                                        var fullUrl = !string.IsNullOrWhiteSpace(image.value.ImageURL) ? image.value.ImageURL :
                                        image.value.ThumbnailURL;
                                        <button type="button" class="btn p-0 border viewer-thumb" data-index="@image.index"
                                                data-image-url="@fullUrl" data-image-title="@image.value.Title" style="min-width: 90px;">
                                            <img src="@thumbUrl" alt="Thumbnail @image.index"
                                                 style="width: 90px; height: 70px; object-fit: contain; background-color: #f8f9fa;" />
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <script>
                    (() => {
                        const viewerModalElement = document.getElementById("listingPhotoViewerModal");
                        if (!viewerModalElement) {
                            return;
                        }

                        const viewerMainImage = document.getElementById("viewerMainImage");
                        const viewerImageTitle = document.getElementById("viewerImageTitle");
                        const viewerPrev = document.getElementById("viewerPrev");
                        const viewerNext = document.getElementById("viewerNext");
                        const viewerZoomIn = document.getElementById("viewerZoomIn");
                        const viewerZoomOut = document.getElementById("viewerZoomOut");
                        const viewerZoomReset = document.getElementById("viewerZoomReset");
                        const viewerThumbButtons = Array.from(document.querySelectorAll(".viewer-thumb"));
                        const triggerButtons = Array.from(document.querySelectorAll(".view-listing-photo"));
                        const viewerViewport = viewerMainImage.parentElement;

                        let zoomScale = 1;
                        let selectedIndex = 0;
                        let targetTranslateX = 0;
                        let targetTranslateY = 0;
                        let isDragging = false;
                        let lastPointerX = 0;
                        let lastPointerY = 0;
                        let rafPending = false;

                        const getViewerModal = () => {
                            if (!window.bootstrap || !window.bootstrap.Modal) {
                                return null;
                            }

                            return window.bootstrap.Modal.getOrCreateInstance(viewerModalElement);
                        };

                        const getFittedImageSize = () => {
                            const viewportWidth = Math.max(1, viewerViewport.clientWidth);
                            const viewportHeight = Math.max(1, viewerViewport.clientHeight);
                            const naturalWidth = Math.max(1, viewerMainImage.naturalWidth || 1);
                            const naturalHeight = Math.max(1, viewerMainImage.naturalHeight || 1);
                            const widthRatio = viewportWidth / naturalWidth;
                            const heightRatio = viewportHeight / naturalHeight;
                            const fitRatio = Math.min(widthRatio, heightRatio);

                            return {
                                viewportWidth,
                                viewportHeight,
                                fittedWidth: naturalWidth * fitRatio,
                                fittedHeight: naturalHeight * fitRatio
                            };
                        };

                        const clampTranslate = () => {
                            const { viewportWidth, viewportHeight, fittedWidth, fittedHeight } = getFittedImageSize();
                            const scaledWidth = fittedWidth * zoomScale;
                            const scaledHeight = fittedHeight * zoomScale;
                            const maxOffsetX = Math.max(0, (scaledWidth - viewportWidth) / 2);
                            const maxOffsetY = Math.max(0, (scaledHeight - viewportHeight) / 2);

                            targetTranslateX = Math.min(maxOffsetX, Math.max(-maxOffsetX, targetTranslateX));
                            targetTranslateY = Math.min(maxOffsetY, Math.max(-maxOffsetY, targetTranslateY));
                        };

                        const renderTransform = () => {
                            rafPending = false;
                            viewerMainImage.style.transform = `translate(${targetTranslateX}px, ${targetTranslateY}px) scale(${zoomScale})`;
                            viewerZoomReset.textContent = `${Math.round(zoomScale * 100)}%`;
                        };

                        const scheduleRender = () => {
                            if (rafPending) {
                                return;
                            }

                            rafPending = true;
                            requestAnimationFrame(renderTransform);
                        };

                        const applyZoom = () => {
                            clampTranslate();
                            scheduleRender();
                        };

                        const setZoom = (newZoom) => {
                            zoomScale = Math.min(10, Math.max(0.2, newZoom));
                            applyZoom();
                        };

                        const resetView = () => {
                            zoomScale = 1;
                            targetTranslateX = 0;
                            targetTranslateY = 0;
                            applyZoom();
                        };

                        const updateSelection = (index) => {
                            if (viewerThumbButtons.length === 0) {
                                return;
                            }

                            if (index < 0) {
                                index = viewerThumbButtons.length - 1;
                            } else if (index >= viewerThumbButtons.length) {
                                index = 0;
                            }

                            const selected = viewerThumbButtons.find(button => Number.parseInt(button.dataset.index, 10) === index);
                            if (!selected) {
                                return;
                            }

                            selectedIndex = index;
                            viewerMainImage.src = selected.dataset.imageUrl || "";
                            viewerImageTitle.textContent = selected.dataset.imageTitle || "Photo";
                            resetView();

                            viewerThumbButtons.forEach(button => {
                                const isActive = Number.parseInt(button.dataset.index, 10) === selectedIndex;
                                button.classList.toggle("border-primary", isActive);
                                button.classList.toggle("border-2", isActive);
                            });

                            selected.scrollIntoView({ behavior: "smooth", inline: "center", block: "nearest" });
                        };

                        viewerThumbButtons.forEach(button => {
                            button.addEventListener("click", () => {
                                const index = Number.parseInt(button.dataset.index, 10);
                                if (Number.isFinite(index)) {
                                    updateSelection(index);
                                }
                            });
                        });

                        triggerButtons.forEach(button => {
                            button.addEventListener("click", () => {
                                const index = Number.parseInt(button.dataset.index, 10);
                                if (Number.isFinite(index)) {
                                    updateSelection(index);
                                }

                                const viewerModal = getViewerModal();
                                viewerModal?.show();
                            });
                        });

                        viewerZoomIn.addEventListener("click", () => {
                            setZoom(zoomScale + 0.2);
                        });

                        viewerZoomOut.addEventListener("click", () => {
                            setZoom(zoomScale - 0.2);
                        });

                        viewerZoomReset.addEventListener("click", resetView);

                        viewerPrev.addEventListener("click", () => {
                            updateSelection(selectedIndex - 1);
                        });

                        viewerNext.addEventListener("click", () => {
                            updateSelection(selectedIndex + 1);
                        });

                        viewerMainImage.addEventListener("load", resetView);

                        viewerMainImage.addEventListener("wheel", (event) => {
                            event.preventDefault();
                            setZoom(zoomScale + (event.deltaY < 0 ? 0.1 : -0.1));
                        }, { passive: false });

                        viewerMainImage.addEventListener("contextmenu", (event) => {
                            event.preventDefault();
                        });

                        viewerMainImage.addEventListener("pointerdown", (event) => {
                            if (event.pointerType === "mouse" && event.button !== 0 && event.button !== 2) {
                                return;
                            }

                            if (zoomScale <= 1) {
                                return;
                            }

                            event.preventDefault();
                            isDragging = true;
                            lastPointerX = event.clientX;
                            lastPointerY = event.clientY;
                            viewerMainImage.style.cursor = "grabbing";
                            viewerMainImage.setPointerCapture(event.pointerId);
                        });

                        viewerMainImage.addEventListener("pointermove", (event) => {
                            if (!isDragging) {
                                return;
                            }

                            const deltaX = event.clientX - lastPointerX;
                            const deltaY = event.clientY - lastPointerY;
                            lastPointerX = event.clientX;
                            lastPointerY = event.clientY;

                            targetTranslateX += deltaX;
                            targetTranslateY += deltaY;
                            applyZoom();
                        });

                        const stopDragging = (event) => {
                            if (!isDragging) {
                                return;
                            }

                            isDragging = false;
                            viewerMainImage.style.cursor = zoomScale > 1 ? "grab" : "default";
                            if (typeof event.pointerId !== "undefined") {
                                viewerMainImage.releasePointerCapture(event.pointerId);
                            }
                        };

                        viewerMainImage.addEventListener("pointerup", stopDragging);
                        viewerMainImage.addEventListener("pointercancel", stopDragging);
                        viewerMainImage.addEventListener("pointerleave", stopDragging);

                        window.addEventListener("resize", applyZoom);

                        if (viewerThumbButtons.length > 0) {
                            updateSelection(0);
                        }
                    })();
                </script>
            }
        }
else
        {
            @if (!Model.Items.Any())
            {
                <div class="alert alert-info">No Buy/Sell details found.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-bordered align-middle">
                        <thead>
                            <tr>
                                <th>Subject</th>
                                <th>Description</th>
                                <th>Category</th>
                                <th>Subcategory</th>
                                <th>Province</th>
                                <th>City</th>
                                <th>Price</th>
                                <th>Brand</th>
                                <th>Condition</th>
                                <th>Manufacture Year</th>
                                <th>Listing Model</th>
                                <th>Quantity</th>
                                <th>Detail Model</th>
                                <th>Material</th>
                                <th>Negotiable Price</th>
                                <th>Delivery Available</th>
                                <th>Pickup Available</th>
                                <th>Pickup Location</th>
                                <th>Pickup Time</th>
                                <th>WarrantyInfo</th>
                                <th>AdditionalDetails</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>@item.Subject</td>
                                    <td>@item.Description</td>
                                    <td>@item.CategoryId</td>
                                    <td>@item.SubcategoryId</td>
                                    <td>@item.ProvinceId</td>
                                    <td>@item.CityId</td>
                                    <td>@item.Price</td>
                                    <td>@item.Brand</td>
                                    <td>@item.Condition</td>
                                    <td>@item.ManufactureYear</td>
                                    <td>@item.ListingModel</td>
                                    <td>@item.Quantity</td>
                                    <td>@item.BuySellModel</td>
                                    <td>@item.Material</td>
                                    <td>@item.NegotiablePriceInd</td>
                                    <td>@item.DeliveryAvailableInd</td>
                                    <td>@item.PickupAvailableInd</td>
                                    <td>@item.PickupLocation</td>
                                    <td>@item.PickupTime</td>
                                    <td>@item.WarrantyInfo</td>
                                    <td>@item.AdditionalDetails</td>
                                    <td>
                                        @if (item.CanManage)
                                        {
                                            <a asp-action="Edit" asp-route-id="@item.BuySellDetailGUID">Edit</a>
                                            <span> | </span>
                                            <a asp-action="Delete" asp-route-id="@item.BuySellDetailGUID">Delete</a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }

        @if (Model.ListingCard is not null && Model.CanManageFocusedListing)
        {
            <form id="photoUpsertForm" method="post" asp-action="UpsertPhoto" asp-route-listingGuid="@Model.ListingCard.ListingGUID"
                  class="d-none">
                @Html.AntiForgeryToken()
                <input type="hidden" id="photoListingImageGuid" name="listingImageGuid" />
                <input type="hidden" id="photoTitleInput" name="title" />
                <input type="hidden" id="photoSortOrderInput" name="sorOrder" />
                <input type="hidden" id="photoCroppedDataInput" name="croppedImageData" />
                <input type="hidden" id="photoThumbnailDataInput" name="thumbnailImageData" />
            </form>

            <input type="file" id="photoFileInput" class="d-none" accept="image/*" />

            <div class="modal fade" id="listingPhotoCropModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-fullscreen">
                    <div class="modal-content h-100">
                        <div class="modal-header py-2 px-3">
                            <h5 class="modal-title">Clip Listing Photo</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body pt-2 pb-2 px-3 d-flex flex-column overflow-hidden">
                            <div class="d-flex flex-wrap align-items-center gap-3 mb-2 flex-shrink-0">
                                <div class="d-flex align-items-center gap-2">
                                    <label for="photoTitleEditor" class="form-label mb-0 text-nowrap">Title</label>
                                    <input id="photoTitleEditor" type="text" class="form-control form-control-sm" maxlength="50"
                                           style="width: 300px;" />
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <label for="photoSortOrderEditor" class="form-label mb-0 text-nowrap">Sort Order</label>
                                    <input id="photoSortOrderEditor" type="number" class="form-control form-control-sm" min="0"
                                           max="999" step="1" value="0" style="width: 110px;" />
                                </div>
                            </div>
                            <div class="d-flex flex-wrap gap-2 align-items-center pb-2 mb-3 flex-shrink-0">
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <label for="cropAspectRatioSelect" class="form-label mb-0 text-nowrap">Aspect Ratio</label>
                                    <select id="cropAspectRatioSelect" class="form-select form-select-sm" style="min-width: 100px;">
                                        <option value="3:2" selected>3:2</option>
                                        <option value="1:1">1:1</option>
                                        <option value="4:3">4:3</option>
                                        <option value="16:9">16:9</option>
                                        <option value="9:16">9:16</option>
                                        <option value="19:10">19:10</option>
                                        <option value="6:5">6:5</option>
                                        <option value="8:1">8:1</option>
                                        <option value="32:5">32:5</option>
                                        <option value="2:1">2:1</option>
                                        <option value="custom">Custom</option>
                                    </select>
                                </div>
                                <button type="button" id="editCropModeButton" class="btn btn-sm btn-primary mb-1 text-nowrap">Crop
                                    Mode</button>
                                    <button type="button" id="editPenModeButton"
                                            class="btn btn-sm btn-outline-secondary mb-1 text-nowrap">Free Draw Pen</button>
                                    <button type="button" id="editEraseModeButton"
                                            class="btn btn-sm btn-outline-secondary mb-1 text-nowrap">Erase</button>
                                    <button type="button" id="editTextModeButton"
                                            class="btn btn-sm btn-outline-secondary mb-1 text-nowrap">Type Text</button>
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <label for="editFontSelect" class="form-label mb-0 text-nowrap">Font</label>
                                        <select id="editFontSelect" class="form-select form-select-sm" style="min-width: 150px;">
                                            <option value="Arial, sans-serif" selected>Arial</option>
                                            <option value="'Segoe UI', sans-serif">Segoe UI</option>
                                            <option value="Verdana, sans-serif">Verdana</option>
                                            <option value="Tahoma, sans-serif">Tahoma</option>
                                            <option value="Georgia, serif">Georgia</option>
