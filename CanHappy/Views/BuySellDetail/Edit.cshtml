@model CanHappy.Models.BuySellDetailEditViewModel

@{
    ViewData["Title"] = "Edit";
}

<style>
    .form-label,
    .form-check-label {
        font-weight: 700;
    }
</style>

<h1>Edit</h1>
<h4>Buy/Sell Detail</h4>
<hr />

<div class="row">
    <div class="col-md-9">
        <form asp-action="Edit" asp-route-id="@Model.BuySellDetailGUID">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="BuySellDetailGUID" />
            <input type="hidden" asp-for="ListingGUID" />

            <h5 class="mt-2">Listing</h5>
            <div class="row g-2 mb-3">
                <div class="col-md-6"><strong>Subject:</strong> @Model.Subject</div>
                <div class="col-md-6"><strong>Description:</strong>@Model.Description</div>
                <div class="col-md-3"><strong>Category:</strong> @Model.CategoryId</div>
                <div class="col-md-3"><strong>Subcategory:</strong> @Model.SubcategoryId</div>
                <div class="col-md-3"><strong>Province:</strong> @Model.ProvinceId</div>
                <div class="col-md-3"><strong>City:</strong> @Model.CityId</div>
                <div class="col-md-3"><strong>Price:</strong> @Model.Price</div>
                <div class="col-md-3"><strong>Brand:</strong> @Model.Brand</div>
                <div class="col-md-3"><strong>Condition:</strong> @Model.Condition</div>
                <div class="col-md-3"><strong>Manufacture Year:</strong> @Model.ManufactureYear</div>
                <div class="col-md-3"><strong>Model:</strong> @Model.ListingModel</div>
                <div class="col-md-3"><strong>Quantity:</strong> @Model.Quantity</div>
            </div>

            <h5>Buy/Sell Detail</h5>
            <div class="mb-3">
                <label asp-for="BuySellModel" class="form-label"></label>
                <input asp-for="BuySellModel" class="form-control" />
                <span asp-validation-for="BuySellModel" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Material" class="form-label"></label>
                <input asp-for="Material" class="form-control" />
                <span asp-validation-for="Material" class="text-danger"></span>
            </div>

            <div class="form-check mb-2">
                <input asp-for="NegotiablePriceInd" class="form-check-input" />
                <label asp-for="NegotiablePriceInd" class="form-check-label"></label>
            </div>

            <div class="form-check mb-2">
                <input asp-for="DeliveryAvailableInd" class="form-check-input" />
                <label asp-for="DeliveryAvailableInd" class="form-check-label"></label>
            </div>

            <div class="form-check mb-3">
                <input asp-for="PickupAvailableInd" class="form-check-input" />
                <label asp-for="PickupAvailableInd" class="form-check-label"></label>
            </div>

            <div class="mb-3">
                <label asp-for="PickupLocation" class="form-label"></label>
                <input asp-for="PickupLocation" class="form-control" />
                <span asp-validation-for="PickupLocation" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PickupTime" class="form-label"></label>
                <input asp-for="PickupTime" class="form-control" />
                <span asp-validation-for="PickupTime" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="WarrantyInfo" class="form-label"></label>
                <input asp-for="WarrantyInfo" class="form-control" />
                <span asp-validation-for="WarrantyInfo" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="AdditionalDetails" class="form-label"></label>
                <textarea asp-for="AdditionalDetails" class="form-control" rows="3"></textarea>
                <span asp-validation-for="AdditionalDetails" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <input type="submit" value="Save" class="btn btn-primary" />
                <a asp-action="Index" asp-route-listingGuid="@Model.ListingGUID" class="btn btn-outline-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}