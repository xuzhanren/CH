@model CanHappy.Models.BuySellDetailEditViewModel

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>
<h3>Are you sure you want to delete this Buy/Sell detail?</h3>

<div>
    <h4>Listing</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Subject</dt>
        <dd class="col-sm-9">@Model.Subject</dd>

        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9">@Model.Description</dd>

        <dt class="col-sm-3">CategoryId</dt>
        <dd class="col-sm-9">@Model.CategoryId</dd>

        <dt class="col-sm-3">SubcategoryId</dt>
        <dd class="col-sm-9">@Model.SubcategoryId</dd>

        <dt class="col-sm-3">ProvinceId</dt>
        <dd class="col-sm-9">@Model.ProvinceId</dd>

        <dt class="col-sm-3">CityId</dt>
        <dd class="col-sm-9">@Model.CityId</dd>

        <dt class="col-sm-3">Price</dt>
        <dd class="col-sm-9">@(Model.Price.HasValue ? Model.Price.Value.ToString("C2") : "-")</dd>

        <dt class="col-sm-3">Brand</dt>
        <dd class="col-sm-9">@Model.Brand</dd>

        <dt class="col-sm-3">Condition</dt>
        <dd class="col-sm-9">@Model.Condition</dd>

        <dt class="col-sm-3">ManufactureYear</dt>
        <dd class="col-sm-9">@Model.ManufactureYear</dd>

        <dt class="col-sm-3">Listing Model</dt>
        <dd class="col-sm-9">@Model.ListingModel</dd>

        <dt class="col-sm-3">Quantity</dt>
        <dd class="col-sm-9">@Model.Quantity</dd>

        <dt class="col-sm-3">Detail Model</dt>
        <dd class="col-sm-9">@Model.BuySellModel</dd>

        <dt class="col-sm-3">Material</dt>
        <dd class="col-sm-9">@Model.Material</dd>

        <dt class="col-sm-3">NegotiablePriceInd</dt>
        <dd class="col-sm-9">@Model.NegotiablePriceInd</dd>

        <dt class="col-sm-3">DeliveryAvailableInd</dt>
        <dd class="col-sm-9">@Model.DeliveryAvailableInd</dd>

        <dt class="col-sm-3">PickupAvailableInd</dt>
        <dd class="col-sm-9">@Model.PickupAvailableInd</dd>

        <dt class="col-sm-3">WarrantyInfo</dt>
        <dd class="col-sm-9">@Model.WarrantyInfo</dd>

        <dt class="col-sm-3">AdditionalDetails</dt>
        <dd class="col-sm-9">@Model.AdditionalDetails</dd>
    </dl>

    <form asp-action="Delete" asp-route-id="@Model.BuySellDetailGUID">
        <input type="hidden" asp-for="BuySellDetailGUID" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
    </form>
</div>