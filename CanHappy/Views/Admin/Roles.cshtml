@model IReadOnlyList<CanHappy.Models.Admin.AdminRoleViewModel>

@{
    ViewData["Title"] = "Manage Roles";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">@ViewData["Title"]</h1>
    <a class="btn btn-primary" asp-action="CreateRole">Add Role</a>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger" role="alert">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(value => value.Errors))
        {
            <div>@error.ErrorMessage</div>
        }
    </div>
}

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Role Name</th>
            <th class="text-end">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Count == 0)
        {
            <tr>
                <td colspan="2" class="text-muted">No roles found.</td>
            </tr>
        }
        else
        {
            @foreach (var role in Model)
            {
                <tr>
                    <td>@(string.IsNullOrWhiteSpace(role.Name) ? "-" : role.Name)</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="EditRole" asp-route-id="@role.Id">Edit</a>
                        <form asp-action="DeleteRole" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@role.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger"
                                    onclick="return confirm('Delete this role?');">
                                Delete
                            </button>
                        </form>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>