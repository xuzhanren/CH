@model IReadOnlyList<CanHappy.Models.Province>

@{
    ViewData["Title"] = "Manage Provinces";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">@ViewData["Title"]</h1>
    <a class="btn btn-primary" asp-action="CreateProvince">Add Province</a>
</div>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Name</th>
            <th>Code</th>
            <th>Country</th>
            <th class="text-end">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Count == 0)
        {
            <tr>
                <td colspan="4" class="text-muted">No provinces found.</td>
            </tr>
        }
        else
        {
            @foreach (var province in Model)
            {
                <tr>
                    <td>@province.Name</td>
                    <td>@(province.Code ?? "-")</td>
                    <td>@(province.Country?.Name ?? "-")</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="EditProvince"
                           asp-route-id="@province.ProvinceId">Edit</a>
                        <form asp-action="DeleteProvince" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@province.ProvinceId" />
                            <button type="submit" class="btn btn-sm btn-outline-danger"
                                    onclick="return confirm('Delete this province?');">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>