@model IReadOnlyList<CanHappy.Models.Ad>

@{
    ViewData["Title"] = "Manage Ads";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">@ViewData["Title"]</h1>
    <a class="btn btn-primary" asp-action="CreateAd">Add Ad</a>
</div>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Subject</th>
            <th>City</th>
            <th>Status</th>
            <th>Price</th>
            <th class="text-end">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Count == 0)
        {
            <tr>
                <td colspan="5" class="text-muted">No ads found.</td>
            </tr>
        }
        else
        {
            @foreach (var ad in Model)
            {
                <tr>
                    <td>@ad.Subject</td>
                    <td>@(ad.City?.Name ?? "-")</td>
                    <td>@(string.IsNullOrWhiteSpace(ad.Status) ? "-" : ad.Status)</td>
                    <td>@(ad.Price?.ToString("0.##") ?? "-")</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="EditAd" asp-route-id="@ad.AdGUID">Edit</a>
                        <form asp-action="DeleteAd" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@ad.AdGUID" />
                            <button type="submit" class="btn btn-sm btn-outline-danger"
                                    onclick="return confirm('Delete this ad?');">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>