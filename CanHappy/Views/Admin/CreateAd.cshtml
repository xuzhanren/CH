@model CanHappy.Models.Ad
@using System.Text.Json

@{
    ViewData["Title"] = "Add Ad";
    var hasImage = !string.IsNullOrWhiteSpace(Model?.ImageURL);
    var subcategoryLookup = ViewData["SubcategoryLookup"];
    var cityLookup = ViewData["CityLookup"];
    var isRegisteredOnlyUser = User.IsInRole("RegisteredUser") && !User.IsInRole("Admin") && !User.IsInRole("Clerk");
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.css" />
<style>
    .cropper-view-box {
        outline-width: 2px !important;
    }

    .cropper-line.line-e,
    .cropper-line.line-w {
        width: 2px !important;
    }

    .cropper-line.line-n,
    .cropper-line.line-s {
        height: 2px !important;
    }

    .cropper-point {
        width: 14px !important;
        height: 14px !important;
        border: 2px solid #fff !important;
        opacity: 1 !important;
    }

    .form-label,
    .form-check-label {
        font-weight: 700;
    }

    .compact-edit-form .mb-3:not(.form-check):not(.stacked-field) {
        display: grid;
        grid-template-columns: 170px minmax(0, 1fr);
        column-gap: .75rem;
        align-items: center;
        margin-bottom: .5rem !important;
    }

    .compact-edit-form .mb-3:not(.form-check):not(.stacked-field) .form-label {
        margin-bottom: 0;
    }

    .compact-edit-form .mb-3:not(.form-check):not(.stacked-field)>.text-danger {
        grid-column: 2;
    }

    .compact-edit-form .date-input-compact {
        width: 70%;
        min-width: 220px;
    }
</style>

<h1>@ViewData["Title"]</h1>

<form asp-action="CreateAd" method="post" class="compact-edit-form">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="CategoryId" class="form-label"></label>
            <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId">
                <option value="">Select Category</option>
            </select>
            <span asp-validation-for="CategoryId" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="SubcategoryId" class="form-label"></label>
            <select asp-for="SubcategoryId" class="form-select" asp-items="ViewBag.SubcategoryId">
                <option value="">Select Subcategory</option>
            </select>
            <span asp-validation-for="SubcategoryId" class="text-danger"></span>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="ProvinceId" class="form-label"></label>
            <select asp-for="ProvinceId" class="form-select" asp-items="ViewBag.ProvinceId">
                <option value="">Select Province</option>
            </select>
            <span asp-validation-for="ProvinceId" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="CityId" class="form-label"></label>
            <select asp-for="CityId" class="form-select" asp-items="ViewBag.CityId"></select>
            <span asp-validation-for="CityId" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Subject" class="form-label"></label>
        <input asp-for="Subject" class="form-control" />
        <span asp-validation-for="Subject" class="text-danger"></span>
    </div>

    <div class="mb-3 stacked-field">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="KeyWords" class="form-label"></label>
        <input asp-for="KeyWords" class="form-control" />
        <span asp-validation-for="KeyWords" class="text-danger"></span>
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="PostalCode" class="form-label"></label>
            <input asp-for="PostalCode" class="form-control" />
            <span asp-validation-for="PostalCode" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Price" class="form-label"></label>
            @if (!isRegisteredOnlyUser)
            {
                <input asp-for="Price" class="form-control" />
            }
            else
            {
                <input asp-for="Price" class="form-control" readonly />
            }
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="CurrencyCode" class="form-label"></label>
            <input asp-for="CurrencyCode" class="form-control" />
            <span asp-validation-for="CurrencyCode" class="text-danger"></span>
        </div>
    </div>

    <div class="row">
        @if (!isRegisteredOnlyUser)
        {
            <div class="col-md-4 mb-3">
                <label asp-for="AdStatusId" class="form-label"></label>
                <select asp-for="AdStatusId" class="form-select" asp-items="ViewBag.AdStatusId">
                    <option value="">Select Status</option>
                </select>
                <span asp-validation-for="AdStatusId" class="text-danger"></span>
            </div>
        }
        else
        {
            <div class="col-md-4 mb-3">
                <label asp-for="AdStatusId" class="form-label"></label>
                <select asp-for="AdStatusId" class="form-select" asp-items="ViewBag.AdStatusId" disabled>
                    <option value="">Select Status</option>
                </select>
                <input type="hidden" asp-for="AdStatusId" />
            </div>
        }
        <div class="col-md-4 mb-3">
            <label asp-for="AdSizeId" class="form-label"></label>
            <select asp-for="AdSizeId" class="form-select" asp-items="ViewBag.AdSizeId">
                <option value="">Select Ad Size</option>
            </select>
            <span asp-validation-for="AdSizeId" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="TargetURL" class="form-label"></label>
        <input asp-for="TargetURL" class="form-control" />
        <span asp-validation-for="TargetURL" class="text-danger"></span>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="PublishDate" class="form-label"></label>
            <input asp-for="PublishDate" type="datetime-local" class="form-control date-input-compact" />
            <span asp-validation-for="PublishDate" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="ExpiryDate" class="form-label"></label>
            <input asp-for="ExpiryDate" type="datetime-local" class="form-control date-input-compact" />
            <span asp-validation-for="ExpiryDate" class="text-danger"></span>
        </div>
    </div>

    <div class="row g-2">
        <div class="col-xl-2 col-lg-3 col-md-4 form-check mb-2">
            <input asp-for="IsFeatured" class="form-check-input" />
            <label asp-for="IsFeatured" class="form-check-label"></label>
        </div>
        @if (!isRegisteredOnlyUser)
        {
            <div class="col-xl-2 col-lg-3 col-md-4 form-check mb-2">
                <input asp-for="PaidInd" class="form-check-input" />
                <label asp-for="PaidInd" class="form-check-label"></label>
            </div>
            <div class="col-xl-2 col-lg-3 col-md-4 form-check mb-2">
                <input asp-for="ActiveInd" class="form-check-input" />
                <label asp-for="ActiveInd" class="form-check-label"></label>
            </div>
            <div class="col-xl-2 col-lg-3 col-md-4 form-check mb-2">
                <input asp-for="DeletedInd" class="form-check-input" />
                <label asp-for="DeletedInd" class="form-check-label"></label>
            </div>
            <div class="col-xl-2 col-lg-3 col-md-4 form-check mb-2">
                <input asp-for="SampleInd" class="form-check-input" />
                <label asp-for="SampleInd" class="form-check-label"></label>
            </div>
        }
        else
        {
            <input type="hidden" asp-for="PaidInd" />
            <input type="hidden" asp-for="ActiveInd" />
            <input type="hidden" asp-for="DeletedInd" />
            <input type="hidden" asp-for="SampleInd" />
        }
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="ContactName" class="form-label"></label>
            <input asp-for="ContactName" class="form-control" />
            <span asp-validation-for="ContactName" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="ContactEmail" class="form-label"></label>
            <input asp-for="ContactEmail" class="form-control" />
            <span asp-validation-for="ContactEmail" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="ContactPhone" class="form-label"></label>
            <input asp-for="ContactPhone" class="form-control" />
            <span asp-validation-for="ContactPhone" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3 stacked-field">
        <label class="form-label">Ad Image</label>
        <input type="file" id="adImageFileInput" class="form-control" accept="image/*" />
        <div class="mt-2 d-flex gap-2">
            <button type="button" id="openAdCropModalButton" class="btn btn-outline-primary" disabled>Clip
                Image</button>
                <button type="button" id="clearAdImageButton" class="btn btn-outline-secondary">Clear Image</button>
            </div>
        </div>

        <div id="adImagePreviewContainer" class="mb-3 stacked-field @(hasImage ? string.Empty : "d-none")">
            <label class="form-label">Image Preview</label>
            <div>
                <img id="adImagePreview" src="@Model?.ImageURL" alt="Ad image preview" class="img-fluid rounded border"
                     style="max-height: 220px;" />
            </div>
        </div>

        <input type="hidden" asp-for="ImageURL" />
        <input type="hidden" id="CroppedAdImageData" name="croppedImageData" />
        <input type="hidden" id="ClearedImageUrl" name="clearedImageUrl" />

        <button type="submit" class="btn btn-primary">Create</button>
        <a asp-action="Ads" class="btn btn-secondary">Cancel</a>
    </form>

    <div class="modal fade" id="adImageCropModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-fullscreen">
            <div class="modal-content h-100">
                <div class="modal-header py-2 px-3">
                    <h5 class="modal-title">Clip Ad Image</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body pt-2 pb-2 px-3 d-flex flex-column overflow-hidden">
                    <div class="d-flex flex-wrap gap-2 align-items-center pb-2 mb-3 flex-shrink-0">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <label for="cropAspectRatioSelect" class="form-label mb-0 text-nowrap">Aspect Ratio</label>
                            <select id="cropAspectRatioSelect" class="form-select form-select-sm" style="min-width: 100px;">
                                <option value="3:2" selected>3:2</option>
                                <option value="1:1">1:1</option>
                                <option value="4:3">4:3</option>
                                <option value="16:9">16:9</option>
                                <option value="9:16">9:16</option>
                                <option value="19:10">19:10</option>
                                <option value="6:5">6:5</option>
                                <option value="8:1">8:1</option>
                                <option value="32:5">32:5</option>
                                <option value="2:1">2:1</option>
                                <option value="3:1">3:1</option>
                                <option value="4:1">4:1</option>
                                <option value="10:1">10:1</option>
                                <option value="2:3">2:3</option>
                                <option value="1:2">1:2</option>
                                <option value="1:4">1:4</option>
                                <option value="1:8">1:8</option>
                                <option value="custom">Custom</option>
                            </select>
                        </div>
                        <button type="button" id="editCropModeButton" class="btn btn-sm btn-primary mb-1 text-nowrap">Crop
                            Mode</button>
                            <button type="button" id="editPenModeButton"
                                    class="btn btn-sm btn-outline-secondary mb-1 text-nowrap">Free Draw Pen</button>
                            <button type="button" id="editEraseModeButton"
                                    class="btn btn-sm btn-outline-secondary mb-1 text-nowrap">Erasor</button>
                            <button type="button" id="editTextModeButton"
                                    class="btn btn-sm btn-outline-secondary mb-1 text-nowrap">Type Text</button>
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <label for="editFontSelect" class="form-label mb-0 text-nowrap">Font</label>
                                <select id="editFontSelect" class="form-select form-select-sm" style="min-width: 150px;">
                                    <option value="Arial, sans-serif" selected>Arial</option>
                                    <option value="'Segoe UI', sans-serif">Segoe UI</option>
                                    <option value="Verdana, sans-serif">Verdana</option>
                                    <option value="Tahoma, sans-serif">Tahoma</option>
                                    <option value="Georgia, serif">Georgia</option>
                                    <option value="'Times New Roman', serif">Times New Roman</option>
                                    <option value="'Courier New', monospace">Courier New</option>
                                </select>
                            </div>
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <label for="editFontSizeInput" class="form-label mb-0 text-nowrap">Font Size</label>
                                <input id="editFontSizeInput" type="number" class="form-control form-control-sm" min="8"
                                       max="120" step="1" value="26" style="width: 90px;" />
                            </div>
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <label for="editBrushSizeInput" class="form-label mb-0 text-nowrap">Brush Size</label>
                                <input id="editBrushSizeInput" type="range" class="form-range mb-0" min="0" max="30" value="6"
                                       style="width: 140px;" />
                                <span id="editBrushSizeValue" class="small text-muted text-nowrap">6</span>
                            </div>
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <label for="editColorInput" class="form-label mb-0 text-nowrap">Color</label>
                                <input id="editColorInput" type="color" class="form-control form-control-color"
                                       value="#ff0000" />
                            </div>
                            <button type="button" id="undoEditButton"
                                    class="btn btn-sm btn-outline-secondary mb-1 text-nowrap">Undo</button>
                            <button type="button" id="redoEditButton"
                                    class="btn btn-sm btn-outline-secondary mb-1 text-nowrap">Redo</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary mb-1 text-nowrap"
                                    data-bs-dismiss="modal">Cancel</button>
                            <button type="button" id="saveCroppedImageButton"
                                    class="btn btn-sm btn-primary mb-1 text-nowrap">Save Clipped Image</button>
                        </div>
                        <div class="position-relative border rounded overflow-hidden bg-light flex-grow-1"
                             style="min-height: 0; background-color: #e9ecef;">
                            <img id="cropperImage" alt="Image to crop" class="w-100 h-100" style="object-fit: contain;" />
                            <canvas id="editCanvas" class="w-100 h-100 d-none"
                                    style="touch-action: none; cursor: crosshair; width: 100%; height: 100%;"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @section Scripts {
            <partial name="_ValidationScriptsPartial" />
            <script>
                (() => {
                    const subcategories = @Html.Raw(JsonSerializer.Serialize(subcategoryLookup));
                    const cities = @Html.Raw(JsonSerializer.Serialize(cityLookup));

                    const categorySelect = document.getElementById("CategoryId");
                    const subcategorySelect = document.getElementById("SubcategoryId");
                    const provinceSelect = document.getElementById("ProvinceId");
                    const citySelect = document.getElementById("CityId");

                    const selectedSubcategoryId = Number(subcategorySelect?.value || 0);
                    const selectedCityId = Number(citySelect?.value || 0);

                    const populate = (target, items, placeholder, valueKey = "id") => {
                        if (!target) {
                            return;
                        }

                        target.innerHTML = "";

                        const placeholderOption = document.createElement("option");
                        placeholderOption.value = "";
                        placeholderOption.textContent = placeholder;
                        target.appendChild(placeholderOption);

                        items.forEach(item => {
                            const option = document.createElement("option");
                            option.value = item[valueKey];
                            option.textContent = item.name;
                            target.appendChild(option);
                        });
                    };

                    const refreshSubcategories = (selectedId = 0) => {
                        const categoryId = Number(categorySelect?.value || 0);
                        const filtered = categoryId > 0
                            ? subcategories.filter(item => item.categoryId === categoryId)
                            : [];

                        populate(subcategorySelect, filtered, "Select Subcategory");

                        if (selectedId > 0 && filtered.some(item => item.id === selectedId)) {
                            subcategorySelect.value = String(selectedId);
                        }
                    };

                    const refreshCities = (selectedId = 0) => {
                        const provinceId = Number(provinceSelect?.value || 0);
                        const filtered = provinceId > 0
                            ? cities.filter(item => item.provinceId === provinceId)
                            : [];

                        populate(citySelect, filtered, "Select City");

                        if (selectedId > 0 && filtered.some(item => item.id === selectedId)) {
                            citySelect.value = String(selectedId);
                        }
                    };

                    categorySelect?.addEventListener("change", () => refreshSubcategories());
                    provinceSelect?.addEventListener("change", () => refreshCities());

                    refreshSubcategories(selectedSubcategoryId);
                    refreshCities(selectedCityId);
                })();
            </script>
            <script src="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.js"></script>
            <script>
                (() => {
                const adImageFileInput = document.getElementById("adImageFileInput");
                const openAdCropModalButton = document.getElementById("openAdCropModalButton");
                const clearAdImageButton = document.getElementById("clearAdImageButton");
                const adImagePreviewContainer = document.getElementById("adImagePreviewContainer");
                const adImagePreview = document.getElementById("adImagePreview");
                const imageUrlInput = document.getElementById("ImageURL");
                const croppedAdImageDataInput = document.getElementById("CroppedAdImageData");
                const clearedImageUrlInput = document.getElementById("ClearedImageUrl");

                const cropModalElement = document.getElementById("adImageCropModal");
                const cropModal = new bootstrap.Modal(cropModalElement);

                let sourceImageDataUrl = "";

                const editor = window.CanHappyImageClipping.createEditor({
                modal: cropModalElement,
                onSave: async ({ canvas }) => {
                const croppedDataUrl = window.CanHappyImageClipping.buildFullImageDataUrl(canvas, { preferPng: true });
                croppedAdImageDataInput.value = croppedDataUrl;
                imageUrlInput.value = "";
                adImagePreview.src = croppedDataUrl;
                adImagePreviewContainer.classList.remove("d-none");
                cropModal.hide();
                }
                });

                adImageFileInput.addEventListener("change", () => {
                const file = adImageFileInput.files?.[0];
                if (!file) {
                sourceImageDataUrl = "";
                openAdCropModalButton.disabled = true;
                return;
                }

                const reader = new FileReader();
                reader.onload = (event) => {
                sourceImageDataUrl = event.target?.result?.toString() || "";
                openAdCropModalButton.disabled = !sourceImageDataUrl;
                if (sourceImageDataUrl) {
                editor.open(sourceImageDataUrl);
                }
                };
                reader.readAsDataURL(file);
                });

                if (adImagePreview?.src) {
                sourceImageDataUrl = adImagePreview.src;
                openAdCropModalButton.disabled = false;
                }

                openAdCropModalButton.addEventListener("click", () => {
                if (!sourceImageDataUrl) {
                return;
                }

                editor.open(sourceImageDataUrl);
                });

                clearAdImageButton.addEventListener("click", () => {
                if (clearedImageUrlInput) {
                clearedImageUrlInput.value = imageUrlInput.value || adImagePreview.getAttribute("src") || "";
                }
                adImageFileInput.value = "";
                sourceImageDataUrl = "";
                openAdCropModalButton.disabled = true;
                croppedAdImageDataInput.value = "";
                imageUrlInput.value = "";
                adImagePreview.src = "";
                adImagePreviewContainer.classList.add("d-none");
                });
                })();
            </script>
            <script>
                (() => {
                const editBrushSizeInput = document.getElementById("editBrushSizeInput");
                const editBrushSizeValue = document.getElementById("editBrushSizeValue");
                if (!editBrushSizeInput || !editBrushSizeValue) {
                return;
                }

                const syncBrushSizeValue = () => {
                editBrushSizeValue.textContent = editBrushSizeInput.value;
                };

                editBrushSizeInput.addEventListener("input", syncBrushSizeValue);
                syncBrushSizeValue();
                })();
            </script>
        }