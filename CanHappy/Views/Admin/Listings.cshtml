@model IReadOnlyList<CanHappy.Models.Listing>
@using System.Text.Json

@{
    ViewData["Title"] = "Manage Listings";
    var searchSubject = ViewData["SearchSubject"]?.ToString();
    var selectedCategoryId = ViewData["SearchCategoryId"] is int categoryValue ? categoryValue : (int?)null;
    var selectedSubcategoryId = ViewData["SearchSubcategoryId"] is int subcategoryValue ? subcategoryValue : (int?)null;
    var selectedProvinceId = ViewData["SearchProvinceId"] is int provinceValue ? provinceValue : (int?)null;
    var selectedCityId = ViewData["SearchCityId"] is int cityValue ? cityValue : (int?)null;
    var searchFromDate = ViewData["SearchFromDate"] is DateTime fromDateValue ? fromDateValue : (DateTime?)null;
    var searchToDate = ViewData["SearchToDate"] is DateTime toDateValue ? toDateValue : (DateTime?)null;
    var currentPage = ViewData["CurrentPage"] is int pageValue ? pageValue : 1;
    var totalPages = ViewData["TotalPages"] is int totalPageValue ? totalPageValue : 1;
    var maxVisiblePageLinks = 5;
    var halfWindow = maxVisiblePageLinks / 2;
    var startPage = Math.Max(1, currentPage - halfWindow);
    var endPage = Math.Min(totalPages, startPage + maxVisiblePageLinks - 1);
    if (endPage - startPage + 1 < maxVisiblePageLinks)
    {
        startPage = Math.Max(1, endPage - maxVisiblePageLinks + 1);
    }

    var fromDateInput = searchFromDate?.ToString("yyyy-MM-dd") ?? string.Empty;
    var toDateInput = searchToDate?.ToString("yyyy-MM-dd") ?? string.Empty;

    var subcategoryLookupJson = JsonSerializer.Serialize(ViewData["SubcategoryLookup"] ?? new List<object>());
    var cityLookupJson = JsonSerializer.Serialize(ViewData["CityLookup"] ?? new List<object>());
}

<style>
    .form-label {
        font-weight: 700;
    }

    .search-label {
        min-width: 6.75rem;
        font-weight: 700;
        justify-content: flex-start;
    }

    .compact-search .input-group-text,
    .compact-search .form-control,
    .compact-search .form-select,
    .compact-search .btn {
        min-height: 1.9rem;
        padding-top: 0.15rem;
        padding-bottom: 0.15rem;
        font-size: 0.85rem;
        line-height: 1.1;
    }

    .compact-search .search-label {
        min-width: 5.9rem;
        padding-left: 0.45rem;
        padding-right: 0.45rem;
    }
</style>

<div class="d-flex align-items-center mb-3">
    <h1 class="mb-0">@ViewData["Title"]</h1>

    @if (totalPages > 1)
    {
        <div class="flex-grow-1 d-flex justify-content-center">
            <nav aria-label="Listings pagination header">
                <ul class="pagination pagination-sm mb-0 justify-content-center">
                    <li class="page-item @(currentPage <= 1 ? "disabled" : string.Empty)">
                        <a class="page-link" asp-action="Listings" asp-route-subject="@searchSubject"
                           asp-route-categoryId="@selectedCategoryId" asp-route-subcategoryId="@selectedSubcategoryId"
                           asp-route-provinceId="@selectedProvinceId" asp-route-cityId="@selectedCityId"
                           asp-route-fromDate="@fromDateInput" asp-route-toDate="@toDateInput"
                           asp-route-page="@(currentPage - 1)" aria-label="Previous">&lt;</a>
                    </li>

                    @if (startPage > 1)
                    {
                        <li class="page-item @(currentPage == 1 ? "active" : string.Empty)">
                            <a class="page-link" asp-action="Listings" asp-route-subject="@searchSubject"
                               asp-route-categoryId="@selectedCategoryId" asp-route-subcategoryId="@selectedSubcategoryId"
                               asp-route-provinceId="@selectedProvinceId" asp-route-cityId="@selectedCityId"
                               asp-route-fromDate="@fromDateInput" asp-route-toDate="@toDateInput" asp-route-page="1">1</a>
                        </li>

                        @if (startPage > 2)
                        {
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        }
                    }

                    @for (var pageNumber = startPage; pageNumber <= endPage; pageNumber++)
                    {
                        <li class="page-item @(pageNumber == currentPage ? "active" : string.Empty)">
                            <a class="page-link" asp-action="Listings" asp-route-subject="@searchSubject"
                               asp-route-categoryId="@selectedCategoryId" asp-route-subcategoryId="@selectedSubcategoryId"
                               asp-route-provinceId="@selectedProvinceId" asp-route-cityId="@selectedCityId"
                               asp-route-fromDate="@fromDateInput" asp-route-toDate="@toDateInput"
                               asp-route-page="@pageNumber">@pageNumber</a>
                        </li>
                    }

                    @if (endPage < totalPages)
                    {
                        @if (endPage < totalPages - 1)
                        {
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        }

                        <li class="page-item @(currentPage == totalPages ? "active" : string.Empty)">
                            <a class="page-link" asp-action="Listings" asp-route-subject="@searchSubject"
                               asp-route-categoryId="@selectedCategoryId" asp-route-subcategoryId="@selectedSubcategoryId"
                               asp-route-provinceId="@selectedProvinceId" asp-route-cityId="@selectedCityId"
                               asp-route-fromDate="@fromDateInput" asp-route-toDate="@toDateInput"
                               asp-route-page="@totalPages">@totalPages</a>
                        </li>
                    }

                    <li class="page-item @(currentPage >= totalPages ? "disabled" : string.Empty)">
                        <a class="page-link" asp-action="Listings" asp-route-subject="@searchSubject"
                           asp-route-categoryId="@selectedCategoryId" asp-route-subcategoryId="@selectedSubcategoryId"
                           asp-route-provinceId="@selectedProvinceId" asp-route-cityId="@selectedCityId"
                           asp-route-fromDate="@fromDateInput" asp-route-toDate="@toDateInput"
                           asp-route-page="@(currentPage + 1)"                  aria-label="Next">&gt;</a>
                    </li>

                    <li class="page-item">
                        <form asp-action="Listings" method="get" class="d-flex align-items-center ms-2">
                            <input type="hidden" name="subject" value="@searchSubject" />
                            <input type="hidden" name="categoryId" value="@selectedCategoryId" />
                            <input type="hidden" name="subcategoryId" value="@selectedSubcategoryId" />
                            <input type="hidden" name="provinceId" value="@selectedProvinceId" />
                            <input type="hidden" name="cityId" value="@selectedCityId" />
                            <input type="hidden" name="fromDate" value="@fromDateInput" />
                            <input type="hidden" name="toDate" value="@toDateInput" />
                            <input type="text" name="page" inputmode="numeric" pattern="[0-9]*" value="@currentPage"
                                   class="form-control form-control-sm"
                                   style="width: 1.65rem; height: 1.28rem; padding: 0 0.15rem; font-size: 0.72rem; line-height: 1; text-align: center;" />
                        </form>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>

<div class="card mb-3">
    <div class="card-body py-2">
        <form asp-action="Listings" method="get" class="row g-1 align-items-center compact-search">
            <div class="col-xl-4 col-lg-6 col-md-12">
                <div class="input-group">
                    <span class="input-group-text search-label">Subject</span>
                    <input type="text" name="subject" value="@searchSubject" class="form-control" />
                </div>
            </div>
            <div class="col-xl-2 col-lg-3 col-md-6">
                <div class="input-group">
                    <span class="input-group-text search-label">Category</span>
                    <select id="categoryId" name="categoryId" class="form-select" asp-items="ViewBag.CategoryId">
                        <option value="">All</option>
                    </select>
                </div>
            </div>
            <div class="col-xl-2 col-lg-3 col-md-6">
                <div class="input-group">
                    <span class="input-group-text search-label">Subcategory</span>
                    <select id="subcategoryId" name="subcategoryId" class="form-select"
                            data-selected-value="@(selectedSubcategoryId?.ToString() ?? string.Empty)">
                        <option value="">All</option>
                    </select>
                </div>
            </div>
            <div class="col-xl-2 col-lg-3 col-md-6">
                <div class="input-group">
                    <span class="input-group-text search-label">Province</span>
                    <select id="provinceId" name="provinceId" class="form-select" asp-items="ViewBag.ProvinceId">
                        <option value="">All</option>
                    </select>
                </div>
            </div>
            <div class="col-xl-2 col-lg-3 col-md-6">
                <div class="input-group">
                    <span class="input-group-text search-label">City</span>
                    <select id="cityId" name="cityId" class="form-select"
                            data-selected-value="@(selectedCityId?.ToString() ?? string.Empty)">
                        <option value="">All</option>
                    </select>
                </div>
            </div>
            <div class="col-xl-2 col-lg-3 col-md-6">
                <div class="input-group">
                    <span class="input-group-text search-label">FromDate</span>
                    <input type="date" name="fromDate" value="@fromDateInput" class="form-control" />
                </div>
            </div>
            <div class="col-xl-2 col-lg-3 col-md-6">
                <div class="input-group">
                    <span class="input-group-text search-label">ToDate</span>
                    <input type="date" name="toDate" value="@toDateInput" class="form-control" />
                </div>
            </div>
            <div class="col-xl-2 col-lg-3 col-md-6 d-flex gap-1">
                <button type="submit" class="btn btn-primary flex-fill">Search</button>
                <a asp-action="Listings" class="btn btn-outline-secondary flex-fill">Clear</a>
            </div>
        </form>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Subject</th>
                <th>Category</th>
                <th>Subcategory</th>
                <th>Province</th>
                <th>City</th>
                <th>CreatedBy</th>
                <th>ModifiedBy</th>
                <th>CreatedDate</th>
                <th>ModifiedDate</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="10" class="text-muted">No listings found.</td>
                </tr>
            }
            else
            {
                @foreach (var listing in Model)
                {
                    var isBuySellCategory = string.Equals(listing.Category?.Name, "Buy & Sell",
                    StringComparison.OrdinalIgnoreCase);
                    var isCarVehicleCategory = string.Equals(listing.Category?.Name, "Car & Vehicle",
                    StringComparison.OrdinalIgnoreCase);
                    var isHomeRentalCategory = string.Equals(listing.Category?.Name, "Home Rental",
                    StringComparison.OrdinalIgnoreCase);
                    var isEstateSaleCategory = string.Equals(listing.Category?.Name, "Estate Sale",
                    StringComparison.OrdinalIgnoreCase);
                    var isCarPoolCategory = string.Equals(listing.Category?.Name, "Car Pool",
                    StringComparison.OrdinalIgnoreCase);
                    var isBusinessYellowPageCategory = string.Equals(listing.Category?.Name, "Business Yellow Page",
                    StringComparison.OrdinalIgnoreCase);

                    var detailsUrl = isBuySellCategory
                    ? Url.Action("Index", "BuySellDetailPage", new { listingGuid = listing.ListingGUID })
                    : isCarVehicleCategory
                    ? Url.Action("Index", "CarVehicleDetailPage", new { listingGuid = listing.ListingGUID })
                    : isHomeRentalCategory
                    ? Url.Action("Index", "HomeRentalDetailPage", new { listingGuid = listing.ListingGUID })
                    : isEstateSaleCategory
                    ? Url.Action("Index", "EstateSaleDetailPage", new { listingGuid = listing.ListingGUID })
                    : isCarPoolCategory
                    ? Url.Action("Index", "CarPoolDetailPage", new { listingGuid = listing.ListingGUID })
                    : isBusinessYellowPageCategory
                    ? Url.Action("Index", "BusinessYellowPageDetailPage", new { listingGuid = listing.ListingGUID })
                    : Url.Action("Details", "ListingPage", new { id = listing.ListingGUID });

                    <tr>
                        <td>@listing.Subject</td>
                        <td>@(listing.Category?.Name ?? "-")</td>
                        <td>@(listing.Subcategory?.Name ?? "-")</td>
                        <td>@(listing.Province?.Name ?? "-")</td>
                        <td>@(listing.City?.Name ?? "-")</td>
                        <td>@listing.CreatedBy</td>
                        <td>@listing.ModifiedBY</td>
                        <td>@listing.CreatedDate</td>
                        <td>@listing.ModifiedDate</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-info" href="@detailsUrl">Details</a>
                            <a class="btn btn-sm btn-outline-secondary" asp-controller="ListingPage" asp-action="Edit"
                               asp-route-id="@listing.ListingGUID">Edit</a>
                            @if (User.IsInRole("Admin"))
                            {
                                <a class="btn btn-sm btn-outline-danger" asp-action="DeleteListing"
                                   asp-route-id="@listing.ListingGUID">Delete</a>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@if (totalPages > 1)
{
    <nav aria-label="Listings pagination" class="mt-3">
        <ul class="pagination pagination-sm justify-content-center mb-0">
            <li class="page-item @(currentPage <= 1 ? "disabled" : string.Empty)">
                <a class="page-link" asp-action="Listings" asp-route-subject="@searchSubject"
                   asp-route-categoryId="@selectedCategoryId" asp-route-subcategoryId="@selectedSubcategoryId"
                   asp-route-provinceId="@selectedProvinceId" asp-route-cityId="@selectedCityId"
                   asp-route-fromDate="@fromDateInput" asp-route-toDate="@toDateInput" asp-route-page="@(currentPage - 1)"
                   aria-label="Previous">&lt;</a>
            </li>

            @if (startPage > 1)
            {
                <li class="page-item @(currentPage == 1 ? "active" : string.Empty)">
                    <a class="page-link" asp-action="Listings" asp-route-subject="@searchSubject"
                       asp-route-categoryId="@selectedCategoryId" asp-route-subcategoryId="@selectedSubcategoryId"
                       asp-route-provinceId="@selectedProvinceId" asp-route-cityId="@selectedCityId"
                       asp-route-fromDate="@fromDateInput" asp-route-toDate="@toDateInput" asp-route-page="1">1</a>
                </li>

                @if (startPage > 2)
                {
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                }
            }

            @for (var pageNumber = startPage; pageNumber <= endPage; pageNumber++)
            {
                <li class="page-item @(pageNumber == currentPage ? "active" : string.Empty)">
                    <a class="page-link" asp-action="Listings" asp-route-subject="@searchSubject"
                       asp-route-categoryId="@selectedCategoryId" asp-route-subcategoryId="@selectedSubcategoryId"
                       asp-route-provinceId="@selectedProvinceId" asp-route-cityId="@selectedCityId"
                       asp-route-fromDate="@fromDateInput" asp-route-toDate="@toDateInput"
                       asp-route-page="@pageNumber">@pageNumber</a>
                </li>
            }

            @if (endPage < totalPages)
            {
                @if (endPage < totalPages - 1)
                {
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                }

                <li class="page-item @(currentPage == totalPages ? "active" : string.Empty)">
                    <a class="page-link" asp-action="Listings" asp-route-subject="@searchSubject"
                       asp-route-categoryId="@selectedCategoryId" asp-route-subcategoryId="@selectedSubcategoryId"
                       asp-route-provinceId="@selectedProvinceId" asp-route-cityId="@selectedCityId"
                       asp-route-fromDate="@fromDateInput" asp-route-toDate="@toDateInput"
                       asp-route-page="@totalPages">@totalPages</a>
                </li>
            }

            <li class="page-item @(currentPage >= totalPages ? "disabled" : string.Empty)">
                <a class="page-link" asp-action="Listings" asp-route-subject="@searchSubject"
                   asp-route-categoryId="@selectedCategoryId" asp-route-subcategoryId="@selectedSubcategoryId"
                   asp-route-provinceId="@selectedProvinceId" asp-route-cityId="@selectedCityId"
                   asp-route-fromDate="@fromDateInput" asp-route-toDate="@toDateInput" asp-route-page="@(currentPage + 1)"
                   aria-label="Next">&gt;</a>
            </li>

            <li class="page-item">
                <form asp-action="Listings" method="get" class="d-flex align-items-center ms-2">
                    <input type="hidden" name="subject" value="@searchSubject" />
                    <input type="hidden" name="categoryId" value="@selectedCategoryId" />
                    <input type="hidden" name="subcategoryId" value="@selectedSubcategoryId" />
                    <input type="hidden" name="provinceId" value="@selectedProvinceId" />
                    <input type="hidden" name="cityId" value="@selectedCityId" />
                    <input type="hidden" name="fromDate" value="@fromDateInput" />
                    <input type="hidden" name="toDate" value="@toDateInput" />
                    <input type="text" name="page" inputmode="numeric" pattern="[0-9]*" value="@currentPage"
                           class="form-control form-control-sm"
                           style="width: 1.65rem; height: 1.28rem; padding: 0 0.15rem; font-size: 0.72rem; line-height: 1; text-align: center;" />
                </form>
            </li>
        </ul>
    </nav>
}

@section Scripts {
    <script>
            (() => {
                const subcategories = @Html.Raw(subcategoryLookupJson);
                const cities = @Html.Raw(cityLookupJson);

                const categorySelect = document.getElementById("categoryId");
                const subcategorySelect = document.getElementById("subcategoryId");
                const provinceSelect = document.getElementById("provinceId");
                const citySelect = document.getElementById("cityId");

                if (!categorySelect || !subcategorySelect || !provinceSelect || !citySelect) {
                    return;
                }

                const selectedSubcategoryId = subcategorySelect.dataset.selectedValue || "";
                const selectedCityId = citySelect.dataset.selectedValue || "";

                const populateSelect = (target, items, placeholder) => {
                    target.innerHTML = "";
                    target.appendChild(new Option(placeholder, ""));

                    items.forEach((item) => {
                        const option = new Option(item.name, String(item.id));
                        target.appendChild(option);
                    });
                };

                const refreshSubcategories = (selectedId = "") => {
                    const categoryId = Number(categorySelect.value || 0);
                    const filtered = categoryId > 0
                        ? subcategories.filter((item) => Number(item.categoryId) === categoryId)
                        : [];

                    populateSelect(subcategorySelect, filtered, "All");

                    if (selectedId && filtered.some((item) => String(item.id) === String(selectedId))) {
                        subcategorySelect.value = String(selectedId);
                    }
                };

                const refreshCities = (selectedId = "") => {
                    const provinceId = Number(provinceSelect.value || 0);
                    const filtered = provinceId > 0
                        ? cities.filter((item) => Number(item.provinceId) === provinceId)
                        : [];

                    populateSelect(citySelect, filtered, "All");

                    if (selectedId && filtered.some((item) => String(item.id) === String(selectedId))) {
                        citySelect.value = String(selectedId);
                    }
                };

                refreshSubcategories(selectedSubcategoryId);
                refreshCities(selectedCityId);

                categorySelect.addEventListener("change", () => refreshSubcategories(""));
                provinceSelect.addEventListener("change", () => refreshCities(""));
            })();
    </script>
}