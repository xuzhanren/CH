@model CanHappy.Models.Listing

@{
    ViewData["Title"] = "Edit Listing";
}

<h1>@ViewData["Title"]</h1>

<form asp-action="EditListing" method="post" asp-route-id="@Model.ListingGUID">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="ListingGUID" />
    <div class="row g-3">
        <div class="col-md-3">
            <label asp-for="CategoryId" class="form-label"></label>
            <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId"></select>
        </div>
        <div class="col-md-3">
            <label asp-for="SubcategoryId" class="form-label"></label>
            <select asp-for="SubcategoryId" class="form-select" asp-items="ViewBag.SubcategoryId">
                <option value="">None</option>
            </select>
        </div>
        <div class="col-md-3">
            <label asp-for="ProvinceId" class="form-label"></label>
            <select asp-for="ProvinceId" class="form-select" asp-items="ViewBag.ProvinceId"></select>
        </div>
        <div class="col-md-3">
            <label asp-for="CityId" class="form-label"></label>
            <select asp-for="CityId" class="form-select" asp-items="ViewBag.CityId"></select>
        </div>

        <div class="col-md-6">
            <label asp-for="Subject" class="form-label"></label>
            <input asp-for="Subject" class="form-control" />
            <span asp-validation-for="Subject" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="KeyWords" class="form-label"></label>
            <input asp-for="KeyWords" class="form-control" />
        </div>
        <div class="col-12">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        </div>

        <div class="col-md-4">
            <label asp-for="Address" class="form-label"></label>
            <input asp-for="Address" class="form-control" />
        </div>
        <div class="col-md-2">
            <label asp-for="PostalCode" class="form-label"></label>
            <input asp-for="PostalCode" class="form-control" />
        </div>
        <div class="col-md-3">
            <label asp-for="ContactPhone" class="form-label"></label>
            <input asp-for="ContactPhone" class="form-control" />
        </div>
        <div class="col-md-3">
            <label asp-for="ContactName" class="form-label"></label>
            <input asp-for="ContactName" class="form-control" />
        </div>

        <div class="col-md-3">
            <label asp-for="ThumbnailURL" class="form-label"></label>
            <input asp-for="ThumbnailURL" class="form-control" />
        </div>
        <div class="col-md-2">
            <label asp-for="Rating" class="form-label"></label>
            <input asp-for="Rating" class="form-control" />
        </div>
        <div class="col-md-2">
            <label asp-for="Brand" class="form-label"></label>
            <input asp-for="Brand" class="form-control" />
        </div>
        <div class="col-md-2">
            <label asp-for="Condition" class="form-label"></label>
            <input asp-for="Condition" class="form-control" />
        </div>
        <div class="col-md-3">
            <label asp-for="Model" class="form-label"></label>
            <input asp-for="Model" class="form-control" />
        </div>

        <div class="col-md-2">
            <label asp-for="Quantity" class="form-label"></label>
            <input asp-for="Quantity" class="form-control" type="number" />
        </div>
        <div class="col-md-2">
            <label asp-for="ManufactureYear" class="form-label"></label>
            <input asp-for="ManufactureYear" class="form-control" type="number" />
        </div>
        <div class="col-md-2">
            <label asp-for="Price" class="form-label"></label>
            <input asp-for="Price" class="form-control" type="number" step="0.01" />
        </div>
        <div class="col-md-2">
            <label asp-for="DiscountPercent" class="form-label"></label>
            <input asp-for="DiscountPercent" class="form-control" type="number" step="0.01" />
        </div>
        <div class="col-md-2">
            <label asp-for="ViewCount" class="form-label"></label>
            <input asp-for="ViewCount" class="form-control" type="number" />
        </div>
        <div class="col-md-2">
            <label asp-for="ClickCount" class="form-label"></label>
            <input asp-for="ClickCount" class="form-control" type="number" />
        </div>

        <div class="col-md-3">
            <label asp-for="DiscountBeginDate" class="form-label"></label>
            <input asp-for="DiscountBeginDate" class="form-control" type="datetime-local" />
        </div>
        <div class="col-md-3">
            <label asp-for="DiscountEndDate" class="form-label"></label>
            <input asp-for="DiscountEndDate" class="form-control" type="datetime-local" />
        </div>
        <div class="col-md-3">
            <label asp-for="UserId" class="form-label"></label>
            <input asp-for="UserId" class="form-control" />
        </div>
        <div class="col-md-3">
            <label asp-for="CreatedBy" class="form-label"></label>
            <input asp-for="CreatedBy" class="form-control" />
        </div>
        <div class="col-md-3">
            <label asp-for="ModifiedBY" class="form-label"></label>
            <input asp-for="ModifiedBY" class="form-control" />
        </div>
        <div class="col-md-3">
            <label asp-for="CreatedDate" class="form-label"></label>
            <input asp-for="CreatedDate" class="form-control" type="datetime-local" />
        </div>
        <div class="col-md-3">
            <label asp-for="ModifiedDate" class="form-label"></label>
            <input asp-for="ModifiedDate" class="form-control" type="datetime-local" />
        </div>

        <div class="col-md-3 form-check mt-4 ms-2">
            <input asp-for="ShowContactInd" class="form-check-input" />
            <label asp-for="ShowContactInd" class="form-check-label"></label>
        </div>
        <div class="col-md-3 form-check mt-4 ms-2">
            <input asp-for="DeletedInd" class="form-check-input" />
            <label asp-for="DeletedInd" class="form-check-label"></label>
        </div>
        <div class="col-md-3 form-check mt-4 ms-2">
            <input asp-for="SampleInd" class="form-check-input" />
            <label asp-for="SampleInd" class="form-check-label"></label>
        </div>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Listings" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}