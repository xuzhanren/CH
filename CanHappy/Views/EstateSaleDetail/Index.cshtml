                                @section Scripts {
                                    <script src="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.js"></script>
                                    <script>
                                        (() => {
                                        const setupViewer = (config) => {
                                        const modalElement = document.getElementById(config.modalId);
                                        const image = document.getElementById(config.mainImageId);
                                        const imageTitle = document.getElementById(config.imageTitleId);
                                        const previousButton = document.getElementById(config.prevButtonId);
                                        const nextButton = document.getElementById(config.nextButtonId);
                                        const zoomInButton = document.getElementById(config.zoomInButtonId);
                                        const zoomOutButton = document.getElementById(config.zoomOutButtonId);
                                        const zoomResetButton = document.getElementById(config.zoomResetButtonId);
                                        const thumbnailButtons = Array.from(document.querySelectorAll(config.thumbnailSelector));
                                        const triggerButtons = Array.from(document.querySelectorAll(config.triggerSelector));

                                        if (!modalElement || !image || !imageTitle || !previousButton || !nextButton || !zoomInButton || !zoomOutButton || !zoomResetButton || thumbnailButtons.length === 0) {
                                        return;
                                        }

                                        const modal = bootstrap.Modal.getOrCreateInstance(modalElement);
                                        const viewport = image.parentElement;
                                        let zoomScale = 1;
                                        let selectedIndex = 0;
                                        let targetTranslateX = 0;
                                        let targetTranslateY = 0;
                                        let isDragging = false;
                                        let lastPointerX = 0;
                                        let lastPointerY = 0;
                                        let rafPending = false;

                                        const getFittedImageSize = () => {
                                        const viewportWidth = Math.max(1, viewport.clientWidth);
                                        const viewportHeight = Math.max(1, viewport.clientHeight);
                                        const naturalWidth = Math.max(1, image.naturalWidth || 1);
                                        const naturalHeight = Math.max(1, image.naturalHeight || 1);
                                        const widthRatio = viewportWidth / naturalWidth;
                                        const heightRatio = viewportHeight / naturalHeight;
                                        const fitRatio = Math.min(widthRatio, heightRatio);

                                        return {
                                        viewportWidth,
                                        viewportHeight,
                                        fittedWidth: naturalWidth * fitRatio,
                                        fittedHeight: naturalHeight * fitRatio
                                        };
                                        };

                                        const clampTranslate = () => {
                                        const { viewportWidth, viewportHeight, fittedWidth, fittedHeight } = getFittedImageSize();
                                        const scaledWidth = fittedWidth * zoomScale;
                                        const scaledHeight = fittedHeight * zoomScale;
                                        const maxOffsetX = Math.max(0, (scaledWidth - viewportWidth) / 2);
                                        const maxOffsetY = Math.max(0, (scaledHeight - viewportHeight) / 2);

                                        targetTranslateX = Math.min(maxOffsetX, Math.max(-maxOffsetX, targetTranslateX));
                                        targetTranslateY = Math.min(maxOffsetY, Math.max(-maxOffsetY, targetTranslateY));
                                        };

                                        const renderTransform = () => {
                                        rafPending = false;
                                        image.style.transform = `translate(${targetTranslateX}px, ${targetTranslateY}px) scale(${zoomScale})`;
                                        zoomResetButton.textContent = `${Math.round(zoomScale * 100)}%`;
                                        };

                                        const scheduleRender = () => {
                                        if (rafPending) {
                                        return;
                                        }

                                        rafPending = true;
                                        requestAnimationFrame(renderTransform);
                                        };

                                        const applyZoom = () => {
                                        clampTranslate();
                                        scheduleRender();
                                        };

                                        const setZoom = (newZoom) => {
                                        zoomScale = Math.min(10, Math.max(0.2, newZoom));
                                        applyZoom();
                                        };

                                        const resetView = () => {
                                        zoomScale = 1;
                                        targetTranslateX = 0;
                                        targetTranslateY = 0;
                                        applyZoom();
                                        };

                                        const updateSelection = (index) => {
                                        if (index < 0) {
                                        index = thumbnailButtons.length - 1;
                                        } else if (index >= thumbnailButtons.length) {
                                        index = 0;
                                        }

                                        const selected = thumbnailButtons.find(button => Number.parseInt(button.dataset.index, 10) === index);
                                        if (!selected) {
                                        return;
                                        }

                                        selectedIndex = index;
                                        image.src = selected.dataset.imageUrl || "";
                                        imageTitle.textContent = selected.dataset.imageTitle || "Photo";
                                        resetView();

                                        thumbnailButtons.forEach(button => {
                                        const isActive = Number.parseInt(button.dataset.index, 10) === selectedIndex;
                                        button.classList.toggle("border-primary", isActive);
                                        button.classList.toggle("border-2", isActive);
                                        });

                                        selected.scrollIntoView({ behavior: "smooth", inline: "center", block: "nearest" });
                                        };

                                        thumbnailButtons.forEach(button => {
                                        button.addEventListener("click", () => {
                                        const index = Number.parseInt(button.dataset.index, 10);
                                        if (Number.isFinite(index)) {
                                        updateSelection(index);
                                        }
                                        });
                                        });

                                        triggerButtons.forEach(button => {
                                        button.addEventListener("click", () => {
                                        const index = Number.parseInt(button.dataset.index, 10);
                                        if (Number.isFinite(index)) {
                                        updateSelection(index);
                                        modal.show();
                                        }
                                        });
                                        });

                                        zoomInButton.addEventListener("click", () => setZoom(zoomScale + 0.2));
                                        zoomOutButton.addEventListener("click", () => setZoom(zoomScale - 0.2));
                                        zoomResetButton.addEventListener("click", resetView);
                                        previousButton.addEventListener("click", () => updateSelection(selectedIndex - 1));
                                        nextButton.addEventListener("click", () => updateSelection(selectedIndex + 1));
                                        image.addEventListener("load", resetView);

                                        image.addEventListener("wheel", (event) => {
                                        event.preventDefault();
                                        setZoom(zoomScale + (event.deltaY < 0 ? 0.1 : -0.1));
                                        }, { passive: false });

                                        image.addEventListener("contextmenu", (event) => event.preventDefault());

                                        image.addEventListener("pointerdown", (event) => {
                                        if (event.pointerType === "mouse" && event.button !== 0 && event.button !== 2) {
                                        return;
                                        }

                                        if (zoomScale <= 1) {
                                        return;
                                        }

                                        event.preventDefault();
                                        isDragging = true;
                                        lastPointerX = event.clientX;
                                        lastPointerY = event.clientY;
                                        image.style.cursor = "grabbing";
                                        image.setPointerCapture(event.pointerId);
                                        });

                                        image.addEventListener("pointermove", (event) => {
                                        if (!isDragging) {
                                        return;
                                        }

                                        const deltaX = event.clientX - lastPointerX;
                                        const deltaY = event.clientY - lastPointerY;
                                        lastPointerX = event.clientX;
                                        lastPointerY = event.clientY;

                                        targetTranslateX += deltaX;
                                        targetTranslateY += deltaY;
                                        applyZoom();
                                        });

                                        const stopDragging = (event) => {
                                        if (!isDragging) {
                                        return;
                                        }

                                        isDragging = false;
                                        image.style.cursor = zoomScale > 1 ? "grab" : "default";
                                        if (typeof event.pointerId !== "undefined") {
                                        image.releasePointerCapture(event.pointerId);
                                        }
                                        };

                                        image.addEventListener("pointerup", stopDragging);
                                        image.addEventListener("pointercancel", stopDragging);
                                        image.addEventListener("pointerleave", stopDragging);
                                        window.addEventListener("resize", applyZoom);

                                        updateSelection(0);
                                        };

                                        setupViewer({
                                        modalId: "listingPhotoViewerModal",
                                        mainImageId: "listingViewerMainImage",
                                        imageTitleId: "listingViewerImageTitle",
                                        prevButtonId: "listingViewerPrev",
                                        nextButtonId: "listingViewerNext",
                                        zoomInButtonId: "listingViewerZoomIn",
                                        zoomOutButtonId: "listingViewerZoomOut",
                                        zoomResetButtonId: "listingViewerZoomReset",
                                        thumbnailSelector: ".listing-viewer-thumb",
                                        triggerSelector: ".view-listing-photo"
                                        });

                                        setupViewer({
                                        modalId: "roomPhotoViewerModal",
                                        mainImageId: "roomViewerMainImage",
                                        imageTitleId: "roomViewerImageTitle",
                                        prevButtonId: "roomViewerPrev",
                                        nextButtonId: "roomViewerNext",
                                        zoomInButtonId: "roomViewerZoomIn",
                                        zoomOutButtonId: "roomViewerZoomOut",
                                        zoomResetButtonId: "roomViewerZoomReset",
                                        thumbnailSelector: ".room-viewer-thumb",
                                        triggerSelector: ".view-room-photo"
                                        });

                                        const addListingPhotoButton = document.getElementById("addListingPhotoButton");
                                        const addRoomButton = document.getElementById("addRoomButton");
                                        const photoFileInput = document.getElementById("photoFileInput");
                                        const photoUpsertForm = document.getElementById("photoUpsertForm");
                                        const roomUpsertForm = document.getElementById("roomUpsertForm");
                                        const cropModalElement = document.getElementById("cropModal");
                                        const cropModalTitle = document.getElementById("cropModalTitle");
                                        const cropperImage = document.getElementById("cropperImage");
                                        const editCanvas = document.getElementById("editCanvas");
                                        const editCanvasContainer = editCanvas?.parentElement;
                                        const editContext = editCanvas?.getContext("2d");
                                        const listingEditorFields = document.getElementById("listingEditorFields");
                                        const roomEditorFields = document.getElementById("roomEditorFields");
                                        const cropAspectRatioSelect = document.getElementById("cropAspectRatioSelect");
                                        const editCropModeButton = document.getElementById("editCropModeButton");
                                        const editPenModeButton = document.getElementById("editPenModeButton");
                                        const editEraseModeButton = document.getElementById("editEraseModeButton");
                                        const editTextModeButton = document.getElementById("editTextModeButton");
                                        const editFontSelect = document.getElementById("editFontSelect");
                                        const editFontSizeInput = document.getElementById("editFontSizeInput");
                                        const editBrushSizeInput = document.getElementById("editBrushSizeInput");
                                        const editColorInput = document.getElementById("editColorInput");
                                        const applyEditsButton = document.getElementById("applyEditsButton");
                                        const undoEditButton = document.getElementById("undoEditButton");
                                        const redoEditButton = document.getElementById("redoEditButton");
                                        const saveCroppedImageButton = document.getElementById("saveCroppedImageButton");

                                        if (!photoFileInput || !photoUpsertForm || !roomUpsertForm || !cropModalElement || !cropperImage || !editCanvas || !editContext || !cropAspectRatioSelect || !editCropModeButton || !editPenModeButton || !editEraseModeButton || !editTextModeButton || !editFontSelect || !editFontSizeInput || !editBrushSizeInput || !editColorInput || !applyEditsButton || !undoEditButton || !redoEditButton || !saveCroppedImageButton || !listingEditorFields || !roomEditorFields || !cropModalTitle) {
                                        return;
                                        }

                                        const photoListingImageGuidInput = document.getElementById("photoListingImageGuid");
                                        const photoTitleInput = document.getElementById("photoTitleInput");
                                        const photoSortOrderInput = document.getElementById("photoSortOrderInput");
                                        const photoCroppedDataInput = document.getElementById("photoCroppedDataInput");
                                        const photoThumbnailDataInput = document.getElementById("photoThumbnailDataInput");
                                        const photoTitleEditor = document.getElementById("photoTitleEditor");
                                        const photoSortOrderEditor = document.getElementById("photoSortOrderEditor");

                                        const roomGuidInput = document.getElementById("roomGuidInput");
                                        const roomNameInput = document.getElementById("roomNameInput");
                                        const roomSizeInput = document.getElementById("roomSizeInput");
                                        const roomSortOrderInput = document.getElementById("roomSortOrderInput");
                                        const roomFloorInput = document.getElementById("roomFloorInput");
                                        const roomCroppedDataInput = document.getElementById("roomCroppedDataInput");
                                        const roomThumbnailDataInput = document.getElementById("roomThumbnailDataInput");
                                        const roomNameEditor = document.getElementById("roomNameEditor");
                                        const roomSizeEditor = document.getElementById("roomSizeEditor");
                                        const roomSortOrderEditor = document.getElementById("roomSortOrderEditor");
                                        const roomFloorEditor = document.getElementById("roomFloorEditor");

                                        if (!photoListingImageGuidInput || !photoTitleInput || !photoSortOrderInput || !photoCroppedDataInput || !photoThumbnailDataInput || !photoTitleEditor || !photoSortOrderEditor || !roomGuidInput || !roomNameInput || !roomSizeInput || !roomSortOrderInput || !roomFloorInput || !roomCroppedDataInput || !roomThumbnailDataInput || !roomNameEditor || !roomSizeEditor || !roomSortOrderEditor || !roomFloorEditor) {
                                        return;
                                        }

                                        const cropModal = new bootstrap.Modal(cropModalElement);
                                        let sourceImageDataUrl = "";
                                        let workingImageDataUrl = "";
                                        let cropper = null;
                                        let currentAspectRatio = 3 / 2;
                                        let activeEditTool = "crop";
                                        let isDrawing = false;
                                        let lastPoint = null;
                                        let editHistory = [];
                                        let redoHistory = [];
                                        let editMode = "listing";

                                        const MAX_THUMBNAIL_BYTES = 30 * 1024;
                                        const MAX_FULL_IMAGE_BYTES = 3 * 1024 * 1024;

                                        const getAspectRatio = (value) => {
                                        if (value === "custom") {
                                        return Number.NaN;
                                        }

                                        const parts = (value || "").split(":");
                                        if (parts.length !== 2) {
                                        return 3 / 2;
                                        }

                                        const width = Number(parts[0]);
                                        const height = Number(parts[1]);
                                        if (!Number.isFinite(width) || !Number.isFinite(height) || width <= 0 || height <= 0) {
                                        return 3 / 2;
                                        }

                                        return width / height;
                                        };

