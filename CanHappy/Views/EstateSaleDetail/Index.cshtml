                                        const getMimeType = () => {
                                        const candidates = ["video/webm;codecs=vp9,opus", "video/webm;codecs=vp8,opus", "video/webm"];
                                        return candidates.find(type => MediaRecorder.isTypeSupported(type)) || "video/webm";
                                        };

                                        const resolveTextPosition = (position, width, height, margin, textHeight, textWidth) => {
                                        switch (position) {
                                        case "top-left":
                                        return { x: margin, y: margin + textHeight };
                                        case "top-right":
                                        return { x: Math.max(margin, width - textWidth - margin), y: margin + textHeight };
                                        case "bottom-left":
                                        return { x: margin, y: Math.max(textHeight + margin, height - margin) };
                                        default:
                                        return {
                                        x: Math.max(margin, width - textWidth - margin),
                                        y: Math.max(textHeight + margin, height - margin)
                                        };
                                        }
                                        };

                                        const exportEditedVideoAsync = async (sourceBlob, options) => {
                                        const sourceUrl = URL.createObjectURL(sourceBlob);
                                        const processingVideo = document.createElement("video");
                                        processingVideo.src = sourceUrl;
                                        processingVideo.crossOrigin = "anonymous";
                                        processingVideo.playsInline = true;
                                        processingVideo.preload = "auto";
                                        processingVideo.muted = false;

                                        await waitForEvent(processingVideo, "loadedmetadata", 2000);
                                        await waitForEvent(processingVideo, "loadeddata", 2000);

                                        const seekableDuration = processingVideo.seekable && processingVideo.seekable.length > 0
                                        ? processingVideo.seekable.end(processingVideo.seekable.length - 1)
                                        : 0;
                                        const duration = Number.isFinite(processingVideo.duration) && processingVideo.duration > 0
                                        ? processingVideo.duration
                                        : (Number.isFinite(seekableDuration) && seekableDuration > 0 ? seekableDuration : 0);
                                        const hasKnownDuration = duration > 0;

                                        const trimStart = hasKnownDuration
                                        ? Math.min(Math.max(0, options.trimStart), Math.max(0, duration - 0.2))
                                        : Math.max(0, options.trimStart);
                                        const clipLength = Math.max(1, options.clipLength);
                                        const clipEnd = hasKnownDuration ? Math.min(duration, trimStart + clipLength) : (trimStart + clipLength);
                                        const targetDuration = Math.max(0.2, clipEnd - trimStart);

                                        const sourceWidth = Math.max(1, processingVideo.videoWidth || 1280);
                                        const sourceHeight = Math.max(1, processingVideo.videoHeight || 720);
                                        const maxEdge = 1280;
                                        const scale = Math.min(1, maxEdge / Math.max(sourceWidth, sourceHeight));
                                        const outputWidth = Math.max(2, Math.floor(sourceWidth * scale));
                                        const outputHeight = Math.max(2, Math.floor(sourceHeight * scale));

                                        const canvas = document.createElement("canvas");
                                        canvas.width = outputWidth;
                                        canvas.height = outputHeight;
                                        const canvasContext = canvas.getContext("2d");
                                        if (!canvasContext) {
                                        URL.revokeObjectURL(sourceUrl);
                                        throw new Error("Unable to initialize video canvas.");
                                        }

                                        await setVideoTime(processingVideo, trimStart);
                                        canvasContext.drawImage(processingVideo, 0, 0, outputWidth, outputHeight);
                                        const thumbnailDataUrl = canvas.toDataURL("image/jpeg", 0.85);

                                        const drawFrame = () => {
                                        canvasContext.drawImage(processingVideo, 0, 0, outputWidth, outputHeight);

                                        if (options.overlayText) {
                                        const fontSize = Math.max(12, options.textSize);
                                        canvasContext.font = `${fontSize}px Arial, sans-serif`;
                                        canvasContext.fillStyle = options.textColor || "#ffffff";
                                        canvasContext.strokeStyle = "rgba(0, 0, 0, 0.6)";
                                        canvasContext.lineWidth = Math.max(2, Math.round(fontSize * 0.1));
                                        const text = options.overlayText;
                                        const metrics = canvasContext.measureText(text);
                                        const textWidth = Math.max(0, metrics.width);
                                        const position = resolveTextPosition(options.textPosition, outputWidth, outputHeight, 24, fontSize, textWidth);
                                        canvasContext.strokeText(text, position.x, position.y);
                                        canvasContext.fillText(text, position.x, position.y);
                                        }
                                        };

                                        const canvasStream = canvas.captureStream(30);

                                        let mixedStream = new MediaStream([...canvasStream.getVideoTracks()]);
                                        let audioContext = null;
                                        try {
                                        audioContext = new (window.AudioContext || window.webkitAudioContext)();
                                        const sourceNode = audioContext.createMediaElementSource(processingVideo);
                                        const destinationNode = audioContext.createMediaStreamDestination();
                                        sourceNode.connect(destinationNode);
                                        destinationNode.stream.getAudioTracks().forEach(track => mixedStream.addTrack(track));
                                        } catch {
                                        audioContext = null;
                                        }

                                        const targetBits = Math.max(350000, Math.min(5000000, Math.floor((MAX_VIDEO_BYTES * 8 * 0.9) / targetDuration)));
                                        const recorder = new MediaRecorder(mixedStream, {
                                        mimeType: getMimeType(),
                                        videoBitsPerSecond: targetBits
                                        });

                                        const chunks = [];
                                        recorder.addEventListener("dataavailable", (event) => {
                                        if (event.data && event.data.size > 0) {
                                        chunks.push(event.data);
                                        }
                                        });

                                        const stoppedPromise = new Promise((resolve) => {
                                        recorder.addEventListener("stop", resolve, { once: true });
                                        });

                                        recorder.start(250);
                                        await setVideoTime(processingVideo, trimStart);
                                        await processingVideo.play();

                                        const captureStart = performance.now();

                                        const stopCapture = () => {
                                        processingVideo.pause();
                                        if (recorder.state !== "inactive") {
                                        recorder.stop();
                                        }
                                        };

                                        const drawLoop = () => {
                                        if (processingVideo.paused || processingVideo.ended) {
                                        if (processingVideo.ended && recorder.state !== "inactive") {
                                        recorder.stop();
                                        }
                                        return;
                                        }

                                        const elapsedSeconds = (performance.now() - captureStart) / 1000;
                                        const reachedClipEnd = hasKnownDuration
                                        ? processingVideo.currentTime >= clipEnd
                                        : elapsedSeconds >= targetDuration;
                                        if (reachedClipEnd) {
                                        stopCapture();
                                        return;
                                        }

                                        drawFrame();
                                        requestAnimationFrame(drawLoop);
                                        };

                                        requestAnimationFrame(drawLoop);
                                        await stoppedPromise;

                                        const outputBlob = new Blob(chunks, { type: "video/webm" });

                                        canvasStream.getTracks().forEach(track => track.stop());
                                        mixedStream.getTracks().forEach(track => track.stop());
                                        processingVideo.pause();
                                        processingVideo.removeAttribute("src");
                                        processingVideo.load();
                                        if (audioContext) {
                                        await audioContext.close();
                                        }
                                        URL.revokeObjectURL(sourceUrl);

                                        return {
                                        blob: outputBlob,
                                        thumbnailDataUrl
                                        };
                                        };

                                        if (hasVideoEditor) {
                                        saveEditedVideoButton.addEventListener("click", async () => {
                                        saveEditedVideoButton.disabled = true;
                                        saveEditedVideoSpinner?.classList.remove("d-none");
                                        try {
                                        let sourceBlob = null;
                                        if (selectedSourceFile) {
                                        sourceBlob = selectedSourceFile;
                                        } else if (selectedSourceUrl) {
                                        const response = await fetch(selectedSourceUrl);
                                        if (!response.ok) {
                                        throw new Error("Could not load selected video.");
                                        }
                                        sourceBlob = await response.blob();
                                        }

                                        if (!sourceBlob) {
                                        throw new Error("Please select a video file first.");
                                        }

                                        const trimStart = Number.parseFloat(videoTrimStartEditor.value || "0");
                                        const clipLength = Number.parseFloat(videoClipLengthEditor.value || "50");
                                        const textSize = Number.parseInt(videoTextSizeEditor.value || "30", 10);

                                        const processed = await exportEditedVideoAsync(sourceBlob, {
                                        trimStart: Number.isFinite(trimStart) ? trimStart : 0,
                                        clipLength: Number.isFinite(clipLength) ? clipLength : 50,
                                        overlayText: (videoTextEditor.value || "").trim(),
                                        textSize: Number.isFinite(textSize) ? textSize : 30,
                                        textColor: videoTextColorEditor.value || "#ffffff",
                                        textPosition: videoTextPositionEditor.value || "bottom-right"
                                        });

                                        if (processed.blob.size > MAX_VIDEO_BYTES) {
                                        throw new Error("Edited video is larger than 50MB. Increase trim start or reduce clip length.");
                                        }

                                        const fileName = `listing-video-${Date.now()}.webm`;
                                        const editedFile = new File([processed.blob], fileName, { type: "video/webm" });
                                        const dataTransfer = new DataTransfer();
                                        dataTransfer.items.add(editedFile);
                                        videoEditedFileInput.files = dataTransfer.files;

                                        videoNameInput.value = (videoNameEditor.value || "").trim();
                                        videoSortOrderInput.value = videoSortOrderEditor.value || "0";
                                        videoThumbnailDataInput.value = processed.thumbnailDataUrl;

                                        videoEditorModal.hide();
                                        videoUpsertForm.submit();
                                        } catch (error) {
                                        const message = error instanceof Error ? error.message : "Could not process video.";
                                        alert(message);
                                        } finally {
                                        saveEditedVideoButton.disabled = false;
                                        saveEditedVideoSpinner?.classList.add("d-none");
                                        }
                                        });
                                        }
                                        })();
                                    </script>
                                    <script>
                                        (() => {
                                        const editBrushSizeInput = document.getElementById("editBrushSizeInput");
                                        const editBrushSizeValue = document.getElementById("editBrushSizeValue");
                                        if (!editBrushSizeInput || !editBrushSizeValue) {
                                        return;
                                        }

                                        const syncBrushSizeValue = () => {
                                        editBrushSizeValue.textContent = editBrushSizeInput.value;
                                        };

                                        editBrushSizeInput.addEventListener("input", syncBrushSizeValue);
                                        syncBrushSizeValue();
                                        })();
                                    </script>
                                }