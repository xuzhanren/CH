                        <div class="card shadow-sm mb-3">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <strong>Similar Items</strong>
                            </div>
                            <div class="card-body">
                                <div id="estateSaleSimilarItemsLoadingState" class="text-muted">Loading similar items...</div>
                                <div id="estateSaleSimilarItemsEmptyState" class="text-muted d-none">No similar items found.</div>
                                <div id="estateSaleSimilarItemsScroller" class="estate-sale-similar-items-scroller d-none">
                                    <div id="estateSaleSimilarItemsTrack" class="estate-sale-similar-items-track"></div>
                                </div>
                            </div>
                        </div>

                        <script>
                            (() => {
                                const waitSeconds = 2;
                                const requestUrl = "@Url.Action("SimilarItems", "EstateSaleDetailPage", new { listingGuid = Model.ListingCard.ListingGUID })";
                                const loadingState = document.getElementById("estateSaleSimilarItemsLoadingState");
                                const emptyState = document.getElementById("estateSaleSimilarItemsEmptyState");
                                const scroller = document.getElementById("estateSaleSimilarItemsScroller");
                                const track = document.getElementById("estateSaleSimilarItemsTrack");

                                if (!loadingState || !emptyState || !scroller || !track) {
                                    return;
                                }

                                const showEmpty = () => {
                                    loadingState.classList.add("d-none");
                                    scroller.classList.add("d-none");
                                    emptyState.classList.remove("d-none");
                                };

                                const renderItems = (items) => {
                                    track.innerHTML = "";

                                    items.forEach((item) => {
                                        const listingGuid = item.listingGUID || item.ListingGUID;
                                        if (!listingGuid) {
                                            return;
                                        }

                                        const subject = item.subject || item.Subject || "Item";
                                        const thumbnailUrl = item.thumbnailURL || item.ThumbnailURL || "";
                                        const detailsUrl = `/EstateSaleDetail/Index?listingGuid=${encodeURIComponent(listingGuid)}`;

                                        const card = document.createElement("div");
                                        card.className = "estate-sale-similar-item";

                                        const link = document.createElement("a");
                                        link.className = "estate-sale-similar-thumb-link";
                                        link.href = detailsUrl;

                                        if (thumbnailUrl) {
                                            const image = document.createElement("img");
                                            image.className = "estate-sale-similar-thumb";
                                            image.src = thumbnailUrl;
                                            image.alt = subject;
                                            link.appendChild(image);
                                        } else {
                                            const placeholder = document.createElement("div");
                                            placeholder.className = "estate-sale-similar-thumb d-flex align-items-center justify-content-center text-muted";
                                            placeholder.textContent = "No image";
                                            link.appendChild(placeholder);
                                        }

                                        const subjectElement = document.createElement("a");
                                        subjectElement.className = "estate-sale-similar-subject text-decoration-none d-block";
                                        subjectElement.href = detailsUrl;
                                        subjectElement.textContent = subject;

                                        card.appendChild(link);
                                        card.appendChild(subjectElement);
                                        track.appendChild(card);
                                    });

                                    if (track.children.length === 0) {
                                        showEmpty();
                                        return;
                                    }

                                    loadingState.classList.add("d-none");
                                    emptyState.classList.add("d-none");
                                    scroller.classList.remove("d-none");
                                };

                                const loadSimilarItems = async () => {
                                    try {
                                        const response = await fetch(requestUrl, { method: "GET" });
                                        if (!response.ok) {
                                            showEmpty();
                                            return;
                                        }

                                        const payload = await response.json();
                                        if (!Array.isArray(payload) || payload.length === 0) {
                                            showEmpty();
                                            return;
                                        }

                                        const items = payload
                                            .filter((item) => item && (item.listingGUID || item.ListingGUID))
                                            .slice(0, 8);

                                        if (items.length === 0) {
                                            showEmpty();
                                            return;
                                        }

                                        renderItems(items);
                                    } catch {
                                        showEmpty();
                                    }
                                };

                                window.addEventListener("load", () => {
                                    window.setTimeout(() => {
                                        loadSimilarItems();
                                    }, Math.max(0, waitSeconds) * 1000);
                                });
                            })();
                        </script>

