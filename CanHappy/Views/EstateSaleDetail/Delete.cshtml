@model CanHappy.Models.EstateSaleDetailEditViewModel

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>
<h3>Are you sure you want to delete this Estate Sale detail?</h3>

<div>
    <h4>Listing</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Subject</dt>
        <dd class="col-sm-9">@Model.Subject</dd>
        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9">@Model.Description</dd>
        <dt class="col-sm-3">Estate Type</dt>
        <dd class="col-sm-9">@Model.EstitateTypeName</dd>
        <dt class="col-sm-3">Annual Management Fee</dt>
        <dd class="col-sm-9">@Model.AnnualManagementFee</dd>
        <dt class="col-sm-3">Bedrooms</dt>
        <dd class="col-sm-9">@Model.Bedrooms</dd>
        <dt class="col-sm-3">Washrooms</dt>
        <dd class="col-sm-9">@Model.Washrooms</dd>
        <dt class="col-sm-3">Baths</dt>
        <dd class="col-sm-9">@Model.Baths</dd>
        <dt class="col-sm-3">Square Feet</dt>
        <dd class="col-sm-9">@Model.SquareFeet</dd>
    </dl>

    <form asp-action="Delete" asp-route-id="@Model.EstateSaleDetailGUID">
        <input type="hidden" asp-for="EstateSaleDetailGUID" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Index" asp-route-listingGuid="@Model.ListingGUID" class="btn btn-outline-secondary">Back to
            List</a>
        </form>
    </div>