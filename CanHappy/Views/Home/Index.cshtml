@{
    ViewData["Title"] = "Home Page";
}

<div class="py-4">
    <div class="p-4 p-md-5 mb-4 rounded-3 bg-body-tertiary border">
        <div class="container-fluid py-2">
            <h1 class="display-6 fw-bold">Welcome to CanHappy</h1>
            <p class="col-md-10 fs-5 mb-0">Find and post listings in Buy & Sell, Car & Vehicle, Home Rental, Estate
                Sale, Car Pool, and Business Yellow Page.</p>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-12 col-md-6 col-lg-4"><a class="btn btn-outline-primary w-100" asp-controller="Category"
                                                         asp-action="Index" asp-route-name="Buy & Sell">Buy & Sell</a></div>
                <div class="col-12 col-md-6 col-lg-4"><a class="btn btn-outline-primary w-100" asp-controller="Category"
                                                             asp-action="Index" asp-route-name="Car & Vehicle">Car & Vehicle</a></div>
                    <div class="col-12 col-md-6 col-lg-4"><a class="btn btn-outline-primary w-100" asp-controller="Category"
                                                                 asp-action="Index" asp-route-name="Home Rental">Home Rental</a></div>
                        <div class="col-12 col-md-6 col-lg-4"><a class="btn btn-outline-primary w-100" asp-controller="Category"
                                                                     asp-action="Index" asp-route-name="Estate Sale">Estate Sale</a></div>
                            <div class="col-12 col-md-6 col-lg-4"><a class="btn btn-outline-primary w-100" asp-controller="Category"
                                                                         asp-action="Index" asp-route-name="Car Pool">Car Pool</a></div>
                                <div class="col-12 col-md-6 col-lg-4"><a class="btn btn-outline-primary w-100" asp-controller="Category"
                                                                             asp-action="Index" asp-route-name="Business Yellow Page">Business Yellow Page</a></div>
                                </div>
                            </div>