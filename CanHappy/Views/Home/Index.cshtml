@{
    ViewData["Title"] = "Home Page";
    var homePageSliderAdWaitSeconds = ViewData["HomePageSliderAdWaitSeconds"] as int? ?? 2;
    var adSlidingInterval = ViewData["AdSlidingInterval"] as int? ?? 5;
    var adSliderFadingMode = ViewData["AdSliderFadingMode"]?.ToString() ?? "fade";
    var homeAdPixelResolveTransitionPeriodMiliSeconds = ViewData["HomeAdPixelResolveTransitionPeriodMiliSeconds"] as int? ??
    1000;
    var homeAdFadeTransitionMilliSeconds = ViewData["HomeAdFadeTransitionMilliSeconds"] as int? ?? 450;
    var slideTransitionMilliSeconds = ViewData["SlideTransitionMilliSeconds"] as int? ?? 650;
    var homeAdSlideDistancePercent = ViewData["HomeAdSlideDistancePercent"] as int? ?? 8;
    var homeAdTransitionEasing = ViewData["HomeAdTransitionEasing"]?.ToString() ?? "ease-in-out";
}

<div class="py-1">
    <div id="HomePageTopWelcomeDiv" class="p-2 p-md-5 mb-2 rounded-3">
        <div class="container-fluid p-2 ">
            <h1 class="display-6 fw-bold">Welcome to CanHappy</h1>
            <p class="col-md-12 fs-5 mb-0">Find and post listings in Buy & Sell, Car & Vehicle, Home Rental, Estate
                Sale, Car Pool, and Business Yellow Page. We aim to build a trustworthy online place that supports daily
                life in Canada by making information and connections easier to access.</p>
                <p class="col-md-12 fs-10 mb-0"
                       style="color: rgb(241, 54, 85);font-family: 'Brush Script MT', 'Segoe Script', 'Lucida Handwriting', cursive; font-weight: 700; font-size: 3.0rem;">
                    Wish you Happy living In Canada!</p>
                </div>
            </div>

            <div id="homePageSliderWrapper" class="home-page-slider-wrapper d-none" aria-label="Home page promotions">
                <a id="homePageSliderLink" href="#" target="_blank" rel="noopener noreferrer" class="home-page-slider-link">
                    <img id="homePageSliderImage" class="home-page-slider-image" src="" alt="Home page ad" />
                </a>
            </div>
        </div>

        @section Scripts {
            <script>
                                    (() => {
                                        const waitSeconds = @homePageSliderAdWaitSeconds;
                                        const slidingIntervalSeconds = @adSlidingInterval;
                                        const fadingMode = "@adSliderFadingMode".trim().toLowerCase();
                                        const pixelResolveTransitionMs = @homeAdPixelResolveTransitionPeriodMiliSeconds;
                                        const fadeTransitionMs = @homeAdFadeTransitionMilliSeconds;
                                        const slideTransitionMs = @slideTransitionMilliSeconds;
                                        const slideDistancePercent = @homeAdSlideDistancePercent;
                                        const transitionEasing = "@homeAdTransitionEasing".trim() || "ease-in-out";
                                        const sliderWrapper = document.getElementById("homePageSliderWrapper");
                                        const sliderLink = document.getElementById("homePageSliderLink");
                                        const sliderImage = document.getElementById("homePageSliderImage");
                                        const provinceSelect = document.getElementById("topNavProvinceSelect");
                                        const citySelect = document.getElementById("topNavCitySelect");

                                        if (!sliderWrapper || !sliderLink || !sliderImage) {
                                            return;
                                        }

                                        let adItems = [];
                                        let activeIndex = 0;
                                        let isTransitioning = false;
                                        let queuedIndex = null;

                                        const normalizeFadingMode = (mode) => {
                                            if (mode === "fade" || mode === "homeadfade") {
                                                return "homeadfade";
                                            }

                                            if (mode === "pixelresolve" || mode === "homeadpixelresolve") {
                                                return "homeadpixelresolve";
                                            }

                                            if (mode === "homeadslidedown" || mode === "homeadslideup" || mode === "homeadslideleft" || mode === "homeadslideright") {
                                                return mode;
                                            }

                                            return "homeadfade";
                                        };

                                        const normalizedFadingMode = normalizeFadingMode(fadingMode);

                                        const getTransitionDuration = () => {
                                            if (normalizedFadingMode === "homeadpixelresolve") {
                                                return Math.max(100, pixelResolveTransitionMs);
                                            }

                                            if (normalizedFadingMode === "homeadfade") {
                                                return Math.max(100, fadeTransitionMs);
                                            }

                                            return Math.max(100, slideTransitionMs);
                                        };

                                        const getOutKeyframes = () => {
                                            switch (normalizedFadingMode) {
                                                case "homeadpixelresolve":
                                                    return [
                                                        { opacity: 1, filter: "blur(0) saturate(1)", transform: "translate3d(0,0,0) scale(1)" },
                                                        { opacity: 0, filter: "blur(8px) saturate(0.8)", transform: "translate3d(0,0,0) scale(1.015)" }
                                                    ];
                                                case "homeadslideleft":
                                                    return [
                                                        { opacity: 1, transform: "translate3d(0,0,0)" },
                                                        { opacity: 0, transform: `translate3d(-${slideDistancePercent}%,0,0)` }
                                                    ];
                                                case "homeadslideright":
                                                    return [
                                                        { opacity: 1, transform: "translate3d(0,0,0)" },
                                                        { opacity: 0, transform: `translate3d(${slideDistancePercent}%,0,0)` }
                                                    ];
                                                case "homeadslideup":
                                                    return [
                                                        { opacity: 1, transform: "translate3d(0,0,0)" },
                                                        { opacity: 0, transform: `translate3d(0,-${slideDistancePercent}%,0)` }
                                                    ];
                                                case "homeadslidedown":
                                                    return [
                                                        { opacity: 1, transform: "translate3d(0,0,0)" },
                                                        { opacity: 0, transform: `translate3d(0,${slideDistancePercent}%,0)` }
                                                    ];
                                                default:
                                                    return [
                                                        { opacity: 1, transform: "translate3d(0,0,0)", filter: "none" },
                                                        { opacity: 0, transform: "translate3d(0,0,0)", filter: "none" }
                                                    ];
                                            }
                                        };

                                        const getInKeyframes = () => {
                                            switch (normalizedFadingMode) {
                                                case "homeadpixelresolve":
                                                    return [
                                                        { opacity: 0, filter: "blur(8px) saturate(0.8)", transform: "translate3d(0,0,0) scale(1.015)" },
                                                        { opacity: 1, filter: "blur(0) saturate(1)", transform: "translate3d(0,0,0) scale(1)" }
                                                    ];
                                                case "homeadslideleft":
                                                    return [
                                                        { opacity: 0, transform: `translate3d(${slideDistancePercent}%,0,0)` },
                                                        { opacity: 1, transform: "translate3d(0,0,0)" }
                                                    ];
                                                case "homeadslideright":
                                                    return [
                                                        { opacity: 0, transform: `translate3d(-${slideDistancePercent}%,0,0)` },
                                                        { opacity: 1, transform: "translate3d(0,0,0)" }
                                                    ];
                                                case "homeadslideup":
                                                    return [
                                                        { opacity: 0, transform: `translate3d(0,${slideDistancePercent}%,0)` },
                                                        { opacity: 1, transform: "translate3d(0,0,0)" }
                                                    ];
                                                case "homeadslidedown":
                                                    return [
                                                        { opacity: 0, transform: `translate3d(0,-${slideDistancePercent}%,0)` },
                                                        { opacity: 1, transform: "translate3d(0,0,0)" }
                                                    ];
                                                default:
                                                    return [
                                                        { opacity: 0, transform: "translate3d(0,0,0)", filter: "none" },
                                                        { opacity: 1, transform: "translate3d(0,0,0)", filter: "none" }
                                                    ];
                                            }
                                        };

                                        const applyAdSource = (ad) => {
                                            sliderLink.href = ad.targetURL || "#";
                                            sliderImage.src = ad.imageURL || "";
                                            sliderImage.alt = ad.subject || "Home page ad";
                                        };

                                        const resetImageStyles = () => {
                                            sliderImage.style.opacity = "1";
                                            sliderImage.style.transform = "translate3d(0,0,0)";
                                            sliderImage.style.filter = "none";
                                        };

                                        const transitionToAd = async (ad) => {
                                            const durationMs = getTransitionDuration();

                                            if (!sliderImage.getAttribute("src")) {
                                                applyAdSource(ad);
                                                resetImageStyles();
                                                return;
                                            }

                                            try {
                                                await sliderImage.animate(getOutKeyframes(), {
                                                    duration: durationMs,
                                                    easing: transitionEasing,
                                                    fill: "forwards"
                                                }).finished;
                                            } catch {
                                            }

                                            applyAdSource(ad);

                                            try {
                                                await sliderImage.animate(getInKeyframes(), {
                                                    duration: durationMs,
                                                    easing: transitionEasing,
                                                    fill: "forwards"
                                                }).finished;
                                            } catch {
                                            }

                                            resetImageStyles();
                                        };

                                        const showAdAt = async (index) => {
                                            if (!Array.isArray(adItems) || adItems.length === 0) {
                                                return;
                                            }

                                            const normalizedIndex = ((index % adItems.length) + adItems.length) % adItems.length;
                                            const ad = adItems[normalizedIndex];
                                            if (!ad) {
                                                return;
                                            }

                                            if (isTransitioning) {
                                                queuedIndex = normalizedIndex;
                                                return;
                                            }

                                            isTransitioning = true;
                                            activeIndex = normalizedIndex;

                                            await transitionToAd(ad);

                                            isTransitioning = false;

                                            if (queuedIndex !== null && queuedIndex !== activeIndex) {
                                                const nextIndex = queuedIndex;
                                                queuedIndex = null;
                                                await showAdAt(nextIndex);
                                            } else {
                                                queuedIndex = null;
                                            }

                                            clearFadingClasses();
                                            sliderImage.classList.add(fadingMode === "pixelresolve" ? "home-page-slider-pixel-out" : "home-page-slider-fade-out");

                                            window.setTimeout(() => {
                                                sliderLink.href = ad.targetURL || "#";
                                                sliderImage.src = ad.imageURL || "";
                                                sliderImage.alt = ad.subject || "Home page ad";
                                                clearFadingClasses();
                                                sliderImage.classList.add(fadingMode === "pixelresolve" ? "home-page-slider-pixel-in" : "home-page-slider-fade-in");
                                                window.setTimeout(() => clearFadingClasses(), 560);
                                            }, 240);
                                        };

                                        const startSlider = () => {
                                            if (adItems.length === 0) {
                                                return;
                                            }

                                            showAdAt(activeIndex);
                                            sliderWrapper.classList.remove("d-none");

                                            if (adItems.length > 1) {
                                                window.setInterval(() => {
                                                    showAdAt(activeIndex + 1);
                                                }, Math.max(1, slidingIntervalSeconds) * 1000);
                                            }
                                        };

                                        const loadHomeSliderAdsAsync = async () => {
                                            const provinceValue = provinceSelect ? String(provinceSelect.value || "") : "";
                                            const cityValue = citySelect ? String(citySelect.value || "") : "";

                                            const requestUrl = new URL("@Url.Action("HomePageSliderAds", "Home")", window.location.origin);
                                            if (provinceValue && cityValue) {
                                                requestUrl.searchParams.set("provinceId", provinceValue);
                                                requestUrl.searchParams.set("cityId", cityValue);
                                            }

                                            try {
                                                const response = await fetch(requestUrl.toString(), { method: "GET" });
                                                if (!response.ok) {
                                                    return;
                                                }

                                                const payload = await response.json();
                                                if (!Array.isArray(payload) || payload.length === 0) {
                                                    return;
                                                }

                                                adItems = payload.filter((item) => item && item.imageURL && item.targetURL).slice(0, 3);
                                                if (adItems.length === 0) {
                                                    return;
                                                }

                                                startSlider();
                                            } catch {
                                            }
                                        };

                                        window.addEventListener("load", () => {
                                            window.setTimeout(() => {
                                                loadHomeSliderAdsAsync();
                                            }, Math.max(0, waitSeconds) * 1000);
                                        });
                                    })();
            </script>
        }

        <style>
            .home-page-slider-wrapper {
                width: 100%;
                margin-top: 0.75rem;
                overflow: hidden;
                background-color: var(--bs-body-bg);
                border: 1px solid var(--bs-border-color);
                border-radius: 0;
            }

            .home-page-slider-link {
                display: block;
                width: 100%;
            }

            .home-page-slider-image {
                width: 100%;
                height: auto;
                display: block;
                object-fit: cover;
                opacity: 1;
                will-change: opacity, transform, filter;
            }
        </style>