@model CanHappy.Models.ListingReview

@{
    ViewData["Title"] = "Create Review";
    var hasListingContext = Model.ListingGUID != Guid.Empty;
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.css" />

<h1>Create Review</h1>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    @if (hasListingContext)
    {
        <input type="hidden" asp-for="ListingGUID" />
    }
    else
    {
        <div class="mb-3">
            <label asp-for="ListingGUID" class="form-label"></label>
            <select asp-for="ListingGUID" class="form-select" asp-items="ViewBag.ListingGUID">
                <option value="">Select Listing</option>
            </select>
            <span asp-validation-for="ListingGUID" class="text-danger"></span>
        </div>
    }

    <div class="row g-2 mb-3">
        <div class="col-md-4">
            <label asp-for="Rating" class="form-label"></label>
            <input asp-for="Rating" class="form-control" type="number" min="0" max="5" step="0.1" />
            <span asp-validation-for="Rating" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Status" class="form-label"></label>
            <input asp-for="Status" class="form-control" readonly />
            <span asp-validation-for="Status" class="text-danger"></span>
        </div>
        <div class="col-md-4 d-flex align-items-end">
            <div class="form-check mb-2">
                <input asp-for="VerifiedPurchaseInd" class="form-check-input" />
                <label asp-for="VerifiedPurchaseInd" class="form-check-label"></label>
            </div>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="ReviewTitle" class="form-label"></label>
        <input asp-for="ReviewTitle" class="form-control" />
        <span asp-validation-for="ReviewTitle" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ReviewMessage" class="form-label"></label>
        <textarea asp-for="ReviewMessage" class="form-control" rows="4"></textarea>
        <span asp-validation-for="ReviewMessage" class="text-danger"></span>
    </div>

    <input type="hidden" id="reviewPhotosJson" name="reviewPhotosJson" />

    <div class="mb-2 d-flex align-items-center gap-2">
        <label class="form-label mb-0">Review Photos (up to 4)</label>
        <button type="button" id="addReviewPhotoButton" class="btn btn-sm btn-outline-primary">Add Photo</button>
    </div>
    <div id="reviewPhotoPreviewList" class="d-flex flex-wrap gap-2 mb-3"></div>
    <input type="file" id="reviewPhotoFileInput" class="d-none" accept="image/*" />

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Create</button>
        <a asp-action="Index" asp-route-listingGuid="@(hasListingContext ? Model.ListingGUID : (Guid?)null)"
           class="btn btn-outline-secondary">Back to List</a>
    </div>
</form>

<partial name="~/Views/ListingReview/_PhotoEditorModal.cshtml" />

    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
        <script src="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.js"></script>
        <script src="~/js/listingReviewPhotoEditor.js" asp-append-version="true"></script>
        <script>
            (() => {
                window.initListingReviewPhotoEditor?.({
                    addButtonId: "addReviewPhotoButton",
                    fileInputId: "reviewPhotoFileInput",
                    previewListId: "reviewPhotoPreviewList",
                    photosJsonInputId: "reviewPhotosJson"
                });
            })();
        </script>
    }