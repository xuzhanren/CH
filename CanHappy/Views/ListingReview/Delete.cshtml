@model CanHappy.Models.ListingReview

@{
    ViewData["Title"] = "Delete Review";
}

<h1>Delete Review</h1>
<div class="alert alert-warning">Are you sure you want to delete this review?</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <div><strong>Title:</strong> @Model.ReviewTitle</div>
        <div><strong>Rating:</strong> @Model.Rating.ToString("0.0")</div>
        <div><strong>Status:</strong> @Model.Status</div>
        <div><strong>Message:</strong> @Model.ReviewMessage</div>
    </div>
</div>

<form asp-action="Delete" asp-route-id="@Model.ListingReviewGUID" method="post">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" asp-route-listingGuid="@Model.ListingGUID" class="btn btn-outline-secondary">Cancel</a>
</form>