@model CanHappy.Models.Listing
@using System.Text.Json

@{
    ViewData["Title"] = "Edit";
    var subcategoryLookup = ViewData["SubcategoryLookup"];
    var cityLookup = ViewData["CityLookup"];
    var hasThumbnail = !string.IsNullOrWhiteSpace(Model?.ThumbnailURL);
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.css" />

<h1>Edit</h1>

<div class="card shadow-sm">
    <div class="card-body">
        <h4 class="card-title">Listing</h4>
        <hr />
        <form asp-action="Edit" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="ListingGUID" />
            <div class="mb-3">
                <label asp-for="Subject" class="form-label"></label>
                <input asp-for="Subject" class="form-control" />
                <span asp-validation-for="Subject" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="KeyWords" class="form-label"></label>
                <input asp-for="KeyWords" class="form-control" />
                <span asp-validation-for="KeyWords" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="PostalCode" class="form-label"></label>
                <input asp-for="PostalCode" class="form-control" />
                <span asp-validation-for="PostalCode" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Price" class="form-label"></label>
                <input asp-for="Price" class="form-control" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DiscountPercent" class="form-label"></label>
                <input asp-for="DiscountPercent" class="form-control" />
                <span asp-validation-for="DiscountPercent" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label class="form-label">Thumbnail Image</label>
                <input type="file" id="thumbnailFileInput" class="form-control" accept="image/*" />
                <div class="mt-2 d-flex gap-2">
                    <button type="button" id="openCropModalButton" class="btn btn-outline-primary" disabled>Clip
                        Image</button>
                        <button type="button" id="clearThumbnailButton" class="btn btn-outline-secondary">Clear
                            Image</button>
                        </div>
                    </div>
                    <div id="thumbnailPreviewContainer" class="mb-3 @(hasThumbnail ? string.Empty : "d-none")">
                        <label class="form-label">Thumbnail Preview</label>
                        <div>
                            <img id="thumbnailPreview" src="@Model?.ThumbnailURL" alt="Listing thumbnail"
                                 class="img-fluid rounded border" style="max-height: 220px;" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="CategoryId" class="form-label"></label>
                        <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId">
                            <option value="">Select Category</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="SubcategoryId" class="form-label"></label>
                        <select asp-for="SubcategoryId" class="form-select" asp-items="ViewBag.SubcategoryId">
                            <option value="">Select Subcategory</option>
                        </select>
                        <span asp-validation-for="SubcategoryId" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ProvinceId" class="form-label"></label>
                        <select asp-for="ProvinceId" class="form-select" asp-items="ViewBag.ProvinceId">
                            <option value="">Select Province</option>
                        </select>
                        <span asp-validation-for="ProvinceId" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="CityId" class="form-label"></label>
                        <select asp-for="CityId" class="form-select" asp-items="ViewBag.CityId">
                            <option value="">Select City</option>
                        </select>
                        <span asp-validation-for="CityId" class="text-danger"></span>
                    </div>
                    <input type="hidden" asp-for="ViewCount" />
                    <input type="hidden" asp-for="ClickCount" />
                    <input type="hidden" asp-for="DeletedInd" />
                    <input type="hidden" asp-for="SampleInd" />
                    <input type="hidden" asp-for="UserId" />
                    <input type="hidden" asp-for="CreatedBy" />
                    <input type="hidden" asp-for="ModifiedBY" />
                    <input type="hidden" asp-for="CreatedDate" />
                    <input type="hidden" asp-for="ModifiedDate" />
                    <input type="hidden" asp-for="ThumbnailURL" />
                    <input type="hidden" id="CroppedThumbnailData" name="croppedThumbnailData" />

                    <div class="d-flex gap-2">
                        <input type="submit" value="Save" class="btn btn-primary" />
                        <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
                    </div>
                </form>
            </div>
        </div>

        <div class="modal fade" id="thumbnailCropModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header py-2 px-3">
                        <h5 class="modal-title">Clip Thumbnail Image</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body pt-2 pb-2 px-3">
                        <div class="row g-3 align-items-stretch">
                            <div class="col-9">
                                <div class="position-relative border rounded overflow-hidden bg-light" style="min-height: 420px;">
                                    <img id="cropperImage" alt="Image to crop" class="img-fluid w-100" />
                                    <canvas id="editCanvas" class="w-100 d-none" style="touch-action: none; cursor: crosshair;"></canvas>
                                </div>
                            </div>
                            <div class="col-3 d-flex flex-column ps-3">
                                <div>
                                    <label for="cropAspectRatioSelect" class="form-label mb-1">Aspect Ratio</label>
                                    <select id="cropAspectRatioSelect" class="form-select">
                                        <option value="1:1" selected>1:1</option>
                                        <option value="3:2">3:2</option>
                                        <option value="4:3">4:3</option>
                                        <option value="16:9">16:9</option>
                                        <option value="9:16">9:16</option>
                                    </select>
                                </div>
                                <div class="mt-3">
                                    <label class="form-label mb-1">Edit Tools</label>
                                    <div class="d-grid gap-2">
                                        <button type="button" id="editCropModeButton" class="btn btn-sm btn-primary">Crop Mode</button>
                                        <button type="button" id="editPenModeButton" class="btn btn-sm btn-outline-secondary">Free Draw Pen</button>
                                        <button type="button" id="editEraseModeButton" class="btn btn-sm btn-outline-secondary">Erase</button>
                                        <button type="button" id="editTextModeButton" class="btn btn-sm btn-outline-secondary">Type Text</button>
                                    </div>
                                </div>
                                <div class="mt-3">
                                    <label for="editBrushSizeInput" class="form-label mb-1">Brush Size</label>
                                    <input id="editBrushSizeInput" type="range" class="form-range" min="2" max="60" value="12" />
                                </div>
                                <div class="mt-2">
                                    <label for="editColorInput" class="form-label mb-1">Pen/Text Color</label>
                                    <input id="editColorInput" type="color" class="form-control form-control-color" value="#ff0000" />
                                </div>
                                <div class="mt-2 d-grid">
                                    <button type="button" id="applyEditsButton" class="btn btn-sm btn-outline-primary">Apply Edits to Crop</button>
                                </div>
                                <div class="mt-2 d-grid gap-2">
                                    <button type="button" id="undoEditButton" class="btn btn-sm btn-outline-secondary">Undo</button>
                                    <button type="button" id="redoEditButton" class="btn btn-sm btn-outline-secondary">Redo</button>
                                </div>
                                <div class="mt-auto d-grid gap-2 pt-3">
                                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                    <button type="button" id="saveCroppedImageButton" class="btn btn-primary">Save Clipped Image</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @section Scripts {
            @{
                await Html.RenderPartialAsync("_ValidationScriptsPartial");
            }
            <script src="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.js"></script>
            <script>
                (() => {
                const subcategories = @Html.Raw(JsonSerializer.Serialize(subcategoryLookup));
                const cities = @Html.Raw(JsonSerializer.Serialize(cityLookup));

                const categorySelect = document.getElementById("CategoryId");
                const subcategorySelect = document.getElementById("SubcategoryId");
                const provinceSelect = document.getElementById("ProvinceId");
                const citySelect = document.getElementById("CityId");

                const selectedSubcategoryId = Number(subcategorySelect.value || 0);
                const selectedCityId = Number(citySelect.value || 0);

                const populate = (target, items, placeholder, valueKey = "id") => {
                target.innerHTML = "";

                const placeholderOption = document.createElement("option");
                placeholderOption.value = "";
                placeholderOption.textContent = placeholder;
                target.appendChild(placeholderOption);

                items.forEach(item => {
                const option = document.createElement("option");
                option.value = item[valueKey];
                option.textContent = item.name;
                target.appendChild(option);
                });
                };

                const refreshSubcategories = (selectedId = 0) => {
                const categoryId = Number(categorySelect.value || 0);
                const filtered = categoryId > 0
                ? subcategories.filter(item => item.categoryId === categoryId)
                : [];

                populate(subcategorySelect, filtered, "Select Subcategory");

                if (selectedId > 0 && filtered.some(item => item.id === selectedId)) {
                subcategorySelect.value = String(selectedId);
                }
                };

                const refreshCities = (selectedId = 0) => {
                const provinceId = Number(provinceSelect.value || 0);
                const filtered = provinceId > 0
                ? cities.filter(item => item.provinceId === provinceId)
                : [];

                populate(citySelect, filtered, "Select City");

                if (selectedId > 0 && filtered.some(item => item.id === selectedId)) {
                citySelect.value = String(selectedId);
                }
                };

                categorySelect.addEventListener("change", () => refreshSubcategories());
                provinceSelect.addEventListener("change", () => refreshCities());

                refreshSubcategories(selectedSubcategoryId);
                refreshCities(selectedCityId);

                const thumbnailFileInput = document.getElementById("thumbnailFileInput");
                const openCropModalButton = document.getElementById("openCropModalButton");
                const clearThumbnailButton = document.getElementById("clearThumbnailButton");
                const thumbnailPreviewContainer = document.getElementById("thumbnailPreviewContainer");
                const thumbnailPreview = document.getElementById("thumbnailPreview");
                const thumbnailUrlInput = document.getElementById("ThumbnailURL");
                const croppedThumbnailDataInput = document.getElementById("CroppedThumbnailData");

                const cropModalElement = document.getElementById("thumbnailCropModal");
                const cropperImage = document.getElementById("cropperImage");
                const editCanvas = document.getElementById("editCanvas");
                const editContext = editCanvas.getContext("2d");
                const cropAspectRatioSelect = document.getElementById("cropAspectRatioSelect");
                const editCropModeButton = document.getElementById("editCropModeButton");
                const editPenModeButton = document.getElementById("editPenModeButton");
                const editEraseModeButton = document.getElementById("editEraseModeButton");
                const editTextModeButton = document.getElementById("editTextModeButton");
                const editBrushSizeInput = document.getElementById("editBrushSizeInput");
                const editColorInput = document.getElementById("editColorInput");
                const applyEditsButton = document.getElementById("applyEditsButton");
                const undoEditButton = document.getElementById("undoEditButton");
                const redoEditButton = document.getElementById("redoEditButton");
                const saveCroppedImageButton = document.getElementById("saveCroppedImageButton");
                const cropModal = new bootstrap.Modal(cropModalElement);

                let sourceImageDataUrl = "";
                let workingImageDataUrl = "";
                let cropper = null;
                let currentAspectRatio = 1;
                let activeEditTool = "crop";
                let isDrawing = false;
                let lastPoint = null;
                let editHistory = [];
                let redoHistory = [];

                const getAspectRatio = (value) => {
                const parts = (value || "").split(":");
                if (parts.length !== 2) {
                return 1;
                }

                const width = Number(parts[0]);
                const height = Number(parts[1]);
                if (!Number.isFinite(width) || !Number.isFinite(height) || width <= 0 || height <= 0) {
                return 1;
                }

                return width / height;
                };

                const getCanvasSize = (aspectRatio) => {
                if (Math.abs(aspectRatio - (16 / 9)) < 0.001) {
                return { width: 1280, height: 720 };
                }

                const base = 800;
                if (aspectRatio >= 1) {
                return {
                width: base,
                height: Math.round(base / aspectRatio)
                };
                }

                return {
                width: Math.round(base * aspectRatio),
                height: base
                };
                };

                const createCropper = () => {
                cropper?.destroy();
                cropper = new Cropper(cropperImage, {
                aspectRatio: currentAspectRatio,
                viewMode: 1,
                autoCropArea: 1,
                dragMode: "move"
                });
                };

                const setToolButtonStyles = () => {
                const entries = [
                [editCropModeButton, "crop"],
                [editPenModeButton, "pen"],
                [editEraseModeButton, "erase"],
                [editTextModeButton, "text"]
                ];

                entries.forEach(([button, mode]) => {
                const isActive = activeEditTool === mode;
                button.classList.toggle("btn-primary", isActive);
                button.classList.toggle("btn-outline-secondary", !isActive);
                });
                };

                const getCanvasPoint = (event) => {
                const rect = editCanvas.getBoundingClientRect();
                const scaleX = editCanvas.width / rect.width;
                const scaleY = editCanvas.height / rect.height;
                return {
                x: (event.clientX - rect.left) * scaleX,
                y: (event.clientY - rect.top) * scaleY
                };
                };

                const drawStroke = (fromPoint, toPoint) => {
                editContext.lineCap = "round";
                editContext.lineJoin = "round";
                editContext.lineWidth = Number(editBrushSizeInput.value || 12);
                editContext.globalCompositeOperation = activeEditTool === "erase" ? "destination-out" : "source-over";
                editContext.strokeStyle = editColorInput.value || "#ff0000";
                editContext.beginPath();
                editContext.moveTo(fromPoint.x, fromPoint.y);
                editContext.lineTo(toPoint.x, toPoint.y);
                editContext.stroke();
                editContext.globalCompositeOperation = "source-over";
                };

                const loadImageToCanvas = (imageDataUrl, onLoaded = null) => {
                if (!imageDataUrl) {
                return;
                }

                const image = new Image();
                image.onload = () => {
                editCanvas.width = image.naturalWidth;
                editCanvas.height = image.naturalHeight;
                editContext.clearRect(0, 0, editCanvas.width, editCanvas.height);
                editContext.drawImage(image, 0, 0, editCanvas.width, editCanvas.height);
                if (typeof onLoaded === "function") {
                onLoaded();
                }
                };
                image.src = imageDataUrl;
                };

                const pushCanvasHistory = () => {
                if (!editCanvas.width || !editCanvas.height) {
                return;
                }

                const snapshot = editCanvas.toDataURL("image/png");
                if (editHistory.length > 0 && editHistory[editHistory.length - 1] === snapshot) {
                return;
                }

                editHistory.push(snapshot);
                if (editHistory.length > 30) {
                editHistory.shift();
                }
                };

                const registerNewEdit = () => {
                pushCanvasHistory();
                redoHistory = [];
                };

                const undoCanvasEdit = () => {
                if (editHistory.length <= 1) {
                return;
                }

                redoHistory.push(editHistory[editHistory.length - 1]);
                editHistory.pop();
                const previousSnapshot = editHistory[editHistory.length - 1];
                loadImageToCanvas(previousSnapshot);
                };

                const redoCanvasEdit = () => {
                if (redoHistory.length === 0) {
                return;
                }

                const nextSnapshot = redoHistory.pop();
                if (!nextSnapshot) {
                return;
                }

                editHistory.push(nextSnapshot);
                loadImageToCanvas(nextSnapshot);
                };

                const showCropperImage = () => {
                editCanvas.classList.add("d-none");
                cropperImage.classList.remove("d-none");
                cropperImage.src = workingImageDataUrl || sourceImageDataUrl;

                if (cropperImage.complete) {
                createCropper();
                } else {
                cropperImage.addEventListener("load", () => createCropper(), { once: true });
                }
                };

                const applyCanvasEdits = () => {
                if (editCanvas.classList.contains("d-none")) {
                return;
                }

                workingImageDataUrl = editCanvas.toDataURL("image/png");
                sourceImageDataUrl = workingImageDataUrl;
                };

                const switchToTool = (tool) => {
                activeEditTool = tool;
                setToolButtonStyles();

                if (tool === "crop") {
                applyCanvasEdits();
                showCropperImage();
                return;
                }

                cropper?.destroy();
                cropper = null;

                cropperImage.classList.add("d-none");
                editCanvas.classList.remove("d-none");
                if (!editCanvas.width || !editCanvas.height) {
                loadImageToCanvas(workingImageDataUrl || sourceImageDataUrl, () => {
                editHistory = [];
                redoHistory = [];
                pushCanvasHistory();
                });
                }
                };

                thumbnailFileInput.addEventListener("change", () => {
                const file = thumbnailFileInput.files?.[0];
                if (!file) {
                sourceImageDataUrl = "";
                workingImageDataUrl = "";
                openCropModalButton.disabled = true;
                return;
                }

                const reader = new FileReader();
                reader.onload = (event) => {
                sourceImageDataUrl = event.target?.result?.toString() || "";
                workingImageDataUrl = sourceImageDataUrl;
                openCropModalButton.disabled = !sourceImageDataUrl;
                if (sourceImageDataUrl) {
                activeEditTool = "crop";
                setToolButtonStyles();
                editHistory = [];
                redoHistory = [];
                editCanvas.width = 0;
                editCanvas.height = 0;
                cropperImage.src = sourceImageDataUrl;
                cropModal.show();
                }
                };
                reader.readAsDataURL(file);
                });

                if (thumbnailPreview?.src) {
                sourceImageDataUrl = thumbnailPreview.src;
                workingImageDataUrl = sourceImageDataUrl;
                openCropModalButton.disabled = false;
                }

                openCropModalButton.addEventListener("click", () => {
                if (!sourceImageDataUrl) {
                return;
                }

                activeEditTool = "crop";
                setToolButtonStyles();
                cropperImage.src = workingImageDataUrl || sourceImageDataUrl;
                cropModal.show();
                });

                cropModalElement.addEventListener("shown.bs.modal", () => {
                if (!cropperImage.src) {
                return;
                }

                if (activeEditTool === "crop") {
                createCropper();
                }
                });

                cropModalElement.addEventListener("hidden.bs.modal", () => {
                cropper?.destroy();
                cropper = null;
                });

                cropAspectRatioSelect.addEventListener("change", () => {
                currentAspectRatio = getAspectRatio(cropAspectRatioSelect.value);
                if (cropper) {
                cropper.setAspectRatio(currentAspectRatio);
                }
                });

                editCropModeButton.addEventListener("click", () => switchToTool("crop"));
                editPenModeButton.addEventListener("click", () => switchToTool("pen"));
                editEraseModeButton.addEventListener("click", () => switchToTool("erase"));
                editTextModeButton.addEventListener("click", () => switchToTool("text"));
                applyEditsButton.addEventListener("click", () => switchToTool("crop"));
                undoEditButton.addEventListener("click", () => undoCanvasEdit());
                redoEditButton.addEventListener("click", () => redoCanvasEdit());

                editCanvas.addEventListener("pointerdown", (event) => {
                if (activeEditTool === "text") {
                const textValue = prompt("Enter text to add:");
                if (!textValue) {
                return;
                }

                const point = getCanvasPoint(event);
                editContext.globalCompositeOperation = "source-over";
                editContext.fillStyle = editColorInput.value || "#ff0000";
                editContext.font = `${Math.max(14, Number(editBrushSizeInput.value || 12) * 2)}px sans-serif`;
                editContext.fillText(textValue, point.x, point.y);
                registerNewEdit();
                return;
                }

                if (activeEditTool !== "pen" && activeEditTool !== "erase") {
                return;
                }

                isDrawing = true;
                lastPoint = getCanvasPoint(event);
                editCanvas.setPointerCapture(event.pointerId);
                });

                editCanvas.addEventListener("pointermove", (event) => {
                if (!isDrawing || !lastPoint) {
                return;
                }

                const nextPoint = getCanvasPoint(event);
                drawStroke(lastPoint, nextPoint);
                lastPoint = nextPoint;
                });

                const stopDrawing = (event) => {
                if (isDrawing) {
                isDrawing = false;
                lastPoint = null;
                registerNewEdit();
                if (typeof event.pointerId !== "undefined") {
                editCanvas.releasePointerCapture(event.pointerId);
                }
                }
                };

                editCanvas.addEventListener("pointerup", stopDrawing);
                editCanvas.addEventListener("pointerleave", stopDrawing);
                editCanvas.addEventListener("pointercancel", stopDrawing);

                saveCroppedImageButton.addEventListener("click", () => {
                if (activeEditTool !== "crop") {
                switchToTool("crop");
                }

                if (!cropper) {
                return;
                }

                const canvasSize = getCanvasSize(currentAspectRatio);
                const canvas = cropper.getCroppedCanvas({
                width: canvasSize.width,
                height: canvasSize.height,
                imageSmoothingQuality: "high"
                });

                const croppedDataUrl = canvas.toDataURL("image/jpeg", 0.9);
                croppedThumbnailDataInput.value = croppedDataUrl;
                thumbnailUrlInput.value = "";
                thumbnailPreview.src = croppedDataUrl;
                thumbnailPreviewContainer.classList.remove("d-none");
                cropModal.hide();
                });

                clearThumbnailButton.addEventListener("click", () => {
                thumbnailFileInput.value = "";
                sourceImageDataUrl = "";
                workingImageDataUrl = "";
                activeEditTool = "crop";
                editHistory = [];
                redoHistory = [];
                setToolButtonStyles();
                openCropModalButton.disabled = true;
                croppedThumbnailDataInput.value = "";
                thumbnailUrlInput.value = "";
                thumbnailPreview.src = "";
                thumbnailPreviewContainer.classList.add("d-none");
                });

                setToolButtonStyles();
                })();
            </script>
        }