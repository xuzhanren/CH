@model IReadOnlyList<CanHappy.Models.ListingMapMarkerViewModel>
@using System.Text.Json

@{
    ViewData["Title"] = "Listings Map";
    var currentCategoryName = ViewData["CategoryName"]?.ToString();
    var currentSubcategoryName = ViewData["SubcategoryName"]?.ToString();
    var markerPayload = Model
        .Where(item => !string.IsNullOrWhiteSpace(item.PostalCode) && !string.IsNullOrWhiteSpace(item.DetailUrl))
        .Select(item => new
        {
            id = item.ListingGUID,
            subject = item.Subject,
            postalCode = item.PostalCode,
            price = item.Price,
            detailUrl = item.DetailUrl
        })
        .ToList();

    var serializedMarkers = JsonSerializer.Serialize(markerPayload);
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Listings Map</h1>
    <a asp-action="Index" asp-route-categoryName="@currentCategoryName" asp-route-subcategoryName="@currentSubcategoryName" class="btn btn-outline-secondary">Back to Listings</a>
</div>

@if (!string.IsNullOrWhiteSpace(currentCategoryName) || !string.IsNullOrWhiteSpace(currentSubcategoryName))
{
    <div class="small text-muted mb-2">
        @if (!string.IsNullOrWhiteSpace(currentCategoryName))
        {
            <span class="me-3"><strong>Category:</strong> @currentCategoryName</span>
        }
        @if (!string.IsNullOrWhiteSpace(currentSubcategoryName))
        {
            <span><strong>Subcategory:</strong> @currentSubcategoryName</span>
        }
    </div>
}

<div class="alert alert-info mb-3">
    Click a marker to open that listing details in a new tab.
</div>

<div id="listingMap" class="border rounded" style="height: 72vh; min-height: 520px;"></div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

@section Scripts {
    <script>
        (() => {
            const markers = @Html.Raw(serializedMarkers);
            const mapElement = document.getElementById("listingMap");
            if (!mapElement) {
                return;
            }

            const map = L.map(mapElement).setView([43.6532, -79.3832], 6);
            L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
                maxZoom: 19,
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(map);

            const bounds = L.latLngBounds([]);
            const geocodeCache = new Map();

            const delay = (ms) => new Promise((resolve) => window.setTimeout(resolve, ms));

            const geocodePostalCode = async (postalCode) => {
                const key = (postalCode || "").trim().toUpperCase();
                if (!key) {
                    return null;
                }

                if (geocodeCache.has(key)) {
                    return geocodeCache.get(key);
                }

                const query = encodeURIComponent(`${key}, Canada`);
                const url = `https://nominatim.openstreetmap.org/search?format=json&limit=1&q=${query}`;

                try {
                    const response = await fetch(url, {
                        method: "GET",
                        headers: {
                            "Accept": "application/json"
                        }
                    });

                    if (!response.ok) {
                        geocodeCache.set(key, null);
                        return null;
                    }

                    const payload = await response.json();
                    if (!Array.isArray(payload) || payload.length === 0) {
                        geocodeCache.set(key, null);
                        return null;
                    }

                    const candidate = payload[0];
                    const lat = Number.parseFloat(candidate.lat);
                    const lon = Number.parseFloat(candidate.lon);
                    const location = Number.isFinite(lat) && Number.isFinite(lon)
                        ? { lat, lon }
                        : null;

                    geocodeCache.set(key, location);
                    return location;
                } catch {
                    geocodeCache.set(key, null);
                    return null;
                }
            };

            const openDetailsInNewTab = (url) => {
                if (!url || url === "#") {
                    return;
                }

                window.open(url, "_blank", "noopener,noreferrer");
            };

            const escapeHtml = (value) => (value || "")
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/\"/g, "&quot;")
                .replace(/'/g, "&#39;");

            const formatPrice = (price) => {
                if (price === null || typeof price === "undefined") {
                    return "N/A";
                }

                const amount = Number(price);
                if (!Number.isFinite(amount)) {
                    return "N/A";
                }

                return `$${amount.toFixed(2)}`;
            };

            const addMarker = (item, location) => {
                const marker = L.marker([location.lat, location.lon]).addTo(map);

                marker.bindTooltip(`
                    <div>
                        <div><strong>${escapeHtml(item.subject || "Listing")}</strong></div>
                        <div class="small">Postal Code: ${escapeHtml(item.postalCode || "")}</div>
                        <div class="small">Price: ${escapeHtml(formatPrice(item.price))}</div>
                    </div>
                `, {
                    direction: "top",
                    opacity: 0.95
                });

                marker.on("mouseover", () => {
                    marker.openTooltip();
                });

                marker.on("mouseout", () => {
                    marker.closeTooltip();
                });

                marker.on("click", () => {
                    openDetailsInNewTab(item.detailUrl);
                });

                bounds.extend([location.lat, location.lon]);
            };

            const initializeMap = async () => {
                if (!Array.isArray(markers) || markers.length === 0) {
                    return;
                }

                for (const item of markers) {
                    const location = await geocodePostalCode(item.postalCode);
                    if (!location) {
                        continue;
                    }

                    addMarker(item, location);
                    await delay(120);
                }

                if (bounds.isValid()) {
                    map.fitBounds(bounds.pad(0.2));
                }
            };

            initializeMap();
        })();
    </script>
}
