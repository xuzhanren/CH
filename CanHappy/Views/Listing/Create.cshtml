@model CanHappy.Models.Listing
@using System.Text.Json

@{
    ViewData["Title"] = "Create";
    var subcategoryLookup = ViewData["SubcategoryLookup"];
    var cityLookup = ViewData["CityLookup"];
    var hasThumbnail = !string.IsNullOrWhiteSpace(Model?.ThumbnailURL);
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.css" />
<style>
    .cropper-view-box {
        outline-width: 2px !important;
    }

    .cropper-line.line-e,
    .cropper-line.line-w {
        width: 2px !important;
    }

    .cropper-line.line-n,
    .cropper-line.line-s {
        height: 2px !important;
    }

    .cropper-point {
        width: 14px !important;
        height: 14px !important;
        border: 2px solid #fff !important;
        opacity: 1 !important;
    }
</style>

<h1>Create</h1>

<div class="card shadow-sm">
    <div class="card-body">
        <h4 class="card-title">Listing</h4>
        <hr />
        <form asp-action="Create" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Subject" class="form-label"></label>
                <input asp-for="Subject" class="form-control" />
                <span asp-validation-for="Subject" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="CategoryId" class="form-label"></label>
                <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId">
                    <option value="">Select Category</option>
                </select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SubcategoryId" class="form-label"></label>
                <select asp-for="SubcategoryId" class="form-select" asp-items="ViewBag.SubcategoryId">
                    <option value="">Select Subcategory</option>
                </select>
                <span asp-validation-for="SubcategoryId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ProvinceId" class="form-label"></label>
                <select asp-for="ProvinceId" class="form-select" asp-items="ViewBag.ProvinceId">
                    <option value="">Select Province</option>
                </select>
                <span asp-validation-for="ProvinceId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="CityId" class="form-label"></label>
                <select asp-for="CityId" class="form-select" asp-items="ViewBag.CityId">
                    <option value="">Select City</option>
                </select>
                <span asp-validation-for="CityId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="KeyWords" class="form-label"></label>
                <input asp-for="KeyWords" class="form-control" />
                <span asp-validation-for="KeyWords" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Price" class="form-label"></label>
                <input asp-for="Price" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>
            <div class="mb-3" data-hide-for-business-yellow-page="true">
                <label asp-for="DiscountPercent" class="form-label"></label>
                <input asp-for="DiscountPercent" class="form-control" />
                <span asp-validation-for="DiscountPercent" class="text-danger"></span>
            </div>
            <div class="mb-3" data-hide-for-business-yellow-page="true">
                <label asp-for="DiscountBeginDate" class="form-label"></label>
                <input asp-for="DiscountBeginDate" type="date" class="form-control" />
                <span asp-validation-for="DiscountBeginDate" class="text-danger"></span>
            </div>
            <div class="mb-3" data-hide-for-business-yellow-page="true">
                <label asp-for="DiscountEndDate" class="form-label"></label>
                <input asp-for="DiscountEndDate" type="date" class="form-control" />
                <span asp-validation-for="DiscountEndDate" class="text-danger"></span>
            </div>
            <div class="mb-3" data-hide-for-business-yellow-page="true">
                <label asp-for="Brand" class="form-label"></label>
                <input asp-for="Brand" class="form-control" />
                <span asp-validation-for="Brand" class="text-danger"></span>
            </div>
            <div class="mb-3" data-hide-for-business-yellow-page="true">
                <label asp-for="Model" class="form-label"></label>
                <input asp-for="Model" class="form-control" />
                <span asp-validation-for="Model" class="text-danger"></span>
            </div>
            <div class="mb-3" data-hide-for-business-yellow-page="true">
                <label asp-for="Condition" class="form-label"></label>
                <input asp-for="Condition" class="form-control" />
                <span asp-validation-for="Condition" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label class="form-label">Thumbnail Image</label>
                <input type="file" id="thumbnailFileInput" class="form-control" accept="image/*" />
                <div class="mt-2 d-flex gap-2">
                    <button type="button" id="openCropModalButton" class="btn btn-outline-primary" disabled>Clip
                        Image</button>
                        <button type="button" id="clearThumbnailButton" class="btn btn-outline-secondary">Clear
                            Image</button>
                        </div>
                    </div>
                    <div id="thumbnailPreviewContainer" class="mb-3 @(hasThumbnail ? string.Empty : "d-none")">
                        <label class="form-label">Thumbnail Preview</label>
                        <div>
                            <img id="thumbnailPreview" src="@Model?.ThumbnailURL" alt="Listing thumbnail"
                                 class="img-fluid rounded border" style="max-height: 220px;" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Address" class="form-label"></label>
                        <input asp-for="Address" class="form-control" />
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="PostalCode" class="form-label"></label>
                        <input asp-for="PostalCode" class="form-control" />
                        <span asp-validation-for="PostalCode" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ContactPhone" class="form-label"></label>
                        <input asp-for="ContactPhone" class="form-control" />
                        <span asp-validation-for="ContactPhone" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ContactName" class="form-label"></label>
                        <input asp-for="ContactName" class="form-control" />
                        <span asp-validation-for="ContactName" class="text-danger"></span>
                    </div>
                    <div class="form-check mb-3">
                        <input asp-for="ShowContactInd" class="form-check-input" />
                        <label asp-for="ShowContactInd" class="form-check-label"></label>
                        <span asp-validation-for="ShowContactInd" class="text-danger"></span>
                    </div>
                    <input type="hidden" asp-for="ViewCount" />
                    <input type="hidden" asp-for="ClickCount" />
                    <input type="hidden" asp-for="DeletedInd" />
                    <input type="hidden" asp-for="SampleInd" />
                    <input type="hidden" asp-for="UserId" />
                    <input type="hidden" asp-for="CreatedBy" />
                    <input type="hidden" asp-for="ModifiedBY" />
                    <input type="hidden" asp-for="CreatedDate" />
                    <input type="hidden" asp-for="ModifiedDate" />
                    <input type="hidden" asp-for="ThumbnailURL" />
                    <input type="hidden" id="CroppedThumbnailData" name="croppedThumbnailData" />
                    <input type="hidden" id="ClearedThumbnailUrl" name="clearedThumbnailUrl" />

                    <div class="d-flex gap-2">
                        <input type="submit" value="Create" class="btn btn-primary" />
                        <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
                    </div>
                </form>
            </div>
        </div>

        <div class="modal fade" id="thumbnailCropModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-fullscreen">
                <div class="modal-content h-100">
                    <div class="modal-header py-2 px-3">
                        <h5 class="modal-title">Clip Thumbnail Image</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body pt-2 pb-2 px-3 d-flex flex-column overflow-hidden">
                        <div class="d-flex flex-wrap gap-2 align-items-center pb-2 mb-3 flex-shrink-0">
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <label for="cropAspectRatioSelect" class="form-label mb-0 text-nowrap">Aspect Ratio</label>
                                <select id="cropAspectRatioSelect" class="form-select form-select-sm" style="min-width: 100px;">
                                    <option value="3:2" selected>3:2</option>
                                    <option value="1:1">1:1</option>
                                    <option value="4:3">4:3</option>
                                    <option value="16:9">16:9</option>
                                    <option value="9:16">9:16</option>
                                    <option value="19:10">19:10</option>
                                    <option value="6:5">6:5</option>
                                    <option value="8:1">8:1</option>
                                    <option value="32:5">32:5</option>
                                    <option value="2:1">2:1</option>
                                    <option value="3:1">3:1</option>
                                    <option value="4:1">4:1</option>
                                    <option value="10:1">10:1</option>
                                    <option value="2:3">2:3</option>
                                    <option value="1:2">1:2</option>
                                    <option value="1:4">1:4</option>
                                    <option value="1:8">1:8</option>
                                    <option value="custom">Custom</option>
                                </select>
                            </div>
                            <button type="button" id="editCropModeButton" class="btn btn-sm btn-primary mb-1 text-nowrap">Crop
                                Mode</button>
                                <button type="button" id="editPenModeButton"
                                        class="btn btn-sm btn-outline-secondary mb-1 text-nowrap">Free Draw
                                    Pen</button>
                                    <button type="button" id="editEraseModeButton"
                                            class="btn btn-sm btn-outline-secondary mb-1 text-nowrap">Erasor</button>
                                    <button type="button" id="editTextModeButton"
                                            class="btn btn-sm btn-outline-secondary mb-1 text-nowrap">Type
                                        Text</button>
                                        <div class="d-flex align-items-center gap-2 mb-1">
                                            <label for="editFontSelect" class="form-label mb-0 text-nowrap">Font</label>
                                            <select id="editFontSelect" class="form-select form-select-sm" style="min-width: 150px;">
                                                <option value="Arial, sans-serif" selected>Arial</option>
                                                <option value="'Segoe UI', sans-serif">Segoe UI</option>
                                                <option value="Verdana, sans-serif">Verdana</option>
                                                <option value="Tahoma, sans-serif">Tahoma</option>
                                                <option value="Georgia, serif">Georgia</option>
                                                <option value="'Times New Roman', serif">Times New Roman</option>
                                                <option value="'Courier New', monospace">Courier New</option>
                                            </select>
                                        </div>
                                        <div class="d-flex align-items-center gap-2 mb-1">
                                            <label for="editFontSizeInput" class="form-label mb-0 text-nowrap">Font Size</label>
                                            <input id="editFontSizeInput" type="number" class="form-control form-control-sm" min="8"
                                                   max="120" step="1" value="26" style="width: 90px;" />
                                        </div>
                                        <div class="d-flex align-items-center gap-2 mb-1">
                                            <label for="editBrushSizeInput" class="form-label mb-0 text-nowrap">Brush Size</label>
                                            <input id="editBrushSizeInput" type="range" class="form-range mb-0" min="0" max="30" value="6"
                                                   style="width: 140px;" />
                                            <span id="editBrushSizeValue" class="small text-muted text-nowrap">6</span>
                                        </div>
                                        <div class="d-flex align-items-center gap-2 mb-1">
                                            <label for="editColorInput" class="form-label mb-0 text-nowrap">Color</label>
                                            <input id="editColorInput" type="color" class="form-control form-control-color"
                                                   value="#ff0000" />
                                        </div>
                                            <button type="button" id="undoEditButton"
                                                    class="btn btn-sm btn-outline-secondary mb-1 text-nowrap">Undo</button>
                                            <button type="button" id="redoEditButton"
                                                    class="btn btn-sm btn-outline-secondary mb-1 text-nowrap">Redo</button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary mb-1 text-nowrap"
                                                    data-bs-dismiss="modal">Cancel</button>
                                            <button type="button" id="saveCroppedImageButton"
                                                    class="btn btn-sm btn-primary mb-1 text-nowrap">Save Clipped
                                                Image</button>
                                            </div>
                                            <div class="position-relative border rounded overflow-hidden bg-light flex-grow-1"
                                                 style="min-height: 0; background-color: #e9ecef;">
                                                <img id="cropperImage" alt="Image to crop" class="w-100 h-100" style="object-fit: contain;" />
                                                <canvas id="editCanvas" class="d-none"
                                                        style="touch-action: none; cursor: crosshair; max-width: 100%; max-height: 100%; width: auto; height: auto; display: block; margin: auto;"></canvas>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                @section Scripts {
                                    @{
                                        await Html.RenderPartialAsync("_ValidationScriptsPartial");
                                    }
                                    <script src="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.js"></script>
                                    <script>
                                        (() => {
                                        const subcategories = @Html.Raw(JsonSerializer.Serialize(subcategoryLookup));
                                        const cities = @Html.Raw(JsonSerializer.Serialize(cityLookup));

                                        const categorySelect = document.getElementById("CategoryId");
                                        const subcategorySelect = document.getElementById("SubcategoryId");
                                        const provinceSelect = document.getElementById("ProvinceId");
                                        const citySelect = document.getElementById("CityId");
                                        const businessYellowPageHiddenFields = Array.from(document.querySelectorAll('[data-hide-for-business-yellow-page="true"]'));

                                        const selectedSubcategoryId = Number(subcategorySelect.value || 0);
                                        const selectedCityId = Number(citySelect.value || 0);

                                        const populate = (target, items, placeholder, valueKey = "id") => {
                                        target.innerHTML = "";

                                        const placeholderOption = document.createElement("option");
                                        placeholderOption.value = "";
                                        placeholderOption.textContent = placeholder;
                                        target.appendChild(placeholderOption);

                                        items.forEach(item => {
                                        const option = document.createElement("option");
                                        option.value = item[valueKey];
                                        option.textContent = item.name;
                                        target.appendChild(option);
                                        });
                                        };

                                        const refreshSubcategories = (selectedId = 0) => {
                                        const categoryId = Number(categorySelect.value || 0);
                                        const filtered = categoryId > 0
                                        ? subcategories.filter(item => item.categoryId === categoryId)
                                        : [];

                                        populate(subcategorySelect, filtered, "Select Subcategory");

                                        if (selectedId > 0 && filtered.some(item => item.id === selectedId)) {
                                        subcategorySelect.value = String(selectedId);
                                        }
                                        };

                                        const refreshCities = (selectedId = 0) => {
                                        const provinceId = Number(provinceSelect.value || 0);
                                        const filtered = provinceId > 0
                                        ? cities.filter(item => item.provinceId === provinceId)
                                        : [];

                                        populate(citySelect, filtered, "Select City");

                                        if (selectedId > 0 && filtered.some(item => item.id === selectedId)) {
                                        citySelect.value = String(selectedId);
                                        }
                                        };

                                        const isBusinessYellowPageSelected = () => {
                                        const selectedOption = categorySelect.options[categorySelect.selectedIndex];
                                        if (!selectedOption) {
                                        return false;
                                        }

                                        return (selectedOption.textContent || "")
                                        .trim()
                                        .toLowerCase() === "business yellow page";
                                        };

                                        const refreshBusinessYellowPageVisibility = () => {
                                        const shouldHide = isBusinessYellowPageSelected();
                                        businessYellowPageHiddenFields.forEach((field) => {
                                        field.classList.toggle("d-none", shouldHide);
                                        });
                                        };

                                        categorySelect.addEventListener("change", () => {
                                        refreshSubcategories();
                                        refreshBusinessYellowPageVisibility();
                                        });
                                        provinceSelect.addEventListener("change", () => refreshCities());

                                        refreshSubcategories(selectedSubcategoryId);
                                        refreshCities(selectedCityId);
                                        refreshBusinessYellowPageVisibility();

                                        const thumbnailFileInput = document.getElementById("thumbnailFileInput");
                                        const openCropModalButton = document.getElementById("openCropModalButton");
                                        const clearThumbnailButton = document.getElementById("clearThumbnailButton");
                                        const thumbnailPreviewContainer = document.getElementById("thumbnailPreviewContainer");
                                        const thumbnailPreview = document.getElementById("thumbnailPreview");
                                        const thumbnailUrlInput = document.getElementById("ThumbnailURL");
                                        const croppedThumbnailDataInput = document.getElementById("CroppedThumbnailData");
                                        const clearedThumbnailUrlInput = document.getElementById("ClearedThumbnailUrl");

                                        const cropModalElement = document.getElementById("thumbnailCropModal");
                                        const cropModal = new bootstrap.Modal(cropModalElement);

                                        let sourceImageDataUrl = "";

                                        const editor = window.CanHappyImageClipping.createEditor({
                                        modal: cropModalElement,
                                        onSave: async ({ canvas }) => {
                                        const thumbnailDataUrl = window.CanHappyImageClipping.buildThumbnailDataUrl(canvas);
                                        croppedThumbnailDataInput.value = thumbnailDataUrl;
                                        thumbnailUrlInput.value = "";
                                        thumbnailPreview.src = thumbnailDataUrl;
                                        thumbnailPreviewContainer.classList.remove("d-none");
                                        cropModal.hide();
                                        }
                                        });

                                        thumbnailFileInput.addEventListener("change", () => {
                                        const file = thumbnailFileInput.files?.[0];
                                        if (!file) {
                                        sourceImageDataUrl = "";
                                        openCropModalButton.disabled = true;
                                        return;
                                        }

                                        const reader = new FileReader();
                                        reader.onload = (event) => {
                                        sourceImageDataUrl = event.target?.result?.toString() || "";
                                        openCropModalButton.disabled = !sourceImageDataUrl;
                                        if (sourceImageDataUrl) {
                                        editor.open(sourceImageDataUrl);
                                        }
                                        };
                                        reader.readAsDataURL(file);
                                        });

                                        if (thumbnailPreview?.src) {
                                        sourceImageDataUrl = thumbnailPreview.src;
                                        openCropModalButton.disabled = false;
                                        }

                                        openCropModalButton.addEventListener("click", () => {
                                        if (!sourceImageDataUrl) {
                                        return;
                                        }

                                        editor.open(sourceImageDataUrl);
                                        });

                                        clearThumbnailButton.addEventListener("click", () => {
                                        if (clearedThumbnailUrlInput) {
                                        clearedThumbnailUrlInput.value = thumbnailUrlInput.value || thumbnailPreview.getAttribute("src") || "";
                                        }
                                        thumbnailFileInput.value = "";
                                        sourceImageDataUrl = "";
                                        openCropModalButton.disabled = true;
                                        croppedThumbnailDataInput.value = "";
                                        thumbnailUrlInput.value = "";
                                        thumbnailPreview.src = "";
                                        thumbnailPreviewContainer.classList.add("d-none");
                                        });
                                        })();
                                    </script>
                                    <script>
                                        (() => {
                                        const editBrushSizeInput = document.getElementById("editBrushSizeInput");
                                        const editBrushSizeValue = document.getElementById("editBrushSizeValue");
                                        if (!editBrushSizeInput || !editBrushSizeValue) {
                                        return;
                                        }

                                        const syncBrushSizeValue = () => {
                                        editBrushSizeValue.textContent = editBrushSizeInput.value;
                                        };

                                        editBrushSizeInput.addEventListener("input", syncBrushSizeValue);
                                        syncBrushSizeValue();
                                        })();
                                    </script>
                                }