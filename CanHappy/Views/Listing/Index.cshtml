@model IEnumerable<CanHappy.Models.Listing>
@using System.Security.Claims

@{
    ViewData["Title"] = "Listings";
    var currentUserIdText = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var isCurrentUserGuid = Guid.TryParse(currentUserIdText, out var currentUserId);
    var currentReturnUrl = Context.Request.Path.ToString();
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var loginPageUrl = Url.Page("/Account/Login", values: new { area = "Identity" }) ?? "/Identity/Account/Login";
    var focusListingId = ViewData["FocusListingId"] is Guid value ? value : (Guid?)null;
    var focusListingKey = focusListingId?.ToString("N");
    var currentCategoryName = ViewData["CategoryName"]?.ToString();
    var currentSubcategoryName = ViewData["SubcategoryName"]?.ToString();
    var currentKeywords = Context.Request.Query["keywords"].ToString();
    var currentProvinceId = Context.Request.Query["provinceId"].ToString();
    var currentCityId = Context.Request.Query["cityId"].ToString();
    var currentPage = ViewData["CurrentPage"] is int pageValue ? pageValue : 1;
    var totalPages = ViewData["TotalPages"] is int totalPageValue ? totalPageValue : 1;
    var maxVisiblePageLinks = 5;
    var halfWindow = maxVisiblePageLinks / 2;
    var startPage = Math.Max(1, currentPage - halfWindow);
    var endPage = Math.Min(totalPages, startPage + maxVisiblePageLinks - 1);
    if (endPage - startPage + 1 < maxVisiblePageLinks)
    {
        startPage = Math.Max(1, endPage - maxVisiblePageLinks + 1);
    }
    var reviewCountByListing = ViewData["ReviewCountByListing"] as Dictionary<Guid, int> ?? new Dictionary<Guid, int>();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0 d-flex flex-wrap align-items-center gap-2">
        Listings
          <a asp-action="Map"
              asp-route-categoryName="@currentCategoryName"
              asp-route-subcategoryName="@currentSubcategoryName"
                            asp-route-keywords="@currentKeywords"
                            asp-route-provinceId="@currentProvinceId"
                            asp-route-cityId="@currentCityId"
              target="_blank" rel="noopener noreferrer" class="ms-2 fs-6 text-decoration-none align-middle">
            <span class="d-inline-flex align-items-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true" class="me-1">
                    <path d="M8 0a5 5 0 0 0-5 5c0 3.25 4.53 9.08 4.72 9.33a.35.35 0 0 0 .56 0C8.47 14.08 13 8.25 13 5a5 5 0 0 0-5-5m0 7a2 2 0 1 1 0-4 2 2 0 0 1 0 4"/>
                </svg>
                See locations in Map
            </span>
        </a>

        @if (totalPages > 1)
        {
            <nav aria-label="Listings pagination header" class="ms-1">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(currentPage <= 1 ? "disabled" : string.Empty)">
                                <a class="page-link"
                                    asp-route="ListingIndex"
                           asp-route-categoryName="@currentCategoryName"
                           asp-route-subcategoryName="@currentSubcategoryName"
                           asp-route-keywords="@currentKeywords"
                           asp-route-provinceId="@currentProvinceId"
                           asp-route-cityId="@currentCityId"
                           asp-route-page="@(currentPage - 1)" aria-label="Previous">&lt;</a>
                    </li>

                    @if (startPage > 1)
                    {
                        <li class="page-item @(currentPage == 1 ? "active" : string.Empty)">
                            <a class="page-link"
                               asp-route="ListingIndex"
                               asp-route-categoryName="@currentCategoryName"
                               asp-route-subcategoryName="@currentSubcategoryName"
                               asp-route-keywords="@currentKeywords"
                               asp-route-provinceId="@currentProvinceId"
                               asp-route-cityId="@currentCityId"
                               asp-route-page="1">1</a>
                        </li>

                        @if (startPage > 2)
                        {
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        }
                    }

                    @for (var pageNumber = startPage; pageNumber <= endPage; pageNumber++)
                    {
                        <li class="page-item @(pageNumber == currentPage ? "active" : string.Empty)">
                                     <a class="page-link"
                                         asp-route="ListingIndex"
                               asp-route-categoryName="@currentCategoryName"
                               asp-route-subcategoryName="@currentSubcategoryName"
                               asp-route-keywords="@currentKeywords"
                               asp-route-provinceId="@currentProvinceId"
                               asp-route-cityId="@currentCityId"
                               asp-route-page="@pageNumber">@pageNumber</a>
                        </li>
                    }

                    @if (endPage < totalPages)
                    {
                        @if (endPage < totalPages - 1)
                        {
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        }

                        <li class="page-item @(currentPage == totalPages ? "active" : string.Empty)">
                            <a class="page-link"
                               asp-route="ListingIndex"
                               asp-route-categoryName="@currentCategoryName"
                               asp-route-subcategoryName="@currentSubcategoryName"
                               asp-route-keywords="@currentKeywords"
                               asp-route-provinceId="@currentProvinceId"
                               asp-route-cityId="@currentCityId"
                               asp-route-page="@totalPages">@totalPages</a>
                        </li>
                    }

                    <li class="page-item @(currentPage >= totalPages ? "disabled" : string.Empty)">
                                <a class="page-link"
                                    asp-route="ListingIndex"
                           asp-route-categoryName="@currentCategoryName"
                           asp-route-subcategoryName="@currentSubcategoryName"
                           asp-route-keywords="@currentKeywords"
                           asp-route-provinceId="@currentProvinceId"
                           asp-route-cityId="@currentCityId"
                           asp-route-page="@(currentPage + 1)" aria-label="Next">&gt;</a>
                    </li>

                    <li class="page-item">
                        <form asp-route="ListingIndex" method="get" class="d-flex align-items-center ms-2">
                            <input type="hidden" name="categoryName" value="@currentCategoryName" />
                            <input type="hidden" name="subcategoryName" value="@currentSubcategoryName" />
                            <input type="hidden" name="keywords" value="@currentKeywords" />
                            <input type="hidden" name="provinceId" value="@currentProvinceId" />
                            <input type="hidden" name="cityId" value="@currentCityId" />
                            <input type="text"
                                   name="page"
                                   inputmode="numeric"
                                   pattern="[0-9]*"
                                   value="@currentPage"
                                   class="form-control form-control-sm"
                                   style="width: 3.3rem;" />
                        </form>
                    </li>
                </ul>
            </nav>
        }
    </h1>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</div>

@if (TempData["MessageSuccess"] is string messageSuccess && !string.IsNullOrWhiteSpace(messageSuccess))
{
    <div class="alert alert-success">@messageSuccess</div>
}

@if (TempData["MessageError"] is string messageError && !string.IsNullOrWhiteSpace(messageError))
{
    <div class="alert alert-danger">@messageError</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">No listings found.</div>
}
else
{
    <div class="row g-3">
        @foreach (var item in Model)
        {
            <div class="col-12">
                @{
                    var listingCardId = $"listing-card-{item.ListingGUID:N}";
                    var isBuySellCategory = string.Equals(item.Category?.Name, "Buy & Sell", StringComparison.OrdinalIgnoreCase);
                    var isCarVehicleCategory = string.Equals(item.Category?.Name, "Car & Vehicle",
                    StringComparison.OrdinalIgnoreCase);
                    var isHomeRentalCategory = string.Equals(item.Category?.Name, "Home Rental",
                    StringComparison.OrdinalIgnoreCase);
                    var isEstateSaleCategory = string.Equals(item.Category?.Name, "Estate Sale",
                    StringComparison.OrdinalIgnoreCase);
                    var buySellDetailsUrl = Url.Action("Index", "BuySellDetailPage", new { listingGuid = item.ListingGUID }) ?? "#";
                    var carVehicleDetailsUrl = Url.Action("Index", "CarVehicleDetailPage", new { listingGuid = item.ListingGUID })
                    ?? "#";
                    var homeRentalDetailsUrl = Url.Action("Index", "HomeRentalDetailPage", new { listingGuid = item.ListingGUID })
                    ?? "#";
                    var estateSaleDetailsUrl = Url.Action("Index", "EstateSaleDetailPage", new { listingGuid = item.ListingGUID })
                    ?? "#";
                    var listingDetailsUrl = isBuySellCategory
                    ? buySellDetailsUrl
                    : isCarVehicleCategory
                    ? carVehicleDetailsUrl
                    : isHomeRentalCategory
                    ? homeRentalDetailsUrl
                    : isEstateSaleCategory
                    ? estateSaleDetailsUrl
                    : Url.Action("Details", "ListingPage", new { id = item.ListingGUID }) ?? "#";
                    var reviewCount = reviewCountByListing.TryGetValue(item.ListingGUID, out var count) ? count : 0;
                    var ratingText = string.IsNullOrWhiteSpace(item.Rating) ? "3.5" : item.Rating;
                    var ratingValue = double.TryParse(ratingText, out var parsedRating) ? Math.Clamp(parsedRating, 0d, 5d) : 3.5d;
                    var fullStars = (int)Math.Floor(ratingValue);
                    var halfStar = ratingValue - fullStars >= 0.5d;
                    var stars = new string('★', fullStars) + (halfStar ? "½" : string.Empty) + new string('☆', Math.Max(0, 5 -
                    fullStars - (halfStar ? 1 : 0)));
                    var reviewUrl = Url.Action("Index", "ListingReview", new { listingGuid = item.ListingGUID }) ?? "#";
                    var addressMapQuery = $"{item.Address} {item.City?.Name} {item.Province?.Name} {item.PostalCode}".Trim();
                    var addressMapUrl = string.IsNullOrWhiteSpace(addressMapQuery)
                    ? string.Empty
                    : $"https://www.google.com/maps?q={Uri.EscapeDataString(addressMapQuery)}";
                    var today = CanHappy.Common.EasternTime.Now.Date;
                    var isSaleActive = item.Price.HasValue
                    && item.DiscountPercent > 0
                    && item.DiscountBeginDate.HasValue
                    && today > item.DiscountBeginDate.Value.Date
                    && (!item.DiscountEndDate.HasValue || today < item.DiscountEndDate.Value.Date);
                    decimal? discountedPrice = null;
                    if (isSaleActive && item.Price is decimal basePrice)
                    {
                        discountedPrice = basePrice * (100m - item.DiscountPercent) / 100.00m;
                    }
                }
                <div id="@listingCardId" class="card shadow-sm">
                    <div class="card-body">
                        @if (!string.IsNullOrWhiteSpace(item.ThumbnailURL))
                        {
                            <div class="mb-3">
                                @if (isBuySellCategory || isCarVehicleCategory || isHomeRentalCategory || isEstateSaleCategory)
                                {
                                    <a href="@listingDetailsUrl">
                                        <img src="@item.ThumbnailURL" alt="@item.Subject" class="img-fluid rounded border"
                                             style="max-height: 220px;" />
                                    </a>
                                }
                                else
                                {
                                    <img src="@item.ThumbnailURL" alt="@item.Subject" class="img-fluid rounded border"
                                         style="max-height: 220px;" />
                                }
                            </div>
                        }
                        <h5 class="card-title mb-3">@item.Subject</h5>
                        <div class="mb-2">
                            <span class="fw-semibold">@ratingValue.ToString("0.0")</span>
                            <span class="ms-1 text-warning">@stars</span>
                            <a class="ms-1" href="@reviewUrl">(@reviewCount)</a>
                        </div>
                        <div class="row g-2">
                            <div class="col-md-6">
                                <strong>Subject:</strong> @item.Subject
                                @if (isSaleActive && discountedPrice.HasValue)
                                {
                                    <span class="text-danger fw-bold ms-2">Sale</span>
                                    <span class="text-danger fw-bold ms-1">@discountedPrice.Value.ToString("F2")</span>
                                }
                            </div>
                            <div class="col-md-6"><strong>Description:</strong> @item.Description</div>
                            <div class="col-md-6"><strong>KeyWords:</strong> @item.KeyWords</div>
                            <div class="col-md-6"><strong>Price:</strong> @item.Price</div>
                            <div class="col-md-6"><strong>Quantity:</strong> @item.Quantity</div>
                            <div class="col-md-6"><strong>Discount Percent:</strong> @item.DiscountPercent</div>
                            <div class="col-md-6"><strong>Sales Begin:</strong> @item.DiscountBeginDate</div>
                            <div class="col-md-6"><strong>Sales Ending:</strong> @item.DiscountEndDate</div>
                            <div class="col-md-6"><strong>Brand:</strong> @item.Brand</div>
                            <div class="col-md-6"><strong>Model:</strong> @item.Model</div>
                            <div class="col-md-6"><strong>Condition:</strong> @item.Condition</div>
                            <div class="col-md-6"><strong>Manufacture Year:</strong> @item.ManufactureYear</div>
                            <div class="col-md-6"><strong>Category:</strong> @item.Category?.Name</div>
                            <div class="col-md-6"><strong>Subcategory:</strong> @item.Subcategory?.Name</div>
                            <div class="col-md-6"><strong>Province:</strong> @item.Province?.Name</div>
                            <div class="col-md-6"><strong>City:</strong> @item.City?.Name</div>
                            <div class="col-md-6">
                                <strong>Address:</strong> @item.Address
                                @if (!string.IsNullOrWhiteSpace(item.Address) && !string.IsNullOrWhiteSpace(addressMapUrl))
                                {
                                    <a href="@addressMapUrl" target="_blank" rel="noopener noreferrer" class="ms-2">Google map</a>
                                }
                            </div>
                            <div class="col-md-6">
                                <strong>Postal Code:</strong> @item.PostalCode
                                @if (!string.IsNullOrWhiteSpace(item.PostalCode))
                                {
                                    <a href="#" class="ms-2 open-google-map" data-postal-code="@item.PostalCode">Google map</a>
                                }
                            </div>
                            @if (item.ShowContactInd)
                            {
                                <div class="col-md-6"><strong>Contact Phone:</strong> @item.ContactPhone</div>
                                <div class="col-md-6"><strong>Contact Name:</strong> @item.ContactName</div>
                                <div class="col-md-6"><strong>Show Contact:</strong> @item.ShowContactInd</div>
                            }
                        </div>
                    </div>
                    <div class="card-footer bg-transparent">
                        @{
                            var canManageListing = User.IsInRole("Admin")
                            || User.IsInRole("Clerk")
                            || (isCurrentUserGuid
                            && item.UserId != Guid.Empty
                            && currentUserId == item.UserId);
                            var isOwnerListing = isCurrentUserGuid
                            && item.UserId != Guid.Empty
                            && currentUserId == item.UserId;
                            var messageModalId = $"sendMessageModal_{item.ListingGUID:N}";
                            var messageListingKey = item.ListingGUID.ToString("N");
                            var ownListingNoticeId = $"ownListingNotice_{item.ListingGUID:N}";
                            var defaultMessageSubject = $"Message about: {item.Subject}";
                            var actionLinkClass = "btn btn-link p-0 fs-5 align-baseline";
                        }
                        <a href="#" class="@actionLinkClass send-message-link" data-message-modal-id="@messageModalId"
                               data-listing-guid="@messageListingKey" data-is-owner="@isOwnerListing.ToString().ToLowerInvariant()"
                               data-notice-id="@ownListingNoticeId">
                            Message seller
                        </a>
                        <span> | </span>
                        @if (isBuySellCategory || isCarVehicleCategory || isHomeRentalCategory || isEstateSaleCategory)
                        {
                            <a href="@listingDetailsUrl" class="@actionLinkClass">Details</a>
                        }
                        else
                        {
                            <a asp-action="Details" asp-route-id="@item.ListingGUID" class="@actionLinkClass">Details</a>
                        }
                        <span id="@ownListingNoticeId" class="small text-muted ms-2 d-none">You cannot message your own
                            listing.</span>
                            @if (canManageListing)
                            {
                                <span> | </span>
                                <a asp-action="Edit" asp-route-id="@item.ListingGUID" asp-route-categoryName="@currentCategoryName"
                                   asp-route-subcategoryName="@currentSubcategoryName" class="@actionLinkClass">Edit</a>
                                <span> | </span>
                                <a asp-action="Delete" asp-route-id="@item.ListingGUID" class="@actionLinkClass">Delete</a>
                            }
                        </div>
                    </div>

                    <div class="modal fade" id="@messageModalId" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title">Message seller</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <form method="post"
                                      action="@Url.Action("SendToSeller", "MessagePage", new { listingId = item.ListingGUID })">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="returnUrl" value="@currentReturnUrl" />
                                    <div class="modal-body">
                                        <div class="mb-3">
                                            <label for="subject_@item.ListingGUID" class="form-label">Subject</label>
                                            <input type="text" id="subject_@item.ListingGUID" name="subject" class="form-control"
                                                   maxlength="120" value="@defaultMessageSubject" />
                                        </div>
                                        <div class="mb-0">
                                            <label for="body_@item.ListingGUID" class="form-label">Message</label>
                                            <textarea id="body_@item.ListingGUID" name="body" class="form-control" rows="5"
                                                      maxlength="2000" required></textarea>
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-outline-secondary"
                                                data-bs-dismiss="modal">Cancel</button>
                                        <button type="submit" class="btn btn-primary">Send</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (totalPages > 1)
        {
            <nav aria-label="Listings pagination" class="mt-3">
                <ul class="pagination pagination-sm justify-content-center mb-0">
                    <li class="page-item @(currentPage <= 1 ? "disabled" : string.Empty)">
                                <a class="page-link"
                                    asp-route="ListingIndex"
                           asp-route-categoryName="@currentCategoryName"
                           asp-route-subcategoryName="@currentSubcategoryName"
                           asp-route-keywords="@currentKeywords"
                           asp-route-provinceId="@currentProvinceId"
                           asp-route-cityId="@currentCityId"
                           asp-route-page="@(currentPage - 1)" aria-label="Previous">&lt;</a>
                    </li>

                    @if (startPage > 1)
                    {
                        <li class="page-item @(currentPage == 1 ? "active" : string.Empty)">
                            <a class="page-link"
                               asp-route="ListingIndex"
                               asp-route-categoryName="@currentCategoryName"
                               asp-route-subcategoryName="@currentSubcategoryName"
                               asp-route-keywords="@currentKeywords"
                               asp-route-provinceId="@currentProvinceId"
                               asp-route-cityId="@currentCityId"
                               asp-route-page="1">1</a>
                        </li>

                        @if (startPage > 2)
                        {
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        }
                    }

                    @for (var pageNumber = startPage; pageNumber <= endPage; pageNumber++)
                    {
                        <li class="page-item @(pageNumber == currentPage ? "active" : string.Empty)">
                                     <a class="page-link"
                                         asp-route="ListingIndex"
                               asp-route-categoryName="@currentCategoryName"
                               asp-route-subcategoryName="@currentSubcategoryName"
                               asp-route-keywords="@currentKeywords"
                               asp-route-provinceId="@currentProvinceId"
                               asp-route-cityId="@currentCityId"
                               asp-route-page="@pageNumber">@pageNumber</a>
                        </li>
                    }

                    @if (endPage < totalPages)
                    {
                        @if (endPage < totalPages - 1)
                        {
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        }

                        <li class="page-item @(currentPage == totalPages ? "active" : string.Empty)">
                            <a class="page-link"
                               asp-route="ListingIndex"
                               asp-route-categoryName="@currentCategoryName"
                               asp-route-subcategoryName="@currentSubcategoryName"
                               asp-route-keywords="@currentKeywords"
                               asp-route-provinceId="@currentProvinceId"
                               asp-route-cityId="@currentCityId"
                               asp-route-page="@totalPages">@totalPages</a>
                        </li>
                    }

                    <li class="page-item @(currentPage >= totalPages ? "disabled" : string.Empty)">
                                <a class="page-link"
                                    asp-route="ListingIndex"
                           asp-route-categoryName="@currentCategoryName"
                           asp-route-subcategoryName="@currentSubcategoryName"
                           asp-route-keywords="@currentKeywords"
                           asp-route-provinceId="@currentProvinceId"
                           asp-route-cityId="@currentCityId"
                           asp-route-page="@(currentPage + 1)" aria-label="Next">&gt;</a>
                    </li>

                    <li class="page-item">
                        <form asp-route="ListingIndex" method="get" class="d-flex align-items-center ms-2">
                            <input type="hidden" name="categoryName" value="@currentCategoryName" />
                            <input type="hidden" name="subcategoryName" value="@currentSubcategoryName" />
                            <input type="hidden" name="keywords" value="@currentKeywords" />
                            <input type="hidden" name="provinceId" value="@currentProvinceId" />
                            <input type="hidden" name="cityId" value="@currentCityId" />
                            <input type="text"
                                   name="page"
                                   inputmode="numeric"
                                   pattern="[0-9]*"
                                   value="@currentPage"
                                   class="form-control form-control-sm"
                                   style="width: 3.3rem;" />
                        </form>
                    </li>
                </ul>
            </nav>
        }

        <div class="modal fade" id="postalCodeMapModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Google map</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-0">
                        <iframe id="postalCodeMapFrame" title="Google map by postal code"
                                style="width:100%;height:500px;border:0;" loading="lazy"
                                referrerpolicy="no-referrer-when-downgrade"></iframe>
                    </div>
                </div>
            </div>
        </div>
    }

    @section Scripts {
        <script>
            (() => {
                const isAuthenticated = @isAuthenticated.ToString().ToLowerInvariant();
                const loginUrl = "@loginPageUrl";
                const focusListingKey = "@focusListingKey";

                const scrollToFocusedListing = (listingKey) => {
                    if (!listingKey) {
                        return;
                    }

                    const card = document.getElementById(`listing-card-${listingKey}`);
                    if (!card) {
                        return;
                    }

                    card.scrollIntoView({ behavior: "smooth", block: "center" });
                };
                const isOwnerListing = (listingGuid) => {
                    const link = document.querySelector(`.send-message-link[data-listing-guid="${listingGuid}"]`);
                    if (!link) {
                        return false;
                    }

                    return link.getAttribute("data-is-owner") === "true";
                };

                const showOwnListingNotice = (listingGuid) => {
                    const link = document.querySelector(`.send-message-link[data-listing-guid="${listingGuid}"]`);
                    if (!link) {
                        return;
                    }

                    const noticeId = link.getAttribute("data-notice-id");
                    if (!noticeId) {
                        return;
                    }

                    const notice = document.getElementById(noticeId);
                    if (!notice) {
                        return;
                    }

                    notice.classList.remove("d-none");
                };

                const openMessageModal = (listingGuid) => {
                    if (!listingGuid) {
                        return;
                    }

                    if (isOwnerListing(listingGuid)) {
                        showOwnListingNotice(listingGuid);
                        return;
                    }

                    const modalElement = document.getElementById(`sendMessageModal_${listingGuid}`);
                    if (!modalElement) {
                        return;
                    }

                    bootstrap.Modal.getOrCreateInstance(modalElement).show();
                };

                const mapModalElement = document.getElementById("postalCodeMapModal");
                const mapFrame = document.getElementById("postalCodeMapFrame");

                const openPostalMapModal = (postalCode) => {
                    if (!mapModalElement || !mapFrame || !postalCode) {
                        return;
                    }

                    mapFrame.src = `https://www.google.com/maps?q=${encodeURIComponent(postalCode)}&output=embed`;
                    bootstrap.Modal.getOrCreateInstance(mapModalElement).show();
                };

                document.querySelectorAll(".open-google-map").forEach((link) => {
                    link.addEventListener("click", (event) => {
                        event.preventDefault();
                        const postalCode = link.getAttribute("data-postal-code");
                        if (!postalCode) {
                            return;
                        }

                        openPostalMapModal(postalCode);
                    });
                });

                document.querySelectorAll(".send-message-link").forEach((link) => {
                    link.addEventListener("click", (event) => {
                        event.preventDefault();

                        const listingGuid = link.getAttribute("data-listing-guid");
                        if (!listingGuid) {
                            return;
                        }

                        if (isAuthenticated) {
                            openMessageModal(listingGuid);
                            return;
                        }

                        const currentUrl = new URL(window.location.href);
                        currentUrl.searchParams.set("openMessageFor", listingGuid);
                        const returnUrl = `${currentUrl.pathname}${currentUrl.search}`;
                        const separator = loginUrl.includes("?") ? "&" : "?";
                        window.location.href = `${loginUrl}${separator}returnUrl=${encodeURIComponent(returnUrl)}`;
                    });
                });

                if (isAuthenticated) {
                    const pageUrl = new URL(window.location.href);
                    const listingToOpen = pageUrl.searchParams.get("openMessageFor");
                    if (listingToOpen) {
                        openMessageModal(listingToOpen);
                        pageUrl.searchParams.delete("openMessageFor");
                        const cleanQuery = pageUrl.searchParams.toString();
                        const cleanUrl = `${pageUrl.pathname}${cleanQuery ? `?${cleanQuery}` : ""}${pageUrl.hash}`;
                        window.history.replaceState({}, "", cleanUrl);
                    }
                }

                if (focusListingKey) {
                    scrollToFocusedListing(focusListingKey);
                }

                if (window.location.hash && window.location.hash.startsWith("#listing-card-")) {
                    const listingFromHash = window.location.hash.substring("#listing-card-".length);
                    scrollToFocusedListing(listingFromHash);
                }
            })();
        </script>
    }