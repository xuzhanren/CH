@model CanHappy.Models.BusinessYellowPageDetailEditViewModel

@{
    ViewData["Title"] = "Edit Business Yellow Page Detail";
}

<h1>Edit Business Yellow Page Detail</h1>

<form asp-action="Edit" asp-route-id="@Model.BusinessYellowPageDetailGUID" method="post" class="mt-3">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input asp-for="BusinessYellowPageDetailGUID" type="hidden" />
    <input asp-for="ListingGUID" type="hidden" />

    <div class="row g-3">
        <div class="col-md-6"><label asp-for="BusinessHours" class="form-label"></label><input asp-for="BusinessHours"
                                                                                                   class="form-control" /></div>
            <div class="col-md-6"><label asp-for="BusinessStyle" class="form-label"></label><input asp-for="BusinessStyle"
                                                                                                       class="form-control" /></div>
                <div class="col-md-6"><label asp-for="Specialties" class="form-label"></label><input asp-for="Specialties"
                                                                                                         class="form-control" /></div>
                    <div class="col-md-6"><label asp-for="LanguagesSpoken" class="form-label"></label><input
                        asp-for="LanguagesSpoken" class="form-control" /></div>
                        <div class="col-md-6"><label asp-for="GeneralBeforeTaxPayPerPerson" class="form-label"></label><input
                            asp-for="GeneralBeforeTaxPayPerPerson" class="form-control" /></div>
                            <div class="col-md-6"><label asp-for="MethodOfPayments" class="form-label"></label><input
                                asp-for="MethodOfPayments" class="form-control" /></div>
                                <div class="col-md-6"><label asp-for="HowToGetThere" class="form-label"></label><input asp-for="HowToGetThere"
                                                                                                                           class="form-control" /></div>
                                    <div class="col-md-6"><label asp-for="WebSiteURL" class="form-label"></label><input asp-for="WebSiteURL"
                                                                                                                            class="form-control" /></div>
                                        <div class="col-12"><label asp-for="ProductsAndServices" class="form-label"></label><textarea
                                            asp-for="ProductsAndServices" class="form-control" rows="3"></textarea></div>
                                            <div class="col-12"><label asp-for="AdditionalInfo" class="form-label"></label><textarea
                                                asp-for="AdditionalInfo" class="form-control" rows="3"></textarea></div>
                                                <div class="col-12 form-check">
                                                    <input asp-for="ActiveInd" class="form-check-input" />
                                                    <label asp-for="ActiveInd" class="form-check-label"></label>
                                                </div>
                                            </div>

                                            <div class="mt-3 d-flex gap-2">
                                                <button type="submit" class="btn btn-primary">Save</button>
                                                <a asp-action="Index" asp-route-listingGuid="@Model.ListingGUID" class="btn btn-outline-secondary">Cancel</a>
                                            </div>
                                        </form>

                                        @section Scripts {
                                            <partial name="_ValidationScriptsPartial" />
                                        }