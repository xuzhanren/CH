@model CanHappy.Models.BusinessYellowPageDetailIndexPageViewModel
@using System.Security.Claims

@{
    ViewData["Title"] = "Business Yellow Page Details";
    var listingGuid = Model.ListingGUIDFilter;
    var currentUserIdText = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var isCurrentUserGuid = Guid.TryParse(currentUserIdText, out var currentUserId);
    var currentReturnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    var photoCount = Model.ListingImages.Count;
    var addressMapQuery = $"{Model.ListingCard?.Address} {Model.ListingCard?.CityName} {Model.ListingCard?.ProvinceName} {Model.ListingCard?.PostalCode}".Trim();
    var addressMapUrl = string.IsNullOrWhiteSpace(addressMapQuery)
    ? string.Empty
    : $"https://www.google.com/maps?q={Uri.EscapeDataString(addressMapQuery)}";
    var businessYellowPageDetailSliderWaitSeconds = ViewData["BusinessYellowPageDetailSliderWaitSeconds"] as int? ?? 2;
    var businessYellowPageDetailAdSlidingInterval = ViewData["BusinessYellowPageDetailAdSlidingInterval"] as int? ?? 5;
    var businessYellowPageDetailAdSliderFadingMode = ViewData["BusinessYellowPageDetailAdSliderFadingMode"]?.ToString() ??
    "homeAdFade";
    var businessYellowPageDetailAdPixelResolveTransitionPeriodMiliSeconds =
    ViewData["BusinessYellowPageDetailAdPixelResolveTransitionPeriodMiliSeconds"] as int? ?? 1000;
    var businessYellowPageDetailAdFadeTransitionMilliSeconds =
    ViewData["BusinessYellowPageDetailAdFadeTransitionMilliSeconds"] as int? ?? 450;
    var businessYellowPageDetailSlideTransitionMilliSeconds =
    ViewData["BusinessYellowPageDetailSlideTransitionMilliSeconds"] as int? ?? 650;
    var businessYellowPageDetailAdSlideDistancePercent = ViewData["BusinessYellowPageDetailAdSlideDistancePercent"] as int?
    ?? 8;
    var businessYellowPageDetailAdTransitionEasing = ViewData["BusinessYellowPageDetailAdTransitionEasing"]?.ToString() ??
    "ease-in-out";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.css" />
<style>
    .cropper-point.point-n,
    .cropper-point.point-e,
    .cropper-point.point-s,
    .cropper-point.point-w {
        width: 18px !important;
        height: 18px !important;
        opacity: 1 !important;
    }

    .cropper-point.point-n,
    .cropper-point.point-s {
        margin-left: -9px !important;
    }

    .cropper-point.point-e,
    .cropper-point.point-w {
        margin-top: -9px !important;
    }

    .business-yellow-page-detail-slider-wrapper {
        width: 100%;
        height: clamp(120px, 14vw, 190px);
        overflow: hidden;
        background-color: var(--bs-body-bg);
        border: 1px solid var(--bs-border-color);
        border-radius: 0;
        padding: 5px;
        box-sizing: border-box;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .business-yellow-page-detail-slider-link {
        display: block;
        width: 100%;
        height: 100%;
    }

    .business-yellow-page-detail-slider-image {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: contain;
        opacity: 1;
        will-change: opacity, transform, filter;
    }

    .sales-specials-scroller {
        overflow-x: auto;
        overflow-y: hidden;
        -webkit-overflow-scrolling: touch;
    }

    .sales-specials-track {
        display: flex;
        flex-wrap: nowrap;
        gap: 0.75rem;
        min-height: 1px;
    }

    .sales-specials-item {
        flex: 0 0 200px;
        width: 200px;
    }

    .sales-specials-thumb-link {
        display: block;
        width: 200px;
        height: 147px;
        border: 1px solid var(--bs-border-color);
        background-color: #f8f9fa;
        text-decoration: none;
    }

    .sales-specials-thumb {
        width: 100%;
        height: 100%;
        object-fit: contain;
        display: block;
    }

    .sales-specials-title {
        margin-top: 0.35rem;
        font-size: 0.85rem;
        line-height: 1.2;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .sales-specials-summary {
        margin-top: 0.35rem;
        font-size: 0.85rem;
        line-height: 1.2;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        word-break: break-word;
    }

    .sales-specials-price-original {
        text-decoration: line-through;
    }

    .sales-specials-price-sale {
        color: var(--bs-danger);
        font-weight: 600;
    }

    .fancy-cursive-title {
        font-family: "Brush Script MT", "Segoe Script", "Lucida Handwriting", cursive;
        font-weight: 700;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Business Yellow Page Details</h1>
    <a asp-action="Create" asp-route-listingGuid="@listingGuid" class="btn btn-primary">Create New</a>
</div>

@if (TempData["MessageSuccess"] is string messageSuccess && !string.IsNullOrWhiteSpace(messageSuccess))
{
    <div class="alert alert-success">@messageSuccess</div>
}

@if (TempData["MessageError"] is string messageError && !string.IsNullOrWhiteSpace(messageError))
{
    <div class="alert alert-danger">@messageError</div>
}

@if (Model.ListingCard is not null)
{
    var isOwnerListing = isCurrentUserGuid && Model.ListingCard.UserId != Guid.Empty && currentUserId ==
    Model.ListingCard.UserId;
    var ownListingNoticeId = $"ownListingNotice_{Model.ListingCard.ListingGUID:N}";
    var messageModalId = $"sendMessageModal_{Model.ListingCard.ListingGUID:N}";
    var defaultMessageSubject = $"Message about: {Model.ListingCard.Subject}";

    <div class="card shadow-sm mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <strong>Listing</strong>
                @if (isCurrentUserGuid)
                {
                    @if (Model.IsFavorited)
                    {
                        <form method="post" asp-action="Unfavorite" asp-route-listingGuid="@Model.ListingCard.ListingGUID"
                              class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="returnUrl" value="@currentReturnUrl" />
                            <button type="submit" class="btn btn-link p-0 text-danger fs-4 text-decoration-none"
                                    title="Remove from favorites" aria-label="Remove from favorites">♥</button>
                        </form>
                    }
                    else
                    {
                        <form method="post" asp-action="Favorite" asp-route-listingGuid="@Model.ListingCard.ListingGUID"
                              class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="returnUrl" value="@currentReturnUrl" />
                            <button type="submit" class="btn btn-link p-0 text-primary fs-4 text-decoration-none"
                                    title="Add to favorites" aria-label="Add to favorites">♡</button>
                        </form>
                    }
                }
            </div>
            <div class="d-flex align-items-center gap-2 flex-wrap justify-content-end">
                <a href="#" class="btn btn-link btn-sm p-0 send-message-link" data-message-modal-id="@messageModalId"
                       data-listing-guid="@Model.ListingCard.ListingGUID.ToString("N")"
                       data-is-owner="@isOwnerListing.ToString().ToLowerInvariant()" data-notice-id="@ownListingNoticeId">
                    Message Business
                </a>
                <span id="@ownListingNoticeId" class="small text-muted d-none">You cannot message your own listing.</span>
                @if (Model.CanManageFocusedListing && Model.ListingImages.Count < 15)
                {
                    <button type="button" class="btn btn-sm btn-outline-primary" id="addPhotoButton">Add Photo</button>
                }
            </div>
        </div>
        <div class="card-body">
            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <strong>Photos (@photoCount/15)</strong>
                </div>
                @if (!Model.ListingImages.Any())
                {
                    <div class="text-muted">No photos found for this listing.</div>
                }
                else
                {
                    <div class="row g-2">
                        @foreach (var image in Model.ListingImages.Select((value, index) => new { value, index }))
                        {
                            var thumbnailUrl = !string.IsNullOrWhiteSpace(image.value.ThumbnailURL) ? image.value.ThumbnailURL :
                            image.value.ImageURL;
                            var fullImageUrl = !string.IsNullOrWhiteSpace(image.value.ImageURL) ? image.value.ImageURL :
                            image.value.ThumbnailURL;
                            <div class="col-md-2 col-sm-4 col-6">
                                <div class="card h-100">
                                    <button type="button" class="btn p-0 border-0 text-start view-listing-photo"
                                            data-index="@image.index" data-image-url="@fullImageUrl"
                                            data-image-title="@image.value.Title">
                                        <img src="@thumbnailUrl" class="card-img-top" alt="@image.value.Title"
                                             style="height: 160px; object-fit: contain; background-color: #f8f9fa;" />
                                    </button>
                                    <div class="card-body p-2">
                                        <div class="small text-truncate">@(string.IsNullOrWhiteSpace(image.value.Title) ? "Photo" :
                                                                            image.value.Title)</div>
                                            @if (Model.CanManageFocusedListing)
                                            {
                                                <div class="d-flex gap-1 mt-1 flex-wrap">
                                                    <button type="button" class="btn btn-sm btn-outline-secondary edit-photo-button"
                                                            data-listing-image-guid="@image.value.ListingImageGUID"
                                                            data-title="@image.value.Title" data-sort-order="@image.value.SorOrder"
                                                            data-image-url="@fullImageUrl">Edit Photo</button>
                                                    <form method="post" asp-action="DeletePhoto"
                                                          asp-route-listingGuid="@Model.ListingCard.ListingGUID"
                                                          asp-route-listingImageGuid="@image.value.ListingImageGUID"
                                                          onsubmit="return confirm('Delete this photo?');">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                                    </form>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="row g-2">
                    <div class="col-md-6"><strong>Subject:</strong> @Model.ListingCard.Subject</div>
                    <div class="col-12"><strong>Description:</strong> @Model.ListingCard.Description</div>
                    <div class="col-md-4"><strong>Category:</strong> @Model.ListingCard.CategoryName</div>
                    <div class="col-md-4"><strong>Subcategory:</strong> @Model.ListingCard.SubcategoryName</div>
                    <div class="col-md-4"><strong>Province:</strong> @Model.ListingCard.ProvinceName</div>
                    <div class="col-md-4"><strong>City:</strong> @Model.ListingCard.CityName</div>
                    <div class="col-md-4"><strong>KeyWords:</strong> @Model.ListingCard.KeyWords</div>
                    <div class="col-md-4">
                        <strong>Address:</strong> @Model.ListingCard.Address
                        @if (!string.IsNullOrWhiteSpace(Model.ListingCard.Address) && !string.IsNullOrWhiteSpace(addressMapUrl))
                        {
                            <a href="@addressMapUrl" target="_blank" rel="noopener noreferrer" class="ms-2">Google map</a>
                        }
                    </div>
                    <div class="col-md-4">
                        <strong>Postal Code:</strong> @Model.ListingCard.PostalCode
                        @if (!string.IsNullOrWhiteSpace(Model.ListingCard.PostalCode))
                        {
                            <a href="#" class="ms-2 open-google-map" data-postal-code="@Model.ListingCard.PostalCode">Google map</a>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-lg-6 col-md-6 col-12">
                <div id="businessYellowPageDetailSliderWrapperLeft" class="business-yellow-page-detail-slider-wrapper d-none"
                     aria-label="Business yellow page ads left slider">
                    <a id="businessYellowPageDetailSliderLinkLeft" href="#" target="_blank" rel="noopener noreferrer"
                           class="business-yellow-page-detail-slider-link">
                        <img id="businessYellowPageDetailSliderImageLeft" class="business-yellow-page-detail-slider-image"
                             src="" alt="Business yellow page ad left" />
                    </a>
                </div>
            </div>
            <div class="col-lg-6 col-md-6 col-12">
                <div id="businessYellowPageDetailSliderWrapperRight" class="business-yellow-page-detail-slider-wrapper d-none"
                     aria-label="Business yellow page ads right slider">
                    <a id="businessYellowPageDetailSliderLinkRight" href="#" target="_blank" rel="noopener noreferrer"
                           class="business-yellow-page-detail-slider-link">
                        <img id="businessYellowPageDetailSliderImageRight" class="business-yellow-page-detail-slider-image"
                             src="" alt="Business yellow page ad right" />
                    </a>
                </div>
            </div>
        </div>

        <div class="card shadow-sm mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>Business Details</strong>
                @if (Model.CanManageFocusedListing)
                {
                    @if (Model.HasExistingFocusDetail && Model.FocusDetail?.BusinessYellowPageDetailGUID is Guid detailId)
                    {
                        <span>
                            <a asp-action="Edit" asp-route-id="@detailId">Edit</a>
                            <span> | </span>
                            <a asp-action="Delete" asp-route-id="@detailId">Delete</a>
                        </span>
                    }
                    else
                    {
                        <a asp-action="Create" asp-route-listingGuid="@Model.ListingCard.ListingGUID">Create New</a>
                    }
                }
            </div>
            <div class="card-body">
                @if (!Model.HasExistingFocusDetail || Model.FocusDetail is null)
                {
                    <div class="text-muted">No business details found.</div>
                }
                else
                {
                    var businessHourLines = (Model.FocusDetail.BusinessHours ?? string.Empty)
                    .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                    .Where(item => !string.IsNullOrWhiteSpace(item))
                    .ToList();

                    <div class="row g-2">
                        <div class="col-lg-6">
                            <strong>Business Hours:</strong>
                            @if (businessHourLines.Count == 0)
                            {
                                <span>@Model.FocusDetail.BusinessHours</span>
                            }
                            else
                            {
                                <div>
                                    @foreach (var line in businessHourLines)
                                    {
                                        <div>@line</div>
                                    }
                                </div>
                            }
                        </div>
                        <div class="col-lg-6"><strong>Business Style:</strong> @Model.FocusDetail.BusinessStyle</div>
                        <div class="col-lg-6"><strong>Products And Services:</strong> @Model.FocusDetail.ProductsAndServices</div>
                        <div class="col-lg-6"><strong>Specialties:</strong> @Model.FocusDetail.Specialties</div>
                        <div class="col-lg-6"><strong>Languages Spoken:</strong> @Model.FocusDetail.LanguagesSpoken</div>
                        <div class="col-lg-6"><strong>General Before Tax Pay Per Person:</strong>
                            @Model.FocusDetail.GeneralBeforeTaxPayPerPerson</div>
                            <div class="col-lg-6"><strong>Method Of Payments:</strong> @Model.FocusDetail.MethodOfPayments</div>
                            <div class="col-lg-6"><strong>How To Get There:</strong> @Model.FocusDetail.HowToGetThere</div>
                            <div class="col-lg-6"><strong>Web Site URL:</strong>
                                @if (!string.IsNullOrWhiteSpace(Model.FocusDetail.WebSiteURL))
                                {
                                    <a href="@Model.FocusDetail.WebSiteURL" target="_blank"
                                       rel="noopener noreferrer">@Model.FocusDetail.WebSiteURL</a>
                                }
                            </div>
                            <div class="col-lg-6"><strong>Active:</strong> @Model.FocusDetail.ActiveInd</div>
                            <div class="col-12"><strong>Additional Info:</strong> @Model.FocusDetail.AdditionalInfo</div>
                        </div>
                    }
                </div>
            </div>

            <div class="card shadow-sm mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>Sales &amp; Specials</strong>
                    @if (Model.CanManageFocusedListing)
                    {
                        <button type="button" class="btn btn-sm btn-outline-primary" id="salesSpecialsAddPhotoButton">Add Photo</button>
                    }
                </div>
                <div class="card-body">
                    <div class="small text-muted mb-2" id="salesSpecialsCountLabel">Photos (0/50)</div>
                    <div id="salesSpecialsLoadingState" class="text-muted">Loading sales &amp; specials...</div>
                    <div id="salesSpecialsEmptyState" class="text-muted d-none">No sales &amp; specials found.</div>
                    <div id="salesSpecialsScroller" class="sales-specials-scroller d-none">
                        <div id="salesSpecialsTrack" class="sales-specials-track"></div>
                    </div>
                </div>
            </div>

            <div class="modal fade" id="salesSpecialsViewerModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-fullscreen">
                    <div class="modal-content h-100">
                        <div class="modal-body d-flex flex-column overflow-hidden">
                            <div class="d-flex align-items-center gap-2 mb-2 flex-shrink-0">
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                <h5 class="modal-title mb-0">Sales &amp; Specials Photo Viewer</h5>
                                <span id="salesSpecialsViewerTitleValue"
                                      class="flex-grow-1 text-center fs-5 fancy-cursive-title"></span>
                                <span class="text-muted" title="drag to pan and scroll to zoom"
                                      aria-label="drag to pan and scroll to zoom">ⓘ</span>
                                <div class="btn-group">
                                    <button type="button" id="salesSpecialsViewerPrev"
                                            class="btn btn-outline-secondary btn-sm">Prev</button>
                                    <button type="button" id="salesSpecialsViewerZoomOut"
                                            class="btn btn-outline-secondary btn-sm">-</button>
                                    <button type="button" id="salesSpecialsViewerZoomReset"
                                            class="btn btn-outline-secondary btn-sm">100%</button>
                                    <button type="button" id="salesSpecialsViewerZoomIn"
                                            class="btn btn-outline-secondary btn-sm">+</button>
                                    <button type="button" id="salesSpecialsViewerNext"
                                            class="btn btn-outline-secondary btn-sm">Next</button>
                                </div>
                            </div>
                            <div class="row g-2 mb-2 flex-shrink-0">
                                <div class="col-lg-2 col-md-4 col-sm-6"><strong>Price:</strong> <span
                                    id="salesSpecialsViewerPrice"></span></div>
                                    <div class="col-lg-2 col-md-4 col-sm-6"><strong>SalePrice:</strong> <span
                                        id="salesSpecialsViewerSalePrice" class="text-danger fw-semibold"></span></div>
                                        <div class="col-lg-2 col-md-4 col-sm-6"><strong>PercentOff:</strong> <span
                                            id="salesSpecialsViewerPercentOff"></span></div>
                                            <div class="col-lg-2 col-md-4 col-sm-6"><strong>SaleBegin:</strong> <span
                                                id="salesSpecialsViewerSaleBegin"></span></div>
                                                <div class="col-lg-2 col-md-4 col-sm-6"><strong>SaleEnd:</strong> <span
                                                    id="salesSpecialsViewerSaleEnd"></span></div>
                                                </div>
                                                <div class="mb-2 flex-shrink-0"><strong>Description:</strong> <span
                                                    id="salesSpecialsViewerDescription"></span></div>
                                                    <div class="border rounded d-flex justify-content-center align-items-center overflow-hidden flex-grow-1"
                                                         style="min-height: 0; background-color: #e9ecef;">
                                                        <img id="salesSpecialsViewerMainImage" alt="Sales specials photo" draggable="false"
                                                             style="width: 100%; height: 100%; object-fit: contain; transform-origin: center center; transition: transform .15s ease; cursor: grab; touch-action: none; user-select: none;" />
                                                    </div>
                                                    <div class="mt-2 d-flex flex-nowrap justify-content-center gap-2 overflow-auto pb-1 flex-shrink-0"
                                                         id="salesSpecialsViewerThumbnailStrip" style="min-height: 84px;"></div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    @if (Model.CanManageFocusedListing)
                                    {
                                        <form id="salesSpecialsUpsertForm" method="post" asp-action="UpsertSalesSpecialPhoto"
                                              asp-route-listingGuid="@Model.ListingCard.ListingGUID" class="d-none">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" id="salesSpecialsImageGuidInput" name="salesSpecialsImageGuid" />
                                            <input type="hidden" id="salesSpecialsTitleInput" name="title" />
                                            <input type="hidden" id="salesSpecialsSortOrderInput" name="sortOrder" />
                                            <input type="hidden" id="salesSpecialsPriceInput" name="price" />
                                            <input type="hidden" id="salesSpecialsSalePriceInput" name="salePrice" />
                                            <input type="hidden" id="salesSpecialsPercentOffInput" name="percentOff" />
                                            <input type="hidden" id="salesSpecialsSaleBeginInput" name="saleBegin" />
                                            <input type="hidden" id="salesSpecialsSaleEndInput" name="saleEnd" />
                                            <input type="hidden" id="salesSpecialsDescriptionInput" name="description" />
                                            <input type="hidden" id="salesSpecialsCroppedDataInput" name="croppedImageData" />
                                            <input type="hidden" id="salesSpecialsThumbnailDataInput" name="thumbnailImageData" />
                                        </form>

                                        <form id="salesSpecialsDeleteFormTemplate" method="post" class="d-none">
                                            @Html.AntiForgeryToken()
                                        </form>

                                        <input type="file" id="salesSpecialsFileInput" class="d-none" accept="image/*" />

                                        <div class="modal fade" id="salesSpecialsCropModal" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog modal-fullscreen">
                                                <div class="modal-content h-100">
                                                    <div class="modal-body pt-2 pb-2 px-3 d-flex flex-column overflow-hidden">
                                                        <div class="row g-2 align-items-center mb-2 flex-shrink-0">
                                                            <div class="col-auto">
                                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                            </div>
                                                            <div class="col-auto">
                                                                <button type="button" class="btn btn-sm btn-outline-secondary text-nowrap"
                                                                        data-bs-dismiss="modal">Cancel</button>
                                                            </div>
                                                            <div class="col-auto">
                                                                <button type="button" id="salesSpecialsSaveCroppedImageButton"
                                                                        class="btn btn-sm btn-primary text-nowrap">Save Clipped Image</button>
                                                            </div>
                                                            <div class="col-auto d-flex align-items-center">
                                                                <h5 class="modal-title mb-0">Clip Sales &amp; Specials Photo</h5>
                                                            </div>
                                                            <div class="col-lg-4 d-flex align-items-center gap-2">
                                                                <label for="salesSpecialsTitleEditor" class="form-label mb-0 text-nowrap">Title</label>
                                                                <input id="salesSpecialsTitleEditor" type="text" class="form-control form-control-sm"
                                                                       maxlength="50" />
                                                            </div>
                                                            <div class="col-lg-2 d-flex align-items-center gap-2">
                                                                <label for="salesSpecialsPriceEditor" class="form-label mb-0 text-nowrap">Price</label>
                                                                <input id="salesSpecialsPriceEditor" type="number" class="form-control form-control-sm"
                                                                       step="0.01" min="0" />
                                                            </div>
                                                            <div class="col-lg-2 d-flex align-items-center gap-2">
                                                                <label for="salesSpecialsSalePriceEditor" class="form-label mb-0 text-nowrap">SalePrice</label>
                                                                <input id="salesSpecialsSalePriceEditor" type="number" class="form-control form-control-sm"
                                                                       step="0.01" min="0" />
                                                            </div>
                                                            <div class="col-lg-2 d-flex align-items-center gap-2">
                                                                <label for="salesSpecialsPercentOffEditor"
                                                                       class="form-label mb-0 text-nowrap">PercentOff</label>
                                                                <input id="salesSpecialsPercentOffEditor" type="text" class="form-control form-control-sm"
                                                                       maxlength="10" />
                                                            </div>
                                                            <div class="col-lg-2 d-flex align-items-center gap-2">
                                                                <label for="salesSpecialsSortOrderEditor" class="form-label mb-0 text-nowrap">SortOrder</label>
                                                                <input id="salesSpecialsSortOrderEditor" type="number" class="form-control form-control-sm"
                                                                       min="0" max="9999" step="1" value="0" />
                                                            </div>
                                                            <div class="col-lg-3 d-flex align-items-center gap-2">
                                                                <label for="salesSpecialsSaleBeginEditor" class="form-label mb-0 text-nowrap">SaleBegin</label>
                                                                <input id="salesSpecialsSaleBeginEditor" type="date" class="form-control form-control-sm" />
                                                            </div>
                                                            <div class="col-lg-3 d-flex align-items-center gap-2">
                                                                <label for="salesSpecialsSaleEndEditor" class="form-label mb-0 text-nowrap">SaleEnd</label>
