                                                    viewerPercentOff.textContent = item.percentOff || "";
                                                    }
                                                    if (viewerSaleBegin) {
                                                    viewerSaleBegin.textContent = formatDate(item.saleBegin);
                                                    }
                                                    if (viewerSaleEnd) {
                                                    viewerSaleEnd.textContent = formatDate(item.saleEnd);
                                                    }
                                                    if (viewerDescription) {
                                                    viewerDescription.textContent = item.description || "";
                                                    }
                                                    renderViewerThumbs();
                                                    resetViewerTransform();
                                                    };

                                                    const openViewer = (index) => {
                                                    if (specialsItems.length === 0) {
                                                    return;
                                                    }
                                                    updateViewer(index);
                                                    const modal = getViewerModal();
                                                    modal?.show();
                                                    };

                                                    if (viewerMainImage && viewerPrev && viewerNext && viewerZoomIn && viewerZoomOut && viewerZoomReset) {
                                                    viewerPrev.addEventListener("click", () => updateViewer(viewerIndex - 1));
                                                    viewerNext.addEventListener("click", () => updateViewer(viewerIndex + 1));
                                                    viewerZoomIn.addEventListener("click", () => setViewerZoom(viewerZoom + 0.2));
                                                    viewerZoomOut.addEventListener("click", () => setViewerZoom(viewerZoom - 0.2));
                                                    viewerZoomReset.addEventListener("click", resetViewerTransform);
                                                    viewerMainImage.addEventListener("load", resetViewerTransform);
                                                    viewerMainImage.addEventListener("wheel", (event) => {
                                                    event.preventDefault();
                                                    setViewerZoom(viewerZoom + (event.deltaY < 0 ? 0.1 : -0.1));
                                                    }, { passive: false });
                                                    viewerMainImage.addEventListener("contextmenu", (event) => {
                                                    event.preventDefault();
                                                    });
                                                    viewerMainImage.addEventListener("pointerdown", (event) => {
                                                    if (event.pointerType === "mouse" && event.button !== 0 && event.button !== 2) {
                                                    return;
                                                    }
                                                    if (viewerZoom <= 1) {
                                                    return;
                                                    }
                                                    event.preventDefault();
                                                    viewerDragging = true;
                                                    viewerLastX = event.clientX;
                                                    viewerLastY = event.clientY;
                                                    viewerMainImage.style.cursor = "grabbing";
                                                    viewerMainImage.setPointerCapture(event.pointerId);
                                                    });
                                                    viewerMainImage.addEventListener("pointermove", (event) => {
                                                    if (!viewerDragging) {
                                                    return;
                                                    }
                                                    const deltaX = event.clientX - viewerLastX;
                                                    const deltaY = event.clientY - viewerLastY;
                                                    viewerLastX = event.clientX;
                                                    viewerLastY = event.clientY;
                                                    viewerTranslateX += deltaX;
                                                    viewerTranslateY += deltaY;
                                                    applyViewerZoom();
                                                    });
                                                    const stopDragging = (event) => {
                                                    if (!viewerDragging) {
                                                    return;
                                                    }
                                                    viewerDragging = false;
                                                    viewerMainImage.style.cursor = viewerZoom > 1 ? "grab" : "default";
                                                    if (typeof event.pointerId !== "undefined") {
                                                    viewerMainImage.releasePointerCapture(event.pointerId);
                                                    }
                                                    };
                                                    viewerMainImage.addEventListener("pointerup", stopDragging);
                                                    viewerMainImage.addEventListener("pointercancel", stopDragging);
                                                    viewerMainImage.addEventListener("pointerleave", stopDragging);
                                                    window.addEventListener("resize", applyViewerZoom);
                                                    }

                                                    const loadSpecials = async () => {
                                                    try {
                                                    const response = await fetch(fetchUrl, { method: "GET" });
                                                    if (!response.ok) {
                                                    showEmpty("Failed to load sales & specials.");
                                                    return;
                                                    }
                                                    const payload = await response.json();
                                                    if (!Array.isArray(payload)) {
                                                    showEmpty("No sales & specials found.");
                                                    return;
                                                    }
                                                    specialsItems = payload
                                                    .map(normalizeItem)
                                                    .filter(item => item && item.salesSpecialsImageGUID && (item.thumbnailURL || item.imageURL))
                                                    .slice(0, 50);
                                                    renderTrack();
                                                    } catch {
                                                    showEmpty("Failed to load sales & specials.");
                                                    }
                                                    };

                                                    let sourceImageDataUrl = "";
                                                    let workingImageDataUrl = "";
                                                    let cropper = null;
                                                    let currentAspectRatio = 3 / 2;
                                                    let activeEditTool = "crop";
                                                    let isDrawing = false;
                                                    let lastPoint = null;
                                                    let editHistory = [];
                                                    let redoHistory = [];
                                                    const editContext = editCanvas?.getContext("2d");
                                                    const MAX_THUMBNAIL_BYTES = 30 * 1024;
                                                    const MAX_FULL_IMAGE_BYTES = 3 * 1024 * 1024;

                                                    if (canManageSpecials && addPhotoButton && fileInput && cropModalElement) {
                                                    const cropModal = new bootstrap.Modal(cropModalElement);

                                                    const syncBrushSizeValue = () => {
                                                    if (brushSizeInput && brushSizeValue) {
                                                    brushSizeValue.textContent = brushSizeInput.value;
                                                    }
                                                    };
                                                    syncBrushSizeValue();
                                                    brushSizeInput.addEventListener("input", syncBrushSizeValue);

                                                    const getAspectRatio = (value) => {
                                                    if (value === "custom") {
                                                    return Number.NaN;
                                                    }
                                                    const parts = (value || "").split(":");
                                                    if (parts.length !== 2) {
                                                    return 3 / 2;
                                                    }
                                                    const width = Number(parts[0]);
                                                    const height = Number(parts[1]);
                                                    if (!Number.isFinite(width) || !Number.isFinite(height) || width <= 0 || height <= 0) {
                                                    return 3 / 2;
                                                    }
                                                    return width / height;
                                                    };

                                                    const getCanvasSize = (aspectRatio) => {
                                                    if (Math.abs(aspectRatio - (16 / 9)) < 0.001) {
                                                    return { width: 1280, height: 720 };
                                                    }
                                                    const base = 800;
                                                    if (aspectRatio >= 1) {
                                                    return { width: base, height: Math.round(base / aspectRatio) };
                                                    }
                                                    return { width: Math.round(base * aspectRatio), height: base };
                                                    };

                                                    const createCropper = () => {
                                                    cropper?.destroy();
                                                    cropper = new Cropper(cropperImage, {
                                                    aspectRatio: currentAspectRatio,
                                                    viewMode: 1,
                                                    autoCropArea: 1,
                                                    dragMode: "move"
                                                    });
                                                    };

                                                    const setToolButtonStyles = () => {
                                                    [[cropModeButton, "crop"], [penModeButton, "pen"], [eraseModeButton, "erase"], [textModeButton, "text"]]
                                                    .forEach(([button, mode]) => {
                                                    const isActive = activeEditTool === mode;
                                                    button.classList.toggle("btn-primary", isActive);
                                                    button.classList.toggle("btn-outline-secondary", !isActive);
                                                    });
                                                    };

                                                    const getCanvasPoint = (event) => {
                                                    const rect = editCanvas.getBoundingClientRect();
                                                    const scaleX = editCanvas.width / rect.width;
                                                    const scaleY = editCanvas.height / rect.height;
                                                    return { x: (event.clientX - rect.left) * scaleX, y: (event.clientY - rect.top) * scaleY };
                                                    };

                                                    const drawStroke = (fromPoint, toPoint) => {
                                                    editContext.lineCap = "round";
                                                    editContext.lineJoin = "round";
                                                    const brushSize = Number.parseFloat(brushSizeInput.value);
                                                    editContext.lineWidth = Number.isFinite(brushSize) ? brushSize : 6;
                                                    editContext.globalCompositeOperation = activeEditTool === "erase" ? "destination-out" : "source-over";
                                                    editContext.strokeStyle = colorInput.value || "#ff0000";
                                                    editContext.beginPath();
                                                    editContext.moveTo(fromPoint.x, fromPoint.y);
                                                    editContext.lineTo(toPoint.x, toPoint.y);
                                                    editContext.stroke();
                                                    editContext.globalCompositeOperation = "source-over";
                                                    };

                                                    const fitCanvasDisplaySize = () => {
                                                    if (!editCanvasContainer || !editCanvas.width || !editCanvas.height) {
                                                    return;
                                                    }
                                                    const containerWidth = Math.max(1, editCanvasContainer.clientWidth);
                                                    const containerHeight = Math.max(1, editCanvasContainer.clientHeight);
                                                    const fitRatio = Math.min(containerWidth / editCanvas.width, containerHeight / editCanvas.height);
                                                    editCanvas.style.width = `${Math.max(1, Math.floor(editCanvas.width * fitRatio))}px`;
                                                    editCanvas.style.height = `${Math.max(1, Math.floor(editCanvas.height * fitRatio))}px`;
                                                    };

                                                    const estimateDataUrlSize = (dataUrl) => {
                                                    const payload = (dataUrl || "").split(",")[1] || "";
                                                    return Math.ceil((payload.length * 3) / 4);
                                                    };

                                                    const buildThumbnailDataUrl = (sourceCanvas) => {
                                                    const thumbCanvas = document.createElement("canvas");
                                                    const thumbContext = thumbCanvas.getContext("2d");
                                                    if (!thumbContext || !sourceCanvas.width || !sourceCanvas.height) {
                                                    return sourceCanvas.toDataURL("image/jpeg", 0.82);
                                                    }
                                                    let width = sourceCanvas.width;
                                                    let height = sourceCanvas.height;
                                                    const maxSide = 720;
                                                    const maxCurrentSide = Math.max(width, height);
                                                    if (maxCurrentSide > maxSide) {
                                                    const scale = maxSide / maxCurrentSide;
                                                    width = Math.max(1, Math.round(width * scale));
                                                    height = Math.max(1, Math.round(height * scale));
                                                    }
                                                    thumbCanvas.width = width;
                                                    thumbCanvas.height = height;
                                                    const render = () => {
                                                    thumbContext.clearRect(0, 0, width, height);
                                                    thumbContext.drawImage(sourceCanvas, 0, 0, width, height);
                                                    };
                                                    render();
                                                    let quality = 0.82;
                                                    let thumbnailDataUrl = thumbCanvas.toDataURL("image/jpeg", quality);
                                                    let guard = 0;
                                                    while (estimateDataUrlSize(thumbnailDataUrl) > MAX_THUMBNAIL_BYTES && guard < 20) {
                                                    guard += 1;
                                                    if (quality > 0.45) {
                                                    quality -= 0.07;
                                                    } else {
                                                    width = Math.max(160, Math.round(width * 0.9));
                                                    height = Math.max(160, Math.round(height * 0.9));
                                                    thumbCanvas.width = width;
                                                    thumbCanvas.height = height;
                                                    }
                                                    render();
                                                    thumbnailDataUrl = thumbCanvas.toDataURL("image/jpeg", quality);
                                                    }
                                                    return thumbnailDataUrl;
                                                    };

                                                    const buildCroppedImageDataUrl = (sourceCanvas, maxBytes = MAX_FULL_IMAGE_BYTES) => {
                                                    let width = sourceCanvas.width;
                                                    let height = sourceCanvas.height;
                                                    let quality = 0.9;
                                                    const workCanvas = document.createElement("canvas");
                                                    const workContext = workCanvas.getContext("2d");
                                                    if (!workContext || !width || !height) {
                                                    return sourceCanvas.toDataURL("image/jpeg", quality);
                                                    }
                                                    const render = () => {
                                                    workCanvas.width = width;
                                                    workCanvas.height = height;
                                                    workContext.clearRect(0, 0, width, height);
                                                    workContext.drawImage(sourceCanvas, 0, 0, width, height);
                                                    };
                                                    render();
                                                    let dataUrl = workCanvas.toDataURL("image/jpeg", quality);
                                                    let guard = 0;
                                                    while (estimateDataUrlSize(dataUrl) > maxBytes && guard < 24) {
                                                    guard += 1;
                                                    if (quality > 0.45) {
                                                    quality -= 0.07;
                                                    } else {
                                                    width = Math.max(640, Math.round(width * 0.9));
                                                    height = Math.max(640, Math.round(height * 0.9));
                                                    }
                                                    render();
                                                    dataUrl = workCanvas.toDataURL("image/jpeg", quality);
                                                    }
                                                    return dataUrl;
                                                    };

                                                    const loadImageToCanvas = (imageDataUrl, onLoaded = null) => {
                                                    if (!imageDataUrl) {
                                                    return;
                                                    }
                                                    const image = new Image();
                                                    image.onload = () => {
                                                    editCanvas.width = image.naturalWidth;
                                                    editCanvas.height = image.naturalHeight;
                                                    editContext.clearRect(0, 0, editCanvas.width, editCanvas.height);
                                                    editContext.drawImage(image, 0, 0, editCanvas.width, editCanvas.height);
                                                    fitCanvasDisplaySize();
                                                    if (typeof onLoaded === "function") {
                                                    onLoaded();
                                                    }
                                                    };
                                                    image.src = imageDataUrl;
                                                    };

                                                    const pushCanvasHistory = () => {
                                                    if (!editCanvas.width || !editCanvas.height) {
                                                    return;
                                                    }
                                                    const snapshot = editCanvas.toDataURL("image/png");
                                                    if (editHistory.length > 0 && editHistory[editHistory.length - 1] === snapshot) {
                                                    return;
                                                    }
                                                    editHistory.push(snapshot);
                                                    if (editHistory.length > 30) {
                                                    editHistory.shift();
                                                    }
                                                    };

                                                    const registerNewEdit = () => { pushCanvasHistory(); redoHistory = []; };

                                                    const undoCanvasEdit = () => {
                                                    if (editHistory.length <= 1) {
                                                    return;
                                                    }
                                                    redoHistory.push(editHistory[editHistory.length - 1]);
                                                    editHistory.pop();
                                                    const previousSnapshot = editHistory[editHistory.length - 1];
                                                    loadImageToCanvas(previousSnapshot);
                                                    };

                                                    const redoCanvasEdit = () => {
                                                    if (redoHistory.length === 0) {
                                                    return;
                                                    }
                                                    const nextSnapshot = redoHistory.pop();
                                                    if (!nextSnapshot) {
                                                    return;
                                                    }
                                                    editHistory.push(nextSnapshot);
                                                    loadImageToCanvas(nextSnapshot);
                                                    };

                                                    const showCropperImage = () => {
                                                    editCanvas.classList.add("d-none");
                                                    cropperImage.classList.remove("d-none");
                                                    cropperImage.src = workingImageDataUrl || sourceImageDataUrl;
                                                    if (cropperImage.complete) {
                                                    createCropper();
                                                    } else {
                                                    cropperImage.addEventListener("load", () => createCropper(), { once: true });
                                                    }
                                                    };

                                                    const applyCanvasEdits = () => {
                                                    if (editCanvas.classList.contains("d-none")) {
                                                    return;
                                                    }
                                                    workingImageDataUrl = editCanvas.toDataURL("image/png");
                                                    sourceImageDataUrl = workingImageDataUrl;
                                                    };

                                                    const switchToTool = (tool) => {
                                                    const previousTool = activeEditTool;
                                                    activeEditTool = tool;
                                                    setToolButtonStyles();
                                                    if (tool === "crop") {
                                                    applyCanvasEdits();
                                                    showCropperImage();
                                                    return;
                                                    }
                                                    cropper?.destroy();
                                                    cropper = null;
                                                    cropperImage.classList.add("d-none");
                                                    editCanvas.classList.remove("d-none");
                                                    if (previousTool === "crop" || !editCanvas.width || !editCanvas.height) {
                                                    loadImageToCanvas(workingImageDataUrl || sourceImageDataUrl, () => {
                                                    editHistory = [];
                                                    redoHistory = [];
                                                    pushCanvasHistory();
                                                    });
                                                    }
                                                    };

                                                    openEditor = (item) => {
                                                    sourceImageDataUrl = item?.imageURL || item?.thumbnailURL || "";
                                                    workingImageDataUrl = sourceImageDataUrl;
                                                    imageGuidInput.value = item?.salesSpecialsImageGUID || "";
                                                    titleEditor.value = item?.title || "";
                                                    sortOrderEditor.value = String(item?.sortOrder ?? (specialsItems.length + 1));
                                                    priceEditor.value = item?.price ?? "";
                                                    salePriceEditor.value = item?.salePrice ?? "";
                                                    percentOffEditor.value = item?.percentOff || "";
                                                    saleBeginEditor.value = formatDateInput(item?.saleBegin);
                                                    saleEndEditor.value = formatDateInput(item?.saleEnd);
                                                    descriptionEditor.value = item?.description || "";

                                                    thumbnailDataInput.value = "";
                                                    activeEditTool = "crop";
                                                    setToolButtonStyles();
                                                    editHistory = [];
                                                    redoHistory = [];
                                                    editCanvas.width = 0;
                                                    editCanvas.height = 0;
                                                    cropperImage.src = sourceImageDataUrl;
                                                    cropModal.show();
                                                    };

                                                    addPhotoButton.addEventListener("click", () => {
                                                    imageGuidInput.value = "";
                                                    titleEditor.value = "";
                                                    sortOrderEditor.value = String(specialsItems.length + 1);
                                                    priceEditor.value = "";
                                                    salePriceEditor.value = "";
                                                    percentOffEditor.value = "";
                                                    saleBeginEditor.value = "";
                                                    saleEndEditor.value = "";
                                                    descriptionEditor.value = "";
                                                    fileInput.click();
                                                    });

                                                    fileInput.addEventListener("change", () => {
                                                    const file = fileInput.files?.[0];
                                                    if (!file) {
                                                    return;
                                                    }
                                                    const reader = new FileReader();
                                                    reader.onload = (event) => {
                                                    const dataUrl = event.target?.result?.toString() || "";
                                                    openEditor({ imageURL: dataUrl, sortOrder: specialsItems.length + 1 });
                                                    };
                                                    reader.readAsDataURL(file);
                                                    fileInput.value = "";
                                                    });

                                                    cropModalElement.addEventListener("shown.bs.modal", () => {
                                                    if (!cropperImage.src) {
                                                    return;
                                                    }
                                                    if (activeEditTool === "crop") {
                                                    createCropper();
                                                    } else {
                                                    fitCanvasDisplaySize();
                                                    }
                                                    });

                                                    cropModalElement.addEventListener("hidden.bs.modal", () => {
                                                    cropper?.destroy();
                                                    cropper = null;
                                                    });

                                                    window.addEventListener("resize", () => {
                                                    if (activeEditTool !== "crop" && !editCanvas.classList.contains("d-none")) {
                                                    fitCanvasDisplaySize();
                                                    }
                                                    });

                                                    aspectRatioSelect.addEventListener("change", () => {
                                                    currentAspectRatio = getAspectRatio(aspectRatioSelect.value);
                                                    if (cropper) {
                                                    cropper.setAspectRatio(currentAspectRatio);
                                                    }
                                                    });

                                                    cropModeButton.addEventListener("click", () => switchToTool("crop"));
                                                    penModeButton.addEventListener("click", () => switchToTool("pen"));
                                                    eraseModeButton.addEventListener("click", () => switchToTool("erase"));
                                                    textModeButton.addEventListener("click", () => switchToTool("text"));
                                                    applyEditsButton.addEventListener("click", () => switchToTool("crop"));
                                                    undoEditButton.addEventListener("click", () => undoCanvasEdit());
                                                    redoEditButton.addEventListener("click", () => redoCanvasEdit());

                                                    editCanvas.addEventListener("pointerdown", (event) => {
                                                    if (activeEditTool === "text") {
                                                    const textValue = prompt("Enter text to add:");
                                                    if (!textValue) {
                                                    return;
                                                    }
                                                    const point = getCanvasPoint(event);
                                                    const fontSize = Number.parseInt(fontSizeInput.value, 10);
                                                    const resolvedFontSize = Number.isFinite(fontSize) ? Math.max(8, fontSize) : 24;
                                                    const selectedFont = fontSelect.value || "Arial, sans-serif";
                                                    editContext.globalCompositeOperation = "source-over";
                                                    editContext.fillStyle = colorInput.value || "#ff0000";
                                                    editContext.font = `${resolvedFontSize}px ${selectedFont}`;
                                                    editContext.fillText(textValue, point.x, point.y);
                                                    registerNewEdit();
                                                    return;
                                                    }
                                                    if (activeEditTool !== "pen" && activeEditTool !== "erase") {
                                                    return;
                                                    }
                                                    isDrawing = true;
                                                    lastPoint = getCanvasPoint(event);
                                                    editCanvas.setPointerCapture(event.pointerId);
                                                    });

                                                    editCanvas.addEventListener("pointermove", (event) => {
                                                    if (!isDrawing || !lastPoint) {
                                                    return;
                                                    }
                                                    const nextPoint = getCanvasPoint(event);
                                                    drawStroke(lastPoint, nextPoint);
                                                    lastPoint = nextPoint;
                                                    });

                                                    const stopDrawing = (event) => {
                                                    if (!isDrawing) {
                                                    return;
                                                    }
                                                    isDrawing = false;
                                                    lastPoint = null;
                                                    registerNewEdit();
                                                    if (typeof event.pointerId !== "undefined") {
                                                    editCanvas.releasePointerCapture(event.pointerId);
                                                    }
                                                    };
                                                    editCanvas.addEventListener("pointerup", stopDrawing);
                                                    editCanvas.addEventListener("pointerleave", stopDrawing);
                                                    editCanvas.addEventListener("pointercancel", stopDrawing);

                                                    saveCroppedImageButton.addEventListener("click", () => {
                                                    if (activeEditTool !== "crop") {
                                                    switchToTool("crop");
                                                    }
                                                    if (!cropper) {
                                                    return;
                                                    }
                                                    const canvas = Number.isFinite(currentAspectRatio)
                                                    ? (() => {
                                                    const canvasSize = getCanvasSize(currentAspectRatio);
                                                    return cropper.getCroppedCanvas({ width: canvasSize.width, height: canvasSize.height, imageSmoothingQuality: "high" });
                                                    })()
                                                    : cropper.getCroppedCanvas({ imageSmoothingQuality: "high" });

                                                    const fullImageDataUrl = buildCroppedImageDataUrl(canvas);
                                                    const thumbnailDataUrl = buildThumbnailDataUrl(canvas);

                                                    titleInput.value = titleEditor.value || "";
                                                    sortOrderInput.value = sortOrderEditor.value || "0";
                                                    priceInput.value = priceEditor.value || "";
                                                    salePriceInput.value = salePriceEditor.value || "";
                                                    percentOffInput.value = percentOffEditor.value || "";
                                                    saleBeginInput.value = saleBeginEditor.value || "";
                                                    saleEndInput.value = saleEndEditor.value || "";
                                                    descriptionInput.value = descriptionEditor.value || "";
                                                    croppedDataInput.value = fullImageDataUrl;
                                                    thumbnailDataInput.value = thumbnailDataUrl;

                                                    cropModal.hide();
                                                    upsertForm.submit();
                                                    });

                                                    setToolButtonStyles();
                                                    }

                                                    window.addEventListener("load", () => {
                                                    window.setTimeout(() => {
                                                    loadSpecials();
                                                    }, Math.max(0, waitSeconds) * 1000);
                                                    });

                                                    document.addEventListener("click", (event) => {
                                                    if (!canManageSpecials) {
                                                    return;
                                                    }
                                                    if (!(event.target instanceof Element)) {
                                                    return;
                                                    }
                                                    const editButton = event.target.closest("[data-sales-specials-edit-index]");
                                                    if (editButton) {
                                                    event.preventDefault();
                                                    event.stopPropagation();
                                                    const index = Number(editButton.getAttribute("data-sales-specials-edit-index"));
                                                    if (Number.isFinite(index) && specialsItems[index]) {
                                                    if (typeof openEditor === "function") {
                                                    openEditor(specialsItems[index]);
                                                    }
                                                    }
                                                    }
                                                    });
                                                    })();
                                                </script>
                                                <script>
                                                    (() => {
                                                    const editBrushSizeInput = document.getElementById("editBrushSizeInput");
                                                    const editBrushSizeValue = document.getElementById("editBrushSizeValue");
                                                    if (!editBrushSizeInput || !editBrushSizeValue) {
                                                    return;
                                                    }

                                                    const syncBrushSizeValue = () => {
                                                    editBrushSizeValue.textContent = editBrushSizeInput.value;
                                                    };

                                                    editBrushSizeInput.addEventListener("input", syncBrushSizeValue);
                                                    syncBrushSizeValue();
                                                    })();
                                                </script>
                                            }