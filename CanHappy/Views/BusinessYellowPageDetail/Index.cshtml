                                            @section Scripts {
                                                <partial name="_ValidationScriptsPartial" />
                                                <script src="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.js"></script>
                                                <script>
                                                    (() => {
                                                    const waitSeconds = @businessYellowPageDetailSliderWaitSeconds;
                                                    const slidingIntervalSeconds = @businessYellowPageDetailAdSlidingInterval;
                                                    const fadingMode = "@businessYellowPageDetailAdSliderFadingMode".trim().toLowerCase();
                                                    const pixelResolveTransitionMs = @businessYellowPageDetailAdPixelResolveTransitionPeriodMiliSeconds;
                                                    const fadeTransitionMs = @businessYellowPageDetailAdFadeTransitionMilliSeconds;
                                                    const slideTransitionMs = @businessYellowPageDetailSlideTransitionMilliSeconds;
                                                    const slideDistancePercent = @businessYellowPageDetailAdSlideDistancePercent;
                                                    const transitionEasing = "@businessYellowPageDetailAdTransitionEasing".trim() || "ease-in-out";
                                                    const requestUrl = "@Url.Action("DetailPageSliderAds", "BusinessYellowPageDetailPage", new { listingGuid = Model.ListingCard!.ListingGUID })";

                                                    const normalizeFadingMode = (mode) => {
                                                    if (mode === "fade" || mode === "homeadfade") {
                                                    return "homeadfade";
                                                    }

                                                    if (mode === "pixelresolve" || mode === "homeadpixelresolve") {
                                                    return "homeadpixelresolve";
                                                    }

                                                    if (mode === "homeadslidedown" || mode === "homeadslideup" || mode === "homeadslideleft" || mode === "homeadslideright") {
                                                    return mode;
                                                    }

                                                    return "homeadfade";
                                                    };

                                                    const normalizedFadingMode = normalizeFadingMode(fadingMode);

                                                    const getTransitionDuration = () => {
                                                    if (normalizedFadingMode === "homeadpixelresolve") {
                                                    return Math.max(100, pixelResolveTransitionMs);
                                                    }

                                                    if (normalizedFadingMode === "homeadfade") {
                                                    return Math.max(100, fadeTransitionMs);
                                                    }

                                                    return Math.max(100, slideTransitionMs);
                                                    };

                                                    const getOutKeyframes = () => {
                                                    switch (normalizedFadingMode) {
                                                    case "homeadpixelresolve":
                                                    return [
                                                    { opacity: 1, filter: "blur(0) saturate(1)", transform: "translate3d(0,0,0) scale(1)" },
                                                    { opacity: 0, filter: "blur(8px) saturate(0.8)", transform: "translate3d(0,0,0) scale(1.015)" }
                                                    ];
                                                    case "homeadslideleft":
                                                    return [
                                                    { opacity: 1, transform: "translate3d(0,0,0)" },
                                                    { opacity: 0, transform: `translate3d(-${slideDistancePercent}%,0,0)` }
                                                    ];
                                                    case "homeadslideright":
                                                    return [
                                                    { opacity: 1, transform: "translate3d(0,0,0)" },
                                                    { opacity: 0, transform: `translate3d(${slideDistancePercent}%,0,0)` }
                                                    ];
                                                    case "homeadslideup":
                                                    return [
                                                    { opacity: 1, transform: "translate3d(0,0,0)" },
                                                    { opacity: 0, transform: `translate3d(0,-${slideDistancePercent}%,0)` }
                                                    ];
                                                    case "homeadslidedown":
                                                    return [
                                                    { opacity: 1, transform: "translate3d(0,0,0)" },
                                                    { opacity: 0, transform: `translate3d(0,${slideDistancePercent}%,0)` }
                                                    ];
                                                    default:
                                                    return [
                                                    { opacity: 1, transform: "translate3d(0,0,0)", filter: "none" },
                                                    { opacity: 0, transform: "translate3d(0,0,0)", filter: "none" }
                                                    ];
                                                    }
                                                    };

                                                    const getInKeyframes = () => {
                                                    switch (normalizedFadingMode) {
                                                    case "homeadpixelresolve":
                                                    return [
                                                    { opacity: 0, filter: "blur(8px) saturate(0.8)", transform: "translate3d(0,0,0) scale(1.015)" },
                                                    { opacity: 1, filter: "blur(0) saturate(1)", transform: "translate3d(0,0,0) scale(1)" }
                                                    ];
                                                    case "homeadslideleft":
                                                    return [
                                                    { opacity: 0, transform: `translate3d(${slideDistancePercent}%,0,0)` },
                                                    { opacity: 1, transform: "translate3d(0,0,0)" }
                                                    ];
                                                    case "homeadslideright":
                                                    return [
