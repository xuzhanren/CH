@model CanHappy.Models.CarPoolDetailEditViewModel

@{
    ViewData["Title"] = "Edit Car Pool Detail";
}

<h1 class="mb-3">Edit Car Pool Detail</h1>

<form asp-action="Edit" asp-route-id="@Model.CarPoolDetailGUID" method="post" class="row g-3">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="CarPoolDetailGUID" />
    <input type="hidden" asp-for="ListingGUID" />

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="col-md-6">
        <div class="row align-items-center g-2">
            <label asp-for="CarPoolTypeId" class="col-sm-5 col-form-label fw-bold">Car Pool Type</label>
            <div class="col-sm-7">
                <select asp-for="CarPoolTypeId" class="form-select form-select-sm"
                        asp-items="ViewBag.CarPoolTypeId"></select>
            </div>
        </div>
        <span asp-validation-for="CarPoolTypeId" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <div class="row align-items-center g-2">
            <label asp-for="CarPoolStatusId" class="col-sm-5 col-form-label fw-bold">Car Pool Status</label>
            <div class="col-sm-7">
                <select asp-for="CarPoolStatusId" class="form-select form-select-sm"
                        asp-items="ViewBag.CarPoolStatusId"></select>
            </div>
        </div>
        <span asp-validation-for="CarPoolStatusId" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <div class="row align-items-center g-2">
            <label asp-for="FromCity" class="col-sm-5 col-form-label fw-bold">From City</label>
            <div class="col-sm-7">
                <input asp-for="FromCity" class="form-control form-control-sm" />
            </div>
        </div>
        <span asp-validation-for="FromCity" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <div class="row align-items-center g-2">
            <label asp-for="DestinationCity" class="col-sm-5 col-form-label fw-bold">Destination City</label>
            <div class="col-sm-7">
                <input asp-for="DestinationCity" class="form-control form-control-sm" />
            </div>
        </div>
        <span asp-validation-for="DestinationCity" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <div class="row align-items-center g-2">
            <label asp-for="LeavingDate" class="col-sm-5 col-form-label fw-bold">Leaving Date</label>
            <div class="col-sm-7">
                <input asp-for="LeavingDate" type="date" class="form-control form-control-sm" />
            </div>
        </div>
        <span asp-validation-for="LeavingDate" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <div class="row align-items-center g-2">
            <label asp-for="LeavingTime" class="col-sm-5 col-form-label fw-bold">Leaving Time</label>
            <div class="col-sm-7">
                <input asp-for="LeavingTime" class="form-control form-control-sm" />
            </div>
        </div>
        <span asp-validation-for="LeavingTime" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <div class="row align-items-center g-2">
            <label asp-for="WeekDays" class="col-sm-5 col-form-label fw-bold">Week Days</label>
            <div class="col-sm-7">
                <input asp-for="WeekDays" class="form-control form-control-sm" />
            </div>
        </div>
        <span asp-validation-for="WeekDays" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <div class="row align-items-center g-2">
            <label asp-for="PickupLocation" class="col-sm-5 col-form-label fw-bold">Pickup Location</label>
            <div class="col-sm-7">
                <input asp-for="PickupLocation" class="form-control form-control-sm" />
            </div>
        </div>
        <span asp-validation-for="PickupLocation" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <div class="row align-items-center g-2">
            <label asp-for="DropoffLocation" class="col-sm-5 col-form-label fw-bold">Dropoff Location</label>
            <div class="col-sm-7">
                <input asp-for="DropoffLocation" class="form-control form-control-sm" />
            </div>
        </div>
        <span asp-validation-for="DropoffLocation" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <div class="row align-items-center g-2">
            <label asp-for="TripStops" class="col-sm-5 col-form-label fw-bold">Trip Stops</label>
            <div class="col-sm-7">
                <input asp-for="TripStops" class="form-control form-control-sm" />
            </div>
        </div>
        <span asp-validation-for="TripStops" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <div class="row align-items-center g-2">
            <label asp-for="VehicleModelYear" class="col-sm-5 col-form-label fw-bold">Vehicle Model Year</label>
            <div class="col-sm-7">
                <input asp-for="VehicleModelYear" class="form-control form-control-sm" />
            </div>
        </div>
        <span asp-validation-for="VehicleModelYear" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <div class="row align-items-center g-2">
            <label asp-for="VehicleLicensePlateNumber" class="col-sm-5 col-form-label fw-bold">License Plate
                Number</label>
                <div class="col-sm-7">
                    <input asp-for="VehicleLicensePlateNumber" class="form-control form-control-sm" />
                </div>
            </div>
            <span asp-validation-for="VehicleLicensePlateNumber" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <div class="row align-items-center g-2">
                <label asp-for="VehicleColor" class="col-sm-5 col-form-label fw-bold">Vehicle Color</label>
                <div class="col-sm-7">
                    <input asp-for="VehicleColor" class="form-control form-control-sm" />
                </div>
            </div>
            <span asp-validation-for="VehicleColor" class="text-danger"></span>
        </div>

        <div class="col-12">
            <div class="row g-2">
                <label asp-for="AdditionalInfo" class="col-md-2 col-form-label fw-bold">Additional Info</label>
                <div class="col-md-10">
                    <textarea asp-for="AdditionalInfo" class="form-control form-control-sm" rows="3"></textarea>
                </div>
            </div>
            <span asp-validation-for="AdditionalInfo" class="text-danger"></span>
        </div>

        <div class="col-12 d-flex flex-wrap gap-3">
            <div class="form-check">
                <input asp-for="WeeklyScheduleInd" class="form-check-input" />
                <label asp-for="WeeklyScheduleInd" class="form-check-label"></label>
            </div>
            <div class="form-check">
                <input asp-for="SmallBagAllowedInd" class="form-check-input" />
                <label asp-for="SmallBagAllowedInd" class="form-check-label"></label>
            </div>
            <div class="form-check">
                <input asp-for="MediumBagAllowedInd" class="form-check-input" />
                <label asp-for="MediumBagAllowedInd" class="form-check-label"></label>
            </div>
            <div class="form-check">
                <input asp-for="OneLargeBagAllowedInd" class="form-check-input" />
                <label asp-for="OneLargeBagAllowedInd" class="form-check-label"></label>
            </div>
        </div>

        <div class="col-12 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Index" asp-route-listingGuid="@Model.ListingGUID" class="btn btn-outline-secondary">Back</a>
        </div>
    </form>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }