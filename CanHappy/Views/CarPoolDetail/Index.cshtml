@model CanHappy.Models.CarPoolDetailIndexPageViewModel
@using System.Security.Claims

@{
    ViewData["Title"] = "Car Pool Details";
    var listingGuid = Model.ListingGUIDFilter;
    var currentUserIdText = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var isCurrentUserGuid = Guid.TryParse(currentUserIdText, out var currentUserId);
    var currentReturnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    var photoCount = Model.ListingImages.Count;
    var addressMapQuery = $"{Model.ListingCard?.Address} {Model.ListingCard?.CityName} {Model.ListingCard?.ProvinceName} {Model.ListingCard?.PostalCode}".Trim();
    var addressMapUrl = string.IsNullOrWhiteSpace(addressMapQuery)
        ? string.Empty
        : $"https://www.google.com/maps?q={Uri.EscapeDataString(addressMapQuery)}";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.css" />

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Car Pool Details</h1>
    <a asp-action="Create" asp-route-listingGuid="@listingGuid" class="btn btn-primary">Create New</a>
</div>

@if (TempData["MessageSuccess"] is string messageSuccess && !string.IsNullOrWhiteSpace(messageSuccess))
{
    <div class="alert alert-success">@messageSuccess</div>
}

@if (TempData["MessageError"] is string messageError && !string.IsNullOrWhiteSpace(messageError))
{
    <div class="alert alert-danger">@messageError</div>
}

@if (Model.ListingCard is not null)
{
    var isOwnerListing = isCurrentUserGuid
        && Model.ListingCard.UserId != Guid.Empty
        && currentUserId == Model.ListingCard.UserId;
    var ownListingNoticeId = $"ownListingNotice_{Model.ListingCard.ListingGUID:N}";
    var messageModalId = $"sendMessageModal_{Model.ListingCard.ListingGUID:N}";
    var defaultMessageSubject = $"Message about: {Model.ListingCard.Subject}";

    <div class="card shadow-sm mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>Listing</strong>
            <div class="d-flex align-items-center gap-2 flex-wrap justify-content-end">
                <a href="#" class="btn btn-link btn-sm p-0 send-message-link" data-message-modal-id="@messageModalId"
                   data-listing-guid="@Model.ListingCard.ListingGUID.ToString("N")"
                   data-is-owner="@isOwnerListing.ToString().ToLowerInvariant()" data-notice-id="@ownListingNoticeId">
                    Message seller
                </a>
                @if (Model.HasExistingFocusDetail && Model.FocusDetail?.CarPoolDetailGUID is Guid focusDetailGuid)
                {
                    <span>|</span>
                    <a asp-controller="RideRequest" asp-action="Create" asp-route-carPoolDetailGuid="@focusDetailGuid"
                       class="btn btn-link btn-sm p-0">Request a Ride</a>
                }
                <span id="@ownListingNoticeId" class="small text-muted d-none">You cannot message your own listing.</span>
                @if (Model.CanManageFocusedListing && Model.ListingImages.Count < 30)
                {
                    <button type="button" class="btn btn-sm btn-outline-primary" id="addPhotoButton">Add Photo</button>
                }
            </div>
        </div>
        <div class="card-body">
            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <strong>Photos (@photoCount/30)</strong>
                </div>
                @if (!Model.ListingImages.Any())
                {
                    <div class="text-muted">No photos found for this listing.</div>
                }
                else
                {
                    <div class="row g-2">
                        @foreach (var image in Model.ListingImages.Select((value, index) => new { value, index }))
                        {
                            var thumbnailUrl = !string.IsNullOrWhiteSpace(image.value.ThumbnailURL) ? image.value.ThumbnailURL : image.value.ImageURL;
                            var fullImageUrl = !string.IsNullOrWhiteSpace(image.value.ImageURL) ? image.value.ImageURL : image.value.ThumbnailURL;
                            <div class="col-md-2 col-sm-4 col-6">
                                <div class="card h-100">
                                    <button type="button" class="btn p-0 border-0 text-start view-listing-photo"
                                            data-index="@image.index" data-image-url="@fullImageUrl"
                                            data-image-title="@image.value.Title">
                                        <img src="@thumbnailUrl" class="card-img-top" alt="@image.value.Title"
                                             style="height: 120px; object-fit: contain; background-color: #f8f9fa;" />
                                    </button>
                                    <div class="card-body p-2">
                                        <div class="small text-truncate">@(string.IsNullOrWhiteSpace(image.value.Title) ? "Photo" : image.value.Title)</div>
                                        @if (Model.CanManageFocusedListing)
                                        {
                                            <div class="d-flex gap-1 mt-1 flex-wrap">
                                                <button type="button" class="btn btn-sm btn-outline-secondary edit-photo-button"
                                                        data-listing-image-guid="@image.value.ListingImageGUID"
                                                        data-title="@image.value.Title" data-sort-order="@image.value.SorOrder"
                                                        data-image-url="@fullImageUrl">Edit Photo</button>
                                                <form method="post" asp-action="DeletePhoto"
                                                      asp-route-listingGuid="@Model.ListingCard.ListingGUID"
                                                      asp-route-listingImageGuid="@image.value.ListingImageGUID"
                                                      onsubmit="return confirm('Delete this photo?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                                </form>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="row g-2">
                <div class="col-md-6"><strong>Subject:</strong> @Model.ListingCard.Subject</div>
                <div class="col-md-6"><strong>Description:</strong> @Model.ListingCard.Description</div>
                <div class="col-md-4"><strong>Price per Seat:</strong> @(Model.ListingCard.Price.HasValue ? Model.ListingCard.Price.Value.ToString("C2") : "-")</div>
                <div class="col-md-4"><strong>Category:</strong> @Model.ListingCard.CategoryName</div>
                <div class="col-md-4"><strong>Subcategory:</strong> @Model.ListingCard.SubcategoryName</div>
                <div class="col-md-4"><strong>Province:</strong> @Model.ListingCard.ProvinceName</div>
                <div class="col-md-4"><strong>City:</strong> @Model.ListingCard.CityName</div>
                <div class="col-md-4">
                    <strong>Address:</strong> @Model.ListingCard.Address
                    @if (!string.IsNullOrWhiteSpace(Model.ListingCard.Address) && !string.IsNullOrWhiteSpace(addressMapUrl))
                    {
                        <a href="@addressMapUrl" target="_blank" rel="noopener noreferrer" class="ms-2">Google map</a>
                    }
                </div>
                <div class="col-md-4">
                    <strong>Postal Code:</strong> @Model.ListingCard.PostalCode
                    @if (!string.IsNullOrWhiteSpace(Model.ListingCard.PostalCode))
                    {
                        <a href="#" class="ms-2 open-google-map" data-postal-code="@Model.ListingCard.PostalCode">Google map</a>
                    }
                </div>
                <div class="col-md-4"><strong>KeyWords:</strong> @Model.ListingCard.KeyWords</div>
                @if (Model.ListingCard.ShowContactInd)
                {
                    <div class="col-md-4"><strong>Contact Phone:</strong> @Model.ListingCard.ContactPhone</div>
                    <div class="col-md-4"><strong>Contact Name:</strong> @Model.ListingCard.ContactName</div>
                }
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>Car Pool Details</strong>
            @if (Model.CanManageFocusedListing)
            {
                @if (Model.HasExistingFocusDetail && Model.FocusDetail?.CarPoolDetailGUID is Guid detailId)
                {
                    <span>
                        <a asp-action="Edit" asp-route-id="@detailId">Edit</a>
                        <span> | </span>
                        <a asp-action="Delete" asp-route-id="@detailId">Delete</a>
                    </span>
                }
                else
                {
                    <a asp-action="Create" asp-route-listingGuid="@Model.ListingCard.ListingGUID">Create Detail</a>
                }
            }
        </div>
        <div class="card-body">
            @if (Model.FocusDetail is null)
            {
                <div class="text-muted">No Car Pool detail found.</div>
            }
            else
            {
                <div class="row g-2">
                    <div class="col-lg-4 col-md-6"><strong>Car Pool Type:</strong> @(Model.FocusCarPoolTypeName ?? $"#{Model.FocusDetail.CarPoolTypeId}")</div>
                    <div class="col-lg-4 col-md-6"><strong>Car Pool Status:</strong> @(Model.FocusCarPoolStatusName ?? $"#{Model.FocusDetail.CarPoolStatusId}")</div>
                    <div class="col-lg-4 col-md-6"><strong>From City:</strong> @Model.FocusDetail.FromCity</div>
                    <div class="col-lg-4 col-md-6"><strong>Destination City:</strong> @Model.FocusDetail.DestinationCity</div>
                    <div class="col-lg-4 col-md-6"><strong>Leaving Date:</strong> @Model.FocusDetail.LeavingDate</div>
                    <div class="col-lg-4 col-md-6"><strong>Leaving Time:</strong> @Model.FocusDetail.LeavingTime</div>
                    <div class="col-lg-4 col-md-6"><strong>Week Days:</strong> @Model.FocusDetail.WeekDays</div>
                    <div class="col-lg-4 col-md-6"><strong>Pickup Location:</strong> @Model.FocusDetail.PickupLocation</div>
                    <div class="col-lg-4 col-md-6"><strong>Dropoff Location:</strong> @Model.FocusDetail.DropoffLocation</div>
                    <div class="col-lg-4 col-md-6"><strong>Trip Stops:</strong> @Model.FocusDetail.TripStops</div>
                    <div class="col-lg-4 col-md-6"><strong>Vehicle Model Year:</strong> @Model.FocusDetail.VehicleModelYear</div>
                    <div class="col-lg-4 col-md-6"><strong>License Plate #:</strong> @Model.FocusDetail.VehicleLicensePlateNumber</div>
                    <div class="col-lg-4 col-md-6"><strong>Vehicle Color:</strong> @Model.FocusDetail.VehicleColor</div>
                    <div class="col-lg-4 col-md-6"><strong>Weekly Schedule:</strong> @Model.FocusDetail.WeeklyScheduleInd</div>
                    <div class="col-lg-4 col-md-6"><strong>Small Bag Allowed:</strong> @Model.FocusDetail.SmallBagAllowedInd</div>
                    <div class="col-lg-4 col-md-6"><strong>Medium Bag Allowed:</strong> @Model.FocusDetail.MediumBagAllowedInd</div>
                    <div class="col-lg-4 col-md-6"><strong>One Large Bag Allowed:</strong> @Model.FocusDetail.OneLargeBagAllowedInd</div>
                    <div class="col-12"><strong>Additional Info:</strong> @Model.FocusDetail.AdditionalInfo</div>
                </div>
            }
        </div>
    </div>

    <div class="modal fade" id="postalCodeMapModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Google map</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-0">
                    <iframe id="postalCodeMapFrame" title="Google map by postal code"
                            style="width:100%;height:500px;border:0;" loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade"></iframe>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="@messageModalId" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Message seller</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="post" action="@Url.Action("SendToSeller", "MessagePage", new { listingId = Model.ListingCard.ListingGUID })">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@currentReturnUrl" />
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Subject</label>
                            <input type="text" name="subject" class="form-control" maxlength="120" value="@defaultMessageSubject" />
                        </div>
                        <div class="mb-0">
                            <label class="form-label">Message</label>
                            <textarea name="body" class="form-control" rows="5" maxlength="2000" required></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Send</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @if (Model.ListingImages.Any())
    {
        <div class="modal fade" id="listingPhotoViewerModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-fullscreen">
                <div class="modal-content h-100">
                    <div class="modal-header">
                        <h5 class="modal-title">Listing Photo Viewer</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body d-flex flex-column overflow-hidden">
                        <div class="d-flex justify-content-between align-items-center mb-2 flex-shrink-0">
                            <div id="viewerImageTitle" class="fw-semibold"></div>
                            <div class="btn-group">
                                <button type="button" id="viewerPrev" class="btn btn-outline-secondary btn-sm">Prev</button>
                                <button type="button" id="viewerZoomOut" class="btn btn-outline-secondary btn-sm">-</button>
                                <button type="button" id="viewerZoomReset" class="btn btn-outline-secondary btn-sm">100%</button>
                                <button type="button" id="viewerZoomIn" class="btn btn-outline-secondary btn-sm">+</button>
                                <button type="button" id="viewerNext" class="btn btn-outline-secondary btn-sm">Next</button>
                            </div>
                        </div>
                        <div class="border rounded d-flex justify-content-center align-items-center overflow-hidden flex-grow-1"
                             style="min-height: 0; background-color: #e9ecef;">
                            <img id="viewerMainImage" alt="Listing photo" draggable="false"
                                 style="width: 100%; height: 100%; object-fit: contain; transform-origin: center center; transition: transform .15s ease;" />
                        </div>
                        <div class="mt-2 d-flex flex-nowrap justify-content-center gap-2 overflow-auto pb-1 flex-shrink-0" id="viewerThumbnailStrip" style="min-height: 84px;">
                            @foreach (var image in Model.ListingImages.Select((value, index) => new { value, index }))
                            {
                                var thumbUrl = !string.IsNullOrWhiteSpace(image.value.ThumbnailURL) ? image.value.ThumbnailURL : image.value.ImageURL;
                                var fullUrl = !string.IsNullOrWhiteSpace(image.value.ImageURL) ? image.value.ImageURL : image.value.ThumbnailURL;
                                <button type="button" class="btn p-0 border viewer-thumb" data-index="@image.index" data-image-url="@fullUrl" data-image-title="@image.value.Title" style="min-width: 90px;">
                                    <img src="@thumbUrl" alt="Thumbnail @image.index" style="width: 90px; height: 70px; object-fit: contain; background-color: #f8f9fa;" />
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (Model.CanManageFocusedListing)
    {
        <form id="photoUpsertForm" method="post" asp-action="UpsertPhoto" asp-route-listingGuid="@Model.ListingCard.ListingGUID" class="d-none">
            @Html.AntiForgeryToken()
            <input type="hidden" id="photoListingImageGuid" name="listingImageGuid" />
            <input type="hidden" id="photoTitleInput" name="title" />
            <input type="hidden" id="photoSortOrderInput" name="sorOrder" />
            <input type="hidden" id="photoCroppedDataInput" name="croppedImageData" />
            <input type="hidden" id="photoThumbnailDataInput" name="thumbnailImageData" />
        </form>

        <input type="file" id="photoFileInput" class="d-none" accept="image/*" />

        <div class="modal fade" id="listingPhotoCropModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-fullscreen">
                <div class="modal-content h-100">
                    <div class="modal-header">
                        <h5 class="modal-title">Clip Listing Photo</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body d-flex flex-column gap-2">
                        <div class="d-flex flex-wrap gap-2 align-items-center">
                            <input id="photoTitleEditor" type="text" class="form-control form-control-sm" maxlength="50" placeholder="Photo title" style="max-width: 320px;" />
                            <input id="photoSortOrderEditor" type="number" class="form-control form-control-sm" min="0" max="999" step="1" value="0" style="max-width: 120px;" />
                            <select id="cropAspectRatioSelect" class="form-select form-select-sm" style="max-width: 130px;">
                                <option value="3:2" selected>3:2</option>
                                <option value="1:1">1:1</option>
                                <option value="4:3">4:3</option>
                                <option value="16:9">16:9</option>
                                <option value="free">Free</option>
                            </select>
                        </div>
                        <div class="flex-grow-1 border rounded overflow-hidden" style="min-height: 0; background: #f5f5f5;">
                            <img id="cropperImage" alt="Image to crop" class="w-100 h-100" style="object-fit: contain;" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-primary" id="savePhotoButton">Save Photo</button>
                    </div>
                </div>
            </div>
        </div>
    }
}
else
{
    @if (!Model.Items.Any())
    {
        <div class="alert alert-info">No Car Pool details found.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-sm align-middle">
                <thead>
                    <tr>
                        <th>Subject</th>
                        <th>Price per Seat</th>
                        <th>From City</th>
                        <th>Destination City</th>
                        <th>Leaving Date</th>
                        <th>Leaving Time</th>
                        <th>Type</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.Subject</td>
                            <td>@(item.Price.HasValue ? item.Price.Value.ToString("C2") : "-")</td>
                            <td>@item.FromCity</td>
                            <td>@item.DestinationCity</td>
                            <td>@item.LeavingDate</td>
                            <td>@item.LeavingTime</td>
                            <td>@item.CarPoolTypeName</td>
                            <td>@item.CarPoolStatusName</td>
                            <td>
                                <a asp-action="Index" asp-route-listingGuid="@item.ListingGUID">Open</a>
                                @if (item.CanManage)
                                {
                                    <span> | </span>
                                    <a asp-action="Edit" asp-route-id="@item.CarPoolDetailGUID">Edit</a>
                                    <span> | </span>
                                    <a asp-action="Delete" asp-route-id="@item.CarPoolDetailGUID">Delete</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.js"></script>
    <script>
        (() => {
            const mapModalElement = document.getElementById("postalCodeMapModal");
            const mapFrame = document.getElementById("postalCodeMapFrame");
            if (mapModalElement && mapFrame) {
                document.querySelectorAll(".open-google-map").forEach((link) => {
                    link.addEventListener("click", (event) => {
                        event.preventDefault();
                        const postalCode = link.getAttribute("data-postal-code");
                        if (!postalCode) {
                            return;
                        }

                        mapFrame.src = `https://www.google.com/maps?q=${encodeURIComponent(postalCode)}&output=embed`;
                        bootstrap.Modal.getOrCreateInstance(mapModalElement).show();
                    });
                });
            }

            const messageLink = document.querySelector(".send-message-link");
            if (messageLink) {
                messageLink.addEventListener("click", (event) => {
                    event.preventDefault();
                    const isOwner = messageLink.getAttribute("data-is-owner") === "true";
                    if (isOwner) {
                        const noticeId = messageLink.getAttribute("data-notice-id");
                        const notice = noticeId ? document.getElementById(noticeId) : null;
                        notice?.classList.remove("d-none");
                        return;
                    }

                    const modalId = messageLink.getAttribute("data-message-modal-id");
                    const modalElement = modalId ? document.getElementById(modalId) : null;
                    if (modalElement) {
                        bootstrap.Modal.getOrCreateInstance(modalElement).show();
                    }
                });
            }

            const viewerModalElement = document.getElementById("listingPhotoViewerModal");
            if (viewerModalElement) {
                const viewerMainImage = document.getElementById("viewerMainImage");
                const viewerImageTitle = document.getElementById("viewerImageTitle");
                const viewerPrev = document.getElementById("viewerPrev");
                const viewerNext = document.getElementById("viewerNext");
                const viewerZoomIn = document.getElementById("viewerZoomIn");
                const viewerZoomOut = document.getElementById("viewerZoomOut");
                const viewerZoomReset = document.getElementById("viewerZoomReset");
                const viewerThumbButtons = Array.from(document.querySelectorAll(".viewer-thumb"));
                const triggerButtons = Array.from(document.querySelectorAll(".view-listing-photo"));

                let zoomScale = 1;
                let selectedIndex = 0;

                const updateSelection = (index) => {
                    if (viewerThumbButtons.length === 0) return;
                    if (index < 0) index = viewerThumbButtons.length - 1;
                    if (index >= viewerThumbButtons.length) index = 0;

                    const selected = viewerThumbButtons.find(button => Number.parseInt(button.dataset.index, 10) === index);
                    if (!selected) return;

                    selectedIndex = index;
                    viewerMainImage.src = selected.dataset.imageUrl || "";
                    viewerImageTitle.textContent = selected.dataset.imageTitle || "Photo";
                    zoomScale = 1;
                    viewerMainImage.style.transform = "scale(1)";
                    viewerZoomReset.textContent = "100%";

                    viewerThumbButtons.forEach((button) => {
                        const isActive = Number.parseInt(button.dataset.index, 10) === selectedIndex;
                        button.classList.toggle("border-primary", isActive);
                        button.classList.toggle("border-2", isActive);
                    });
                };

                triggerButtons.forEach((button) => {
                    button.addEventListener("click", () => {
                        const index = Number.parseInt(button.dataset.index, 10);
                        if (Number.isFinite(index)) updateSelection(index);
                        bootstrap.Modal.getOrCreateInstance(viewerModalElement).show();
                    });
                });

                viewerThumbButtons.forEach((button) => {
                    button.addEventListener("click", () => {
                        const index = Number.parseInt(button.dataset.index, 10);
                        if (Number.isFinite(index)) updateSelection(index);
                    });
                });

                viewerZoomIn?.addEventListener("click", () => {
                    zoomScale = Math.min(10, zoomScale + 0.2);
                    viewerMainImage.style.transform = `scale(${zoomScale})`;
                    viewerZoomReset.textContent = `${Math.round(zoomScale * 100)}%`;
                });

                viewerZoomOut?.addEventListener("click", () => {
                    zoomScale = Math.max(0.2, zoomScale - 0.2);
                    viewerMainImage.style.transform = `scale(${zoomScale})`;
                    viewerZoomReset.textContent = `${Math.round(zoomScale * 100)}%`;
                });

                viewerZoomReset?.addEventListener("click", () => {
                    zoomScale = 1;
                    viewerMainImage.style.transform = "scale(1)";
                    viewerZoomReset.textContent = "100%";
                });

                viewerPrev?.addEventListener("click", () => updateSelection(selectedIndex - 1));
                viewerNext?.addEventListener("click", () => updateSelection(selectedIndex + 1));

                if (viewerThumbButtons.length > 0) updateSelection(0);
            }

            const addPhotoButton = document.getElementById("addPhotoButton");
            const photoFileInput = document.getElementById("photoFileInput");
            const cropModalElement = document.getElementById("listingPhotoCropModal");
            const cropperImage = document.getElementById("cropperImage");
            const savePhotoButton = document.getElementById("savePhotoButton");
            const cropAspectRatioSelect = document.getElementById("cropAspectRatioSelect");
            const photoTitleEditor = document.getElementById("photoTitleEditor");
            const photoSortOrderEditor = document.getElementById("photoSortOrderEditor");
            const photoListingImageGuid = document.getElementById("photoListingImageGuid");
            const photoTitleInput = document.getElementById("photoTitleInput");
            const photoSortOrderInput = document.getElementById("photoSortOrderInput");
            const photoCroppedDataInput = document.getElementById("photoCroppedDataInput");
            const photoThumbnailDataInput = document.getElementById("photoThumbnailDataInput");
            const photoUpsertForm = document.getElementById("photoUpsertForm");

            let cropper = null;
            let sourceImageDataUrl = "";

            if (cropModalElement && cropperImage && savePhotoButton && photoUpsertForm) {
                const getAspectRatio = () => {
                    const value = cropAspectRatioSelect?.value || "3:2";
                    if (value === "free") return NaN;
                    const [w, h] = value.split(":").map(Number);
                    return w > 0 && h > 0 ? (w / h) : (3 / 2);
                };

                const openCropModal = (imageUrl) => {
                    sourceImageDataUrl = imageUrl;
                    cropperImage.src = imageUrl;
                    bootstrap.Modal.getOrCreateInstance(cropModalElement).show();
                };

                cropModalElement.addEventListener("shown.bs.modal", () => {
                    if (cropper) {
                        cropper.destroy();
                    }

                    cropper = new Cropper(cropperImage, {
                        viewMode: 1,
                        dragMode: "move",
                        autoCropArea: 0.9,
                        aspectRatio: getAspectRatio(),
                        responsive: true,
                        background: false
                    });
                });

                cropModalElement.addEventListener("hidden.bs.modal", () => {
                    if (cropper) {
                        cropper.destroy();
                        cropper = null;
                    }
                });

                cropAspectRatioSelect?.addEventListener("change", () => {
                    if (!cropper) return;
                    cropper.setAspectRatio(getAspectRatio());
                });

                addPhotoButton?.addEventListener("click", () => {
                    photoListingImageGuid.value = "";
                    photoTitleEditor.value = "";
                    photoSortOrderEditor.value = "0";
                    photoFileInput?.click();
                });

                photoFileInput?.addEventListener("change", () => {
                    const file = photoFileInput.files?.[0];
                    if (!file) return;

                    const reader = new FileReader();
                    reader.onload = () => {
                        if (typeof reader.result === "string") {
                            openCropModal(reader.result);
                        }
                    };
                    reader.readAsDataURL(file);
                });

                document.querySelectorAll(".edit-photo-button").forEach((button) => {
                    button.addEventListener("click", () => {
                        photoListingImageGuid.value = button.getAttribute("data-listing-image-guid") || "";
                        photoTitleEditor.value = button.getAttribute("data-title") || "";
                        photoSortOrderEditor.value = button.getAttribute("data-sort-order") || "0";
                        const imageUrl = button.getAttribute("data-image-url") || "";
                        if (imageUrl) {
                            openCropModal(imageUrl);
                        }
                    });
                });

                savePhotoButton.addEventListener("click", () => {
                    if (!cropper) return;

                    const croppedCanvas = cropper.getCroppedCanvas({ imageSmoothingQuality: "high" });
                    if (!croppedCanvas) return;

                    const thumbnailCanvas = cropper.getCroppedCanvas({ width: 360, height: 240, imageSmoothingQuality: "high" });

                    photoTitleInput.value = photoTitleEditor.value || "";
                    photoSortOrderInput.value = photoSortOrderEditor.value || "0";
                    photoCroppedDataInput.value = croppedCanvas.toDataURL("image/jpeg", 0.92);
                    photoThumbnailDataInput.value = thumbnailCanvas ? thumbnailCanvas.toDataURL("image/jpeg", 0.9) : photoCroppedDataInput.value;

                    photoUpsertForm.submit();
                });
            }
        })();
    </script>
}
