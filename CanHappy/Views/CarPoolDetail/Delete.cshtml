@model CanHappy.Models.CarPoolDetailEditViewModel

@{
    ViewData["Title"] = "Delete Car Pool Detail";
}

<h1 class="mb-3">Delete Car Pool Detail</h1>

<div class="alert alert-warning">Are you sure you want to delete this car pool detail?</div>

<dl class="row">
    <dt class="col-sm-3">From City</dt>
    <dd class="col-sm-9">@Model.FromCity</dd>

    <dt class="col-sm-3">Destination City</dt>
    <dd class="col-sm-9">@Model.DestinationCity</dd>

    <dt class="col-sm-3">Leaving Date</dt>
    <dd class="col-sm-9">@Model.LeavingDate</dd>

    <dt class="col-sm-3">Leaving Time</dt>
    <dd class="col-sm-9">@Model.LeavingTime</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.CarPoolDetailGUID" method="post" class="d-flex gap-2">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" asp-route-listingGuid="@Model.ListingGUID" class="btn btn-outline-secondary">Cancel</a>
</form>