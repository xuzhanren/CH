@model CanHappy.Models.CarVehicleDetailEditViewModel

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>
<h3>Are you sure you want to delete this Car/Vehicle detail?</h3>

<div>
    <h4>Listing</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Subject</dt>
        <dd class="col-sm-9">@Model.Subject</dd>

        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9">@Model.Description</dd>

        <dt class="col-sm-3">CategoryId</dt>
        <dd class="col-sm-9">@Model.CategoryId</dd>

        <dt class="col-sm-3">SubcategoryId</dt>
        <dd class="col-sm-9">@Model.SubcategoryId</dd>

        <dt class="col-sm-3">ProvinceId</dt>
        <dd class="col-sm-9">@Model.ProvinceId</dd>

        <dt class="col-sm-3">CityId</dt>
        <dd class="col-sm-9">@Model.CityId</dd>

        <dt class="col-sm-3">Price</dt>
        <dd class="col-sm-9">@(Model.Price.HasValue ? Model.Price.Value.ToString("C2") : "-")</dd>

        <dt class="col-sm-3">Brand</dt>
        <dd class="col-sm-9">@Model.Brand</dd>

        <dt class="col-sm-3">Condition</dt>
        <dd class="col-sm-9">@Model.Condition</dd>

        <dt class="col-sm-3">ManufactureYear</dt>
        <dd class="col-sm-9">@Model.ManufactureYear</dd>

        <dt class="col-sm-3">Listing Model</dt>
        <dd class="col-sm-9">@Model.ListingModel</dd>

        <dt class="col-sm-3">Quantity</dt>
        <dd class="col-sm-9">@Model.Quantity</dd>

        <dt class="col-sm-3">Kilometers</dt>
        <dd class="col-sm-9">@Model.Kilometers</dd>

        <dt class="col-sm-3">Doors</dt>
        <dd class="col-sm-9">@Model.Doors</dd>

        <dt class="col-sm-3">Seats</dt>
        <dd class="col-sm-9">@Model.Seats</dd>

        <dt class="col-sm-3">BodyStyle</dt>
        <dd class="col-sm-9">@Model.BodyStyle</dd>

        <dt class="col-sm-3">Engine</dt>
        <dd class="col-sm-9">@Model.Engine</dd>

        <dt class="col-sm-3">Transmission</dt>
        <dd class="col-sm-9">@Model.Transmission</dd>

        <dt class="col-sm-3">FuelType</dt>
        <dd class="col-sm-9">@Model.FuelType</dd>

        <dt class="col-sm-3">Drivetrain</dt>
        <dd class="col-sm-9">@Model.Drivetrain</dd>

        <dt class="col-sm-3">SellerType</dt>
        <dd class="col-sm-9">@Model.SellerType</dd>
    </dl>

    <form asp-action="Delete" asp-route-id="@Model.CarVehicleDetailGUID">
        <input type="hidden" asp-for="CarVehicleDetailGUID" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Index" asp-route-listingGuid="@Model.ListingGUID" class="btn btn-outline-secondary">Back to
            List</a>
        </form>
    </div>