@model CanHappy.Models.CarVehicleDetailIndexPageViewModel
@using System.Security.Claims

@{
    ViewData["Title"] = "Car/Vehicle Details";
    var listingGuid = Model.ListingGUIDFilter;
    var currentUserIdText = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var isCurrentUserGuid = Guid.TryParse(currentUserIdText, out var currentUserId);
    var currentReturnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    var photoCount = Model.ListingImages.Count;
    var addressMapQuery = $"{Model.ListingCard?.Address} {Model.ListingCard?.CityName} {Model.ListingCard?.ProvinceName} {Model.ListingCard?.PostalCode}".Trim();
    var addressMapUrl = string.IsNullOrWhiteSpace(addressMapQuery)
        ? string.Empty
        : $"https://www.google.com/maps?q={Uri.EscapeDataString(addressMapQuery)}";
    var carVehicleSliderWaitSeconds = ViewData["CarVehicleSliderWaitSeconds"] as int? ?? 2;
    var carVehicleAdSlidingInterval = ViewData["CarVehicleAdSlidingInterval"] as int? ?? 5;
    var carVehicleAdSliderFadingMode = ViewData["CarVehicleAdSliderFadingMode"]?.ToString() ?? "homeAdFade";
    var carVehicleAdPixelResolveTransitionPeriodMiliSeconds = ViewData["CarVehicleAdPixelResolveTransitionPeriodMiliSeconds"] as int? ?? 1000;
    var carVehicleAdFadeTransitionMilliSeconds = ViewData["CarVehicleAdFadeTransitionMilliSeconds"] as int? ?? 450;
    var carVehicleSlideTransitionMilliSeconds = ViewData["CarVehicleSlideTransitionMilliSeconds"] as int? ?? 650;
    var carVehicleAdSlideDistancePercent = ViewData["CarVehicleAdSlideDistancePercent"] as int? ?? 8;
    var carVehicleAdTransitionEasing = ViewData["CarVehicleAdTransitionEasing"]?.ToString() ?? "ease-in-out";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.css" />
<style>
    .cropper-view-box {
        outline-width: 2px !important;
    }

    .cropper-line.line-e,
    .cropper-line.line-w {
        width: 2px !important;
    }

    .cropper-line.line-n,
    .cropper-line.line-s {
        height: 2px !important;
    }

    .cropper-point {
        width: 14px !important;
        height: 14px !important;
        border: 2px solid #fff !important;
        opacity: 1 !important;
    }

    .form-label,
    .form-check-label {
        font-weight: 700;
    }

    .favorite-heart-button {
        border: 0;
        background: transparent;
        padding: 0;
        font-size: 1.35rem;
        line-height: 1;
    }

    .favorite-heart-button.hollow {
        color: #0d6efd;
    }

    .favorite-heart-button.solid {
        color: #dc3545;
    }

    .car-vehicle-detail-slider-wrapper {
        width: 100%;
        height: clamp(120px, 14vw, 190px);
        overflow: hidden;
        background-color: var(--bs-body-bg);
        border: 1px solid var(--bs-border-color);
        border-radius: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .car-vehicle-detail-slider-link {
        display: block;
        width: 100%;
        height: 100%;
    }

    .car-vehicle-detail-slider-image {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: contain;
        opacity: 1;
        will-change: opacity, transform, filter;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Car/Vehicle Details</h1>
    <a asp-action="Create" asp-route-listingGuid="@listingGuid" class="btn btn-primary">Create New</a>
</div>

@if (TempData["MessageSuccess"] is string messageSuccess && !string.IsNullOrWhiteSpace(messageSuccess))
{
    <div class="alert alert-success">@messageSuccess</div>
}

@if (TempData["MessageError"] is string messageError && !string.IsNullOrWhiteSpace(messageError))
{
    <div class="alert alert-danger">@messageError</div>
}

@if (Model.ListingCard is not null)
{
    var isOwnerListing = isCurrentUserGuid
    && Model.ListingCard.UserId != Guid.Empty
    && currentUserId == Model.ListingCard.UserId;
    var ownListingNoticeId = $"ownListingNotice_{Model.ListingCard.ListingGUID:N}";
    var messageModalId = $"sendMessageModal_{Model.ListingCard.ListingGUID:N}";
    var defaultMessageSubject = $"Message about: {Model.ListingCard.Subject}";

    <div class="card shadow-sm mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <strong>Listing</strong>
                @if (isCurrentUserGuid)
                {
                    @if (Model.IsFavorited)
                    {
                        <form method="post" asp-controller="EstateSaleDetailPage" asp-action="Unfavorite" asp-route-listingGuid="@Model.ListingCard.ListingGUID" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="returnUrl" value="@currentReturnUrl" />
                            <button type="submit" class="favorite-heart-button solid" title="Remove from favorites" aria-label="Remove from favorites">♥</button>
                        </form>
                    }
                    else
                    {
                        <form method="post" asp-controller="EstateSaleDetailPage" asp-action="Favorite" asp-route-listingGuid="@Model.ListingCard.ListingGUID" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="returnUrl" value="@currentReturnUrl" />
                            <button type="submit" class="favorite-heart-button hollow" title="Add to favorites" aria-label="Add to favorites">♡</button>
                        </form>
                    }
                }
            </div>
            <div class="d-flex align-items-center gap-2">
                <a href="#" class="btn btn-link btn-sm p-0 send-message-link" data-message-modal-id="@messageModalId"
                   data-listing-guid="@Model.ListingCard.ListingGUID.ToString("N")"
                   data-is-owner="@isOwnerListing.ToString().ToLowerInvariant()" data-notice-id="@ownListingNoticeId">
                    Mesasage seller
                </a>
                <span id="@ownListingNoticeId" class="small text-muted d-none">You cannot message your own listing.</span>
                @if (Model.CanManageFocusedListing && Model.ListingImages.Count < 30)
                {
                    <button type="button" class="btn btn-sm btn-outline-primary" id="addPhotoButton">Add Photo</button>
                }
            </div>
        </div>
        <div class="card-body">
            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <strong>Photos (@photoCount/30)</strong>
                </div>
                @if (!Model.ListingImages.Any())
                {
                    <div class="text-muted">No photos found for this listing.</div>
                }
                else
                {
                    <div class="row g-2">
                        @foreach (var image in Model.ListingImages.Select((value, index) => new { value, index }))
                        {
                            var thumbnailUrl = !string.IsNullOrWhiteSpace(image.value.ThumbnailURL) ? image.value.ThumbnailURL :
                            image.value.ImageURL;
                            var fullImageUrl = !string.IsNullOrWhiteSpace(image.value.ImageURL) ? image.value.ImageURL :
                            image.value.ThumbnailURL;
                            <div class="col-md-3 col-sm-4 col-6">
                                <div class="card h-100">
                                    <button type="button" class="btn p-0 border-0 text-start view-listing-photo"
                                            data-index="@image.index" data-image-url="@fullImageUrl"
                                            data-image-title="@image.value.Title">
                                        <img src="@thumbnailUrl" class="card-img-top" alt="@image.value.Title"
                                             style="height: 150px; object-fit: contain; background-color: #f8f9fa;" />
                                    </button>
                                    <div class="card-body p-2">
                                        <div class="small text-truncate">@(string.IsNullOrWhiteSpace(image.value.Title) ? "Photo" :
                                                                            image.value.Title)</div>
                                            @if (Model.CanManageFocusedListing)
                                            {
                                                <div class="d-flex gap-1 mt-1">
                                                    <button type="button" class="btn btn-sm btn-outline-secondary edit-photo-button"
                                                            data-listing-image-guid="@image.value.ListingImageGUID"
                                                            data-title="@image.value.Title" data-sort-order="@image.value.SorOrder"
                                                            data-image-url="@fullImageUrl">
                                                        Edit Photo
                                                    </button>
                                                    <form method="post" asp-action="DeletePhoto"
                                                          asp-route-listingGuid="@Model.ListingCard.ListingGUID"
                                                          asp-route-listingImageGuid="@image.value.ListingImageGUID"
                                                          onsubmit="return confirm('Delete this photo?');">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                                    </form>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="row g-2">
                    <div class="col-md-6"><strong>Subject:</strong> @Model.ListingCard.Subject</div>
                    <div class="col-md-6"><strong>Description:</strong>@Model.ListingCard.Description</div>
                    <div class="col-md-4"><strong>Price:</strong> @(Model.ListingCard.Price.HasValue ? Model.ListingCard.Price.Value.ToString("C2") : "-")</div>
                    <div class="col-md-4"><strong>Quantity:</strong> @Model.ListingCard.Quantity</div>
                    <div class="col-md-4"><strong>Discount Percent:</strong> @Model.ListingCard.DiscountPercent</div>
                    <div class="col-md-4"><strong>Sales Ending:</strong> @Model.ListingCard.DiscountEndDate</div>
                    <div class="col-md-4"><strong>Brand:</strong> @Model.ListingCard.Brand</div>
                    <div class="col-md-4"><strong>Model:</strong> @Model.ListingCard.Model</div>
                    <div class="col-md-4"><strong>Manufacture Year:</strong> @Model.ListingCard.ManufactureYear</div>
                    <div class="col-md-4"><strong>Condition:</strong> @Model.ListingCard.Condition</div>
                    <div class="col-md-4"><strong>Category:</strong> @Model.ListingCard.CategoryName</div>
                    <div class="col-md-4"><strong>Subcategory:</strong> @Model.ListingCard.SubcategoryName</div>
                    <div class="col-md-4"><strong>Province:</strong> @Model.ListingCard.ProvinceName</div>
                    <div class="col-md-4"><strong>City:</strong> @Model.ListingCard.CityName</div>
                    <div class="col-md-4">
                        <strong>Address:</strong> @Model.ListingCard.Address
                        @if (!string.IsNullOrWhiteSpace(Model.ListingCard.Address) && !string.IsNullOrWhiteSpace(addressMapUrl))
                        {
                            <a href="@addressMapUrl" target="_blank" rel="noopener noreferrer" class="ms-2">Google map</a>
                        }
                    </div>
                    <div class="col-md-4">
                        <strong>Postal Code:</strong> @Model.ListingCard.PostalCode
                        @if (!string.IsNullOrWhiteSpace(Model.ListingCard.PostalCode))
                        {
                            <a href="#" class="ms-2 open-google-map" data-postal-code="@Model.ListingCard.PostalCode">Google map</a>
                        }
                    </div>
                    <div class="col-md-4"><strong>KeyWords:</strong> @Model.ListingCard.KeyWords</div>
                </div>

                <div class="modal fade" id="postalCodeMapModal" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-lg modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">Google map</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body p-0">
                                <iframe id="postalCodeMapFrame" title="Google map by postal code"
                                        style="width:100%;height:500px;border:0;" loading="lazy"
                                        referrerpolicy="no-referrer-when-downgrade"></iframe>
                            </div>
                        </div>
                    </div>
                </div>

                <script>
                            (() => {
                                const mapModalElement = document.getElementById("postalCodeMapModal");
                                const mapFrame = document.getElementById("postalCodeMapFrame");

                                if (!mapModalElement || !mapFrame) {
                                    return;
                                }

                                document.querySelectorAll(".open-google-map").forEach((link) => {
                                    link.addEventListener("click", (event) => {
                                        event.preventDefault();
                                        const postalCode = link.getAttribute("data-postal-code");
                                        if (!postalCode) {
                                            return;
                                        }

                                        mapFrame.src = `https://www.google.com/maps?q=${encodeURIComponent(postalCode)}&output=embed`;
                                        bootstrap.Modal.getOrCreateInstance(mapModalElement).show();
                                    });
                                });
                            })();
                </script>

                <div class="modal fade" id="@messageModalId" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">Message seller</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <form method="post"
                                  action="@Url.Action("SendToSeller", "MessagePage", new { listingId = Model.ListingCard.ListingGUID })">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="returnUrl" value="@currentReturnUrl" />
                                <div class="modal-body">
                                    <div class="mb-3">
                                        <label for="subject_@Model.ListingCard.ListingGUID" class="form-label">Subject</label>
                                        <input type="text" id="subject_@Model.ListingCard.ListingGUID" name="subject"
                                               class="form-control" maxlength="120" value="@defaultMessageSubject" />
                                    </div>
                                    <div class="mb-0">
                                        <label for="body_@Model.ListingCard.ListingGUID" class="form-label">Message</label>
                                        <textarea id="body_@Model.ListingCard.ListingGUID" name="body" class="form-control"
                                                  rows="5" maxlength="2000" required></textarea>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-primary">Send</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <script>
                    (() => {
                        const link = document.querySelector(".send-message-link");
                        if (!link) {
                            return;
                        }

                        link.addEventListener("click", (event) => {
                            event.preventDefault();

                            const isOwner = link.getAttribute("data-is-owner") === "true";
                            if (isOwner) {
                                const noticeId = link.getAttribute("data-notice-id");
                                const notice = noticeId ? document.getElementById(noticeId) : null;
                                notice?.classList.remove("d-none");
                                return;
                            }

                            const modalId = link.getAttribute("data-message-modal-id");
                            const modalElement = modalId ? document.getElementById(modalId) : null;
                            if (!modalElement) {
                                return;
                            }

                            bootstrap.Modal.getOrCreateInstance(modalElement).show();
                        });
                    })();
                </script>
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-lg-6 col-md-6 col-12">
                <div id="carVehicleDetailSliderWrapperLeft" class="car-vehicle-detail-slider-wrapper d-none" aria-label="Car vehicle page ads left slider">
                    <a id="carVehicleDetailSliderLinkLeft" href="#" target="_blank" rel="noopener noreferrer" class="car-vehicle-detail-slider-link">
                        <img id="carVehicleDetailSliderImageLeft" class="car-vehicle-detail-slider-image" src="" alt="Car vehicle page ad left" />
                    </a>
                </div>
            </div>
            <div class="col-lg-6 col-md-6 col-12">
                <div id="carVehicleDetailSliderWrapperRight" class="car-vehicle-detail-slider-wrapper d-none" aria-label="Car vehicle page ads right slider">
                    <a id="carVehicleDetailSliderLinkRight" href="#" target="_blank" rel="noopener noreferrer" class="car-vehicle-detail-slider-link">
                        <img id="carVehicleDetailSliderImageRight" class="car-vehicle-detail-slider-image" src="" alt="Car vehicle page ad right" />
                    </a>
                </div>
            </div>
        </div>

        <script>
            (() => {
                const waitSeconds = @carVehicleSliderWaitSeconds;
                const slidingIntervalSeconds = @carVehicleAdSlidingInterval;
                const fadingMode = "@carVehicleAdSliderFadingMode".trim().toLowerCase();
                const pixelResolveTransitionMs = @carVehicleAdPixelResolveTransitionPeriodMiliSeconds;
                const fadeTransitionMs = @carVehicleAdFadeTransitionMilliSeconds;
                const slideTransitionMs = @carVehicleSlideTransitionMilliSeconds;
                const slideDistancePercent = @carVehicleAdSlideDistancePercent;
                const transitionEasing = "@carVehicleAdTransitionEasing".trim() || "ease-in-out";
                const requestUrl = "@Url.Action("DetailPageSliderAds", "CarVehicleDetailPage", new { listingGuid = Model.ListingCard.ListingGUID })";

                const normalizeFadingMode = (mode) => {
                    if (mode === "fade" || mode === "homeadfade") {
                        return "homeadfade";
                    }

                    if (mode === "pixelresolve" || mode === "homeadpixelresolve") {
                        return "homeadpixelresolve";
                    }

                    if (mode === "homeadslidedown" || mode === "homeadslideup" || mode === "homeadslideleft" || mode === "homeadslideright") {
                        return mode;
                    }

                    return "homeadfade";
                };

                const normalizedFadingMode = normalizeFadingMode(fadingMode);

                const getTransitionDuration = () => {
                    if (normalizedFadingMode === "homeadpixelresolve") {
                        return Math.max(100, pixelResolveTransitionMs);
                    }

                    if (normalizedFadingMode === "homeadfade") {
                        return Math.max(100, fadeTransitionMs);
                    }

                    return Math.max(100, slideTransitionMs);
                };

                const getOutKeyframes = () => {
                    switch (normalizedFadingMode) {
                        case "homeadpixelresolve":
                            return [
                                { opacity: 1, filter: "blur(0) saturate(1)", transform: "translate3d(0,0,0) scale(1)" },
                                { opacity: 0, filter: "blur(8px) saturate(0.8)", transform: "translate3d(0,0,0) scale(1.015)" }
                            ];
                        case "homeadslideleft":
                            return [
                                { opacity: 1, transform: "translate3d(0,0,0)" },
                                { opacity: 0, transform: `translate3d(-${slideDistancePercent}%,0,0)` }
                            ];
                        case "homeadslideright":
                            return [
                                { opacity: 1, transform: "translate3d(0,0,0)" },
                                { opacity: 0, transform: `translate3d(${slideDistancePercent}%,0,0)` }
                            ];
                        case "homeadslideup":
                            return [
                                { opacity: 1, transform: "translate3d(0,0,0)" },
                                { opacity: 0, transform: `translate3d(0,-${slideDistancePercent}%,0)` }
                            ];
                        case "homeadslidedown":
                            return [
                                { opacity: 1, transform: "translate3d(0,0,0)" },
                                { opacity: 0, transform: `translate3d(0,${slideDistancePercent}%,0)` }
                            ];
                        default:
                            return [
                                { opacity: 1, transform: "translate3d(0,0,0)", filter: "none" },
                                { opacity: 0, transform: "translate3d(0,0,0)", filter: "none" }
                            ];
                    }
                };

                const getInKeyframes = () => {
                    switch (normalizedFadingMode) {
                        case "homeadpixelresolve":
                            return [
                                { opacity: 0, filter: "blur(8px) saturate(0.8)", transform: "translate3d(0,0,0) scale(1.015)" },
                                { opacity: 1, filter: "blur(0) saturate(1)", transform: "translate3d(0,0,0) scale(1)" }
                            ];
                        case "homeadslideleft":
                            return [
                                { opacity: 0, transform: `translate3d(${slideDistancePercent}%,0,0)` },
                                { opacity: 1, transform: "translate3d(0,0,0)" }
                            ];
                        case "homeadslideright":
                            return [
                                { opacity: 0, transform: `translate3d(-${slideDistancePercent}%,0,0)` },
                                { opacity: 1, transform: "translate3d(0,0,0)" }
                            ];
                        case "homeadslideup":
                            return [
                                { opacity: 0, transform: `translate3d(0,${slideDistancePercent}%,0)` },
                                { opacity: 1, transform: "translate3d(0,0,0)" }
                            ];
                        case "homeadslidedown":
                            return [
                                { opacity: 0, transform: `translate3d(0,-${slideDistancePercent}%,0)` },
                                { opacity: 1, transform: "translate3d(0,0,0)" }
                            ];
                        default:
                            return [
                                { opacity: 0, transform: "translate3d(0,0,0)", filter: "none" },
                                { opacity: 1, transform: "translate3d(0,0,0)", filter: "none" }
                            ];
                    }
                };

                const createSlider = (wrapperId, linkId, imageId, adItems) => {
                    const sliderWrapper = document.getElementById(wrapperId);
                    const sliderLink = document.getElementById(linkId);
                    const sliderImage = document.getElementById(imageId);

                    if (!sliderWrapper || !sliderLink || !sliderImage || !Array.isArray(adItems)) {
                        return;
                    }

                    if (adItems.length === 0) {
                        sliderLink.removeAttribute("href");
                        sliderLink.style.pointerEvents = "none";
                        sliderImage.src = "";
                        sliderImage.alt = "";
                        sliderImage.style.visibility = "hidden";
                        sliderWrapper.classList.remove("d-none");
                        return;
                    }

                    sliderLink.style.pointerEvents = "auto";
                    sliderImage.style.visibility = "visible";

                    let activeIndex = 0;
                    let isTransitioning = false;
                    let queuedIndex = null;

                    const applyAdSource = (ad) => {
                        sliderLink.href = ad.targetURL || "#";
                        sliderImage.src = ad.imageURL || "";
                        sliderImage.alt = ad.subject || "Car vehicle page ad";
                    };

                    const resetImageStyles = () => {
                        sliderImage.style.opacity = "1";
                        sliderImage.style.transform = "translate3d(0,0,0)";
                        sliderImage.style.filter = "none";
                    };

                    const transitionToAd = async (ad) => {
                        const durationMs = getTransitionDuration();

                        if (!sliderImage.getAttribute("src")) {
                            applyAdSource(ad);
                            resetImageStyles();
                            return;
                        }

                        try {
                            await sliderImage.animate(getOutKeyframes(), {
                                duration: durationMs,
                                easing: transitionEasing,
                                fill: "forwards"
                            }).finished;
                        } catch {
                        }

                        applyAdSource(ad);

                        try {
                            await sliderImage.animate(getInKeyframes(), {
                                duration: durationMs,
                                easing: transitionEasing,
                                fill: "forwards"
                            }).finished;
                        } catch {
                        }

                        resetImageStyles();
                    };

                    const showAdAt = async (index) => {
                        const normalizedIndex = ((index % adItems.length) + adItems.length) % adItems.length;
                        const ad = adItems[normalizedIndex];
                        if (!ad) {
                            return;
                        }

                        if (isTransitioning) {
                            queuedIndex = normalizedIndex;
                            return;
                        }

                        isTransitioning = true;
                        activeIndex = normalizedIndex;

                        await transitionToAd(ad);

                        isTransitioning = false;
                        if (queuedIndex !== null && queuedIndex !== activeIndex) {
                            const nextIndex = queuedIndex;
                            queuedIndex = null;
                            await showAdAt(nextIndex);
                        } else {
                            queuedIndex = null;
                        }
                    };

                    showAdAt(activeIndex);
                    sliderWrapper.classList.remove("d-none");

                    if (adItems.length > 1) {
                        window.setInterval(() => {
                            showAdAt(activeIndex + 1);
                        }, Math.max(1, slidingIntervalSeconds) * 1000);
                    }
                };

                const loadAndStart = async () => {
                    try {
                        const response = await fetch(requestUrl, { method: "GET" });
                        if (!response.ok) {
                            return;
                        }

                        const payload = await response.json();
                        if (!Array.isArray(payload) || payload.length === 0) {
                            return;
                        }

                        const adItems = payload
                            .filter((item) => item && item.imageURL && item.targetURL && item.adGuid)
                            .filter((item, index, array) => array.findIndex((candidate) => candidate.adGuid === item.adGuid) === index)
                            .slice(0, 8);

                        if (adItems.length === 0) {
                            return;
                        }

                        const midpoint = Math.ceil(adItems.length / 2);
                        const leftItems = adItems.slice(0, midpoint);
                        const rightItems = adItems.slice(midpoint);

                        createSlider("carVehicleDetailSliderWrapperLeft", "carVehicleDetailSliderLinkLeft", "carVehicleDetailSliderImageLeft", leftItems);
                        createSlider("carVehicleDetailSliderWrapperRight", "carVehicleDetailSliderLinkRight", "carVehicleDetailSliderImageRight", rightItems);
                    } catch {
                    }
                };

                window.addEventListener("load", () => {
                    window.setTimeout(() => {
                        loadAndStart();
                    }, Math.max(0, waitSeconds) * 1000);
                });
            })();
        </script>

        <div class="card shadow-sm mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>Car/Vehicle Details</strong>
                @if (Model.CanManageFocusedListing)
                {
