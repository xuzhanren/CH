                <script>
                    (() => {
                        const viewerModalElement = document.getElementById("listingPhotoViewerModal");
                        if (!viewerModalElement) {
                            return;
                        }

                        const viewerMainImage = document.getElementById("viewerMainImage");
                        const viewerImageTitle = document.getElementById("viewerImageTitle");
                        const viewerPrev = document.getElementById("viewerPrev");
                        const viewerNext = document.getElementById("viewerNext");
                        const viewerZoomIn = document.getElementById("viewerZoomIn");
                        const viewerZoomOut = document.getElementById("viewerZoomOut");
                        const viewerZoomReset = document.getElementById("viewerZoomReset");
                        const viewerThumbButtons = Array.from(document.querySelectorAll(".viewer-thumb"));
                        const triggerButtons = Array.from(document.querySelectorAll(".view-listing-photo"));
                        const viewerViewport = viewerMainImage.parentElement;

                        let zoomScale = 1;
                        let selectedIndex = 0;
                        let targetTranslateX = 0;
                        let targetTranslateY = 0;
                        let isDragging = false;
                        let lastPointerX = 0;
                        let lastPointerY = 0;
                        let rafPending = false;

                        const getViewerModal = () => {
                            if (!window.bootstrap || !window.bootstrap.Modal) {
                                return null;
                            }

                            return window.bootstrap.Modal.getOrCreateInstance(viewerModalElement);
                        };

                        const getFittedImageSize = () => {
                            const viewportWidth = Math.max(1, viewerViewport.clientWidth);
                            const viewportHeight = Math.max(1, viewerViewport.clientHeight);
                            const naturalWidth = Math.max(1, viewerMainImage.naturalWidth || 1);
                            const naturalHeight = Math.max(1, viewerMainImage.naturalHeight || 1);
                            const widthRatio = viewportWidth / naturalWidth;
                            const heightRatio = viewportHeight / naturalHeight;
                            const fitRatio = Math.min(widthRatio, heightRatio);

                            return {
                                viewportWidth,
                                viewportHeight,
                                fittedWidth: naturalWidth * fitRatio,
                                fittedHeight: naturalHeight * fitRatio
                            };
                        };

                        const clampTranslate = () => {
                            const { viewportWidth, viewportHeight, fittedWidth, fittedHeight } = getFittedImageSize();
                            const scaledWidth = fittedWidth * zoomScale;
                            const scaledHeight = fittedHeight * zoomScale;
                            const maxOffsetX = Math.max(0, (scaledWidth - viewportWidth) / 2);
                            const maxOffsetY = Math.max(0, (scaledHeight - viewportHeight) / 2);

                            targetTranslateX = Math.min(maxOffsetX, Math.max(-maxOffsetX, targetTranslateX));
                            targetTranslateY = Math.min(maxOffsetY, Math.max(-maxOffsetY, targetTranslateY));
                        };

                        const renderTransform = () => {
                            rafPending = false;
                            viewerMainImage.style.transform = `translate(${targetTranslateX}px, ${targetTranslateY}px) scale(${zoomScale})`;
                            viewerZoomReset.textContent = `${Math.round(zoomScale * 100)}%`;
                        };

                        const scheduleRender = () => {
                            if (rafPending) {
                                return;
                            }

                            rafPending = true;
                            requestAnimationFrame(renderTransform);
                        };

                        const applyZoom = () => {
                            clampTranslate();
                            scheduleRender();
                        };

                        const setZoom = (newZoom) => {
                            zoomScale = Math.min(10, Math.max(0.2, newZoom));
                            applyZoom();
                        };

                        const resetView = () => {
                            zoomScale = 1;
                            targetTranslateX = 0;
                            targetTranslateY = 0;
                            applyZoom();
                        };

                        const updateSelection = (index) => {
                            if (viewerThumbButtons.length === 0) {
                                return;
                            }

                            if (index < 0) {
                                index = viewerThumbButtons.length - 1;
                            } else if (index >= viewerThumbButtons.length) {
                                index = 0;
                            }

                            const selected = viewerThumbButtons.find(button => Number.parseInt(button.dataset.index, 10) === index);
                            if (!selected) {
                                return;
                            }

                            selectedIndex = index;
                            viewerMainImage.src = selected.dataset.imageUrl || "";
                            viewerImageTitle.textContent = selected.dataset.imageTitle || "Photo";
                            resetView();

                            viewerThumbButtons.forEach(button => {
                                const isActive = Number.parseInt(button.dataset.index, 10) === selectedIndex;
                                button.classList.toggle("border-primary", isActive);
                                button.classList.toggle("border-2", isActive);
                            });

                            selected.scrollIntoView({ behavior: "smooth", inline: "center", block: "nearest" });
                        };

                        viewerThumbButtons.forEach(button => {
                            button.addEventListener("click", () => {
                                const index = Number.parseInt(button.dataset.index, 10);
                                if (Number.isFinite(index)) {
                                    updateSelection(index);
                                }
                            });
                        });

                        triggerButtons.forEach(button => {
                            button.addEventListener("click", () => {
                                const index = Number.parseInt(button.dataset.index, 10);
                                if (Number.isFinite(index)) {
                                    updateSelection(index);
                                }

                                const viewerModal = getViewerModal();
                                viewerModal?.show();
                            });
                        });

                        viewerZoomIn.addEventListener("click", () => {
                            setZoom(zoomScale + 0.2);
                        });

                        viewerZoomOut.addEventListener("click", () => {
                            setZoom(zoomScale - 0.2);
                        });

                        viewerZoomReset.addEventListener("click", resetView);

                        viewerPrev.addEventListener("click", () => {
                            updateSelection(selectedIndex - 1);
                        });

                        viewerNext.addEventListener("click", () => {
                            updateSelection(selectedIndex + 1);
                        });

                        viewerMainImage.addEventListener("load", resetView);

                        viewerMainImage.addEventListener("wheel", (event) => {
                            event.preventDefault();
                            setZoom(zoomScale + (event.deltaY < 0 ? 0.1 : -0.1));
                        }, { passive: false });

                        viewerMainImage.addEventListener("contextmenu", (event) => {
                            event.preventDefault();
                        });

                        viewerMainImage.addEventListener("pointerdown", (event) => {
                            if (event.pointerType === "mouse" && event.button !== 0 && event.button !== 2) {
                                return;
                            }

                            if (zoomScale <= 1) {
                                return;
                            }

                            event.preventDefault();
                            isDragging = true;
                            lastPointerX = event.clientX;
                            lastPointerY = event.clientY;
                            viewerMainImage.style.cursor = "grabbing";
                            viewerMainImage.setPointerCapture(event.pointerId);
                        });

                        viewerMainImage.addEventListener("pointermove", (event) => {
                            if (!isDragging) {
                                return;
                            }

                            const deltaX = event.clientX - lastPointerX;
                            const deltaY = event.clientY - lastPointerY;
                            lastPointerX = event.clientX;
                            lastPointerY = event.clientY;

                            targetTranslateX += deltaX;
                            targetTranslateY += deltaY;
                            applyZoom();
                        });

                        const stopDragging = (event) => {
                            if (!isDragging) {
                                return;
                            }

                            isDragging = false;
                            viewerMainImage.style.cursor = zoomScale > 1 ? "grab" : "default";
                            if (typeof event.pointerId !== "undefined") {
                                viewerMainImage.releasePointerCapture(event.pointerId);
                            }
                        };

                        viewerMainImage.addEventListener("pointerup", stopDragging);
                        viewerMainImage.addEventListener("pointercancel", stopDragging);
                        viewerMainImage.addEventListener("pointerleave", stopDragging);

                        window.addEventListener("resize", applyZoom);

                        if (viewerThumbButtons.length > 0) {
                            updateSelection(0);
                        }
                    })();
                </script>
            }
        }
